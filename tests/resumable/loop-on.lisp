(defpackage #:valtan-loop-on-tests (:use #:cl))
(in-package #:valtan-loop-on-tests)

(defun run-checks (&optional suspend-p)
  (let ((checks 0))
    (flet ((check (actual expected)
             (assert (equal actual expected) () "LOOP ON: ~S != ~S" actual expected)
             (incf checks)))
      (check (loop for tail on nil finally (return tail)) nil)
      (check (loop for tail on '(a) finally (return tail)) nil)
      (check (loop for tail on '(a . b) finally (return tail)) 'b)
      (check (loop for tail on '(a b) initially (return tail)) '(a b))
      (check (loop for tail on '(a b c) count t into count
                   until (= count 2) finally (return tail))
             '(b c))
      (check (loop for tail on '(a b) and previous = tail then tail
                   collect (list tail previous))
             '(((a b) (a b)) ((b) (a b))))
      (check (loop for left on '(1 2 3) and right on '(4)
                   finally (return (list left right)))
             '((2 3) nil))
      (check (loop for left on '(a b) for right on nil finally (return left)) '(a b))
      (check (loop for (a b) on '(1 2) finally (return (list a b))) '(2 nil))
      (check (loop for nil on '(a b) count t) 2)
      (check (let ((evaluations 0) (calls 0))
               (list (loop for tail on '(a b)
                           by (progn (incf evaluations)
                                     (lambda (tail) (incf calls) (cdr tail)))
                           finally (return tail))
                     evaluations calls))
             '(nil 1 2))
      (check (loop for tail on '(a) by (lambda (tail) (declare (ignore tail)) :done)
                   finally (return tail))
             :done)
      (check (let ((calls 0))
               (list (loop for tail on '(a b)
                           by (lambda (tail)
                                (when suspend-p (sleep .001))
                                (incf calls)
                                (cdr tail))
                           finally (return tail))
                     calls))
             '(nil 2)))
    (values :passed checks)))
