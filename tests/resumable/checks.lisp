(in-package :cl-user)
(defvar *dual-checks* 0)
(setf *dual-checks* 0)
(defun dual-check (value)
  (assert value () "Dual assertion ~D failed" (1+ *dual-checks*))
  (incf *dual-checks*))
(defun dual-step (task &optional (value (ffi:ref "undefined")))
  (loop for step = (resumable-test-step task value 10000)
        then (resumable-test-step task (ffi:ref "undefined") 10000)
        for i from 0 below 100
        unless (eq (ffi:ref step "value") (ffi:ref "lisp" "resumableCheckpoint"))
          do (return-from dual-step step))
  (error "Too many checkpoints"))
(defun dual-implementation-p (function)
  (functionp ((ffi:ref "lisp" "getResumableImplementation") function)))
(dual-check (eq compiler::*resumable-functions* :dual))
;; These are actual build-time core functions, not test replacements.
(dolist (name '(apply mapcar map maphash remove-if reduce))
  (dual-check (dual-implementation-p (symbol-function name))))

(let ((task (make-resumable-test-task
             (compile nil '(lambda ()
                             (values (ffi:cl->js "constant")
                                     (ffi:cl->js (copy-seq "動作🙂"))))))))
  (dual-check (resumable-test-done (dual-step task)))
  (dual-check (string= (ffi:js->cl (first (resumable-test-values task))) "constant"))
  (dual-check (string= (ffi:js->cl (second (resumable-test-values task))) "動作🙂")))

;; AOT core APPLY and MAPCAR must propagate suspension through Lisp callbacks.
(let* ((function (compile nil '(lambda ()
                                (apply #'mapcar
                                       (lambda (x)
                                         (system::%resumable-yield x)
                                         (* x 10))
                                       '((1 2 3))))))
       (task (make-resumable-test-task function)))
  (dolist (value '(1 2 3))
    (dual-check (= value (resumable-test-yield (dual-step task)))))
  (dual-check (resumable-test-done (dual-step task)))
  (dual-check (equal (resumable-test-values task) '((10 20 30)))))

(dolist (form '((lambda ()
                 (map 'vector (lambda (x) (system::%resumable-yield x) (1+ x))
                      '(1 2 3)))
               (lambda ()
                 (remove-if (lambda (x) (system::%resumable-yield x) (oddp x))
                            '(1 2 3)))))
  (let ((task (make-resumable-test-task (compile nil form))))
    (dolist (value '(1 2 3))
      (dual-check (= value (resumable-test-yield (dual-step task)))))
    (dual-check (resumable-test-done (dual-step task)))
    (dual-check (equalp (car (resumable-test-values task))
                       (if (eq (car (third form)) 'map) #(2 3 4) '(2))))))

(let* ((table (make-hash-table))
       (function (compile nil '(lambda (table)
                                (maphash (lambda (key value)
                                           (system::%resumable-yield key)
                                           (setf (gethash key table) (1+ value)))
                                         table)
                                (gethash :entry table))))
       (task (make-resumable-test-task function table)))
  (setf (gethash :entry table) 10)
  (dual-check (eq (resumable-test-yield (dual-step task)) :entry))
  (dual-check (= (gethash :entry table) 10))
  (dual-check (resumable-test-done (dual-step task)))
  (dual-check (equal (resumable-test-values task) '(11 t))))

;; Closures created by the ordinary factory share their captured cell across
;; ordinary calls and the generator alternative of the same function.
(let* ((factory (compile nil '(lambda ()
                               (let ((value 0))
                                 (lambda (pause)
                                   (incf value)
                                   (when pause (system::%resumable-yield value))
                                   value)))))
       (function (funcall factory))
       (task (make-resumable-test-task function t)))
  (dual-check (= (funcall function nil) 1))
  (dual-check (= (resumable-test-yield (dual-step task)) 2))
  (dual-check (= (funcall function nil) 3))
  (dual-check (resumable-test-done (dual-step task)))
  (dual-check (equal (resumable-test-values task) '(3))))

;; Each LTV occurrence is initialized once during compilation, shared by the
;; ordinary and resumable entries, and retains object identity.
(defvar *dual-ltv-count* 0)
(setf *dual-ltv-count* 0)
(let* ((function (compile nil '(lambda ()
                                (load-time-value
                                 (progn (incf *dual-ltv-count*) (list :shared))))))
       (ordinary (funcall function))
       (task (make-resumable-test-task function)))
  (dual-check (= *dual-ltv-count* 1))
  (dual-check (resumable-test-done (dual-step task)))
  (dual-check (eq ordinary (car (resumable-test-values task))))
  (dual-check (= *dual-ltv-count* 1)))

;; PROGV's callback and dynamic binding tokens survive a real suspension.
(let* ((function (compile nil '(lambda ()
                                (progv '(*resumable-value*) '(:progv)
                                  (system::%resumable-yield *resumable-value*)
                                  *resumable-value*))))
       (task (make-resumable-test-task function)))
  (dual-check (eq (resumable-test-yield (dual-step task)) :progv))
  (dual-check (eq *resumable-value* :global))
  (dual-check (resumable-test-done (dual-step task)))
  (dual-check (equal (resumable-test-values task) '(:progv)))
  (dual-check (eq *resumable-value* :global)))

;; Dispatch, effective methods, CALL-NEXT-METHOD and :AROUND all cross core
;; library calls. The method cache is exercised by a second independent task.
(defgeneric dual-method (value))
(defmethod dual-method ((value integer))
  (system::%resumable-yield :primary)
  (values (1+ value) :secondary))
(defmethod dual-method :around ((value integer))
  (system::%resumable-yield :around)
  (call-next-method))
(dotimes (i 2)
  (let ((task (make-resumable-test-task #'dual-method (+ 40 i))))
    (dual-check (eq (resumable-test-yield (dual-step task)) :around))
    (dual-check (eq (resumable-test-yield (dual-step task)) :primary))
    (dual-check (resumable-test-done (dual-step task)))
    (dual-check (equal (resumable-test-values task) (list (+ 41 i) :secondary)))))

(format t "~&DUAL-CHECKS-PASS ~D~%" *dual-checks*)
(ffi:set (ffi:ref "globalThis" "valtanDualChecksPassed") *dual-checks*)
