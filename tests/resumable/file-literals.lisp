(in-package :cl-user)

(defvar *literal-nested-artifact* nil)
(defvar *literal-creation-promise* nil)
(defvar *literal-init-promise* nil)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defvar *literal-method-calls* nil)
  (defclass file-literal-node ()
    ((value :initarg :value) (next :initarg :next) (missing)))
  (defmethod make-load-form ((object file-literal-node) &optional environment)
    (push object *literal-method-calls*)
    (make-load-form-saving-slots object :environment environment))
  (defstruct file-literal-struct value)
  (defmethod make-load-form ((object file-literal-struct) &optional environment)
    (push object *literal-method-calls*)
    (make-load-form-saving-slots object :environment environment))
  (defclass file-literal-async () ((value :initarg :value) (ready)))
  (defmethod make-load-form ((object file-literal-async) &optional environment)
    (declare (ignore environment))
    (push object *literal-method-calls*)
    (values '(make-instance 'file-literal-async
                           :value (if *literal-creation-promise*
                                      (system::%resumable-await *literal-creation-promise*) 37))
            `(setf (slot-value ',object 'ready)
                   (if *literal-init-promise*
                       (system::%resumable-await *literal-init-promise*) 42))))
  (defclass file-literal-ordered ()
    ((value :initarg :value) (next :initarg :next) (ready :initform nil)))
  (defmethod make-load-form ((object file-literal-ordered) &optional environment)
    (declare (ignore environment))
    (push object *literal-method-calls*)
    (let ((next (slot-value object 'next)))
      (values `(progn
                 ,@(when next `((assert (slot-value ',next 'ready))))
                 (make-instance 'file-literal-ordered
                                :value ',(slot-value object 'value) :next ',next))
              `(setf (slot-value ',object 'ready) t))))
  ;; A creation dependency whose initialization refers back to its creator.
  (defclass file-literal-deferred () ((outer :initarg :outer) (next :initarg :next)))
  (defmethod make-load-form ((object file-literal-deferred) &optional environment)
    (declare (ignore environment))
    (push object *literal-method-calls*)
    (if (slot-value object 'outer)
        `(make-instance 'file-literal-deferred :outer t :next ',(slot-value object 'next))
        (values '(make-instance 'file-literal-deferred :outer nil)
                `(setf (slot-value ',object 'next) ',(slot-value object 'next)))))
  (defparameter *literal-root*
    (let* ((text (copy-seq "shared text")) (symbol (make-symbol "shared symbol"))
           (shared (list text symbol))
           (a (make-instance 'file-literal-node :value shared))
           (b (make-instance 'file-literal-node :value shared :next a))
           (array (make-array 2)) (circle (cons nil nil))
           (outer (make-instance 'file-literal-deferred :outer t))
           (inner (make-instance 'file-literal-deferred :outer nil :next outer)))
      (setf (slot-value a 'next) b (aref array 0) array (aref array 1) circle
            (car circle) array (cdr circle) circle (slot-value outer 'next) inner)
      (vector a b shared text symbol array circle
              (make-file-literal-struct :value shared)
              (find-class 'file-literal-node)
              (make-instance 'file-literal-async)
              (make-instance 'file-literal-ordered :value :first
                             :next (make-instance 'file-literal-ordered :value :second :next nil))
              outer
              (make-array 3 :element-type 'character :initial-contents "xyz"
                            :adjustable t :fill-pointer 1)))))

(defun file-literal-root-before () '#.*literal-root*)
(when *literal-nested-artifact* (load *literal-nested-artifact*))
(defun file-literal-root-after () '#.*literal-root*)

(defun check-file-literals ()
  (let* ((root (file-literal-root-before)) (a (aref root 0)) (b (aref root 1))
         (shared (aref root 2)) (array (aref root 5)) (circle (aref root 6))
         (outer (aref root 11)))
    (assert (eq root (file-literal-root-before)))
    (assert (eq root (file-literal-root-after)))
    (assert (eq (slot-value a 'next) b))
    (assert (eq (slot-value b 'next) a))
    (assert (eq (slot-value a 'value) shared))
    (assert (eq (slot-value b 'value) shared))
    (assert (eq (first shared) (aref root 3)))
    (assert (eq (second shared) (aref root 4)))
    (assert (not (slot-boundp a 'missing)))
    (assert (eq array (aref array 0)))
    (assert (eq circle (aref array 1)))
    (assert (eq array (car circle)))
    (assert (eq circle (cdr circle)))
    (assert (eq shared (file-literal-struct-value (aref root 7))))
    (assert (eq (find-class 'file-literal-node) (aref root 8)))
    (assert (= 37 (slot-value (aref root 9) 'value)))
    (assert (= 42 (slot-value (aref root 9) 'ready)))
    (assert (slot-value (aref root 10) 'ready))
    (assert (eq :second (slot-value (slot-value (aref root 10) 'next) 'value)))
    (assert (eq outer (slot-value (slot-value outer 'next) 'next)))
    (assert (= 3 (array-total-size (aref root 12))))
    (assert (char= #\z (row-major-aref (aref root 12) 2)))
    (assert (eq 'character (array-element-type (aref root 12))))
    23))
