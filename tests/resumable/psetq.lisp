(defpackage #:valtan-psetq-tests (:use #:cl))
(in-package #:valtan-psetq-tests)

(defvar *assignment-value* 0)

(defun run-checks (&optional suspend-p)
  (let ((checks 0))
    (flet ((check (actual expected)
             (assert (equalp actual expected) () "PSETQ: ~S != ~S" actual expected)
             (incf checks)))
      (check (multiple-value-list (psetq)) '(nil))
      (check (let ((x 0)) (list (multiple-value-list (psetq x (values 1 2))) x))
             '((nil) 1))
      (check (let ((x 0)) (psetq x (values)) x) nil)
      (check (let ((array (vector 0 1 2)) (i 0))
               (symbol-macrolet ((x (aref array (incf i))))
                 (psetq x (incf i)))
               (list array i))
             '(#(0 2 2) 2))
      (check (let (a b)
               (symbol-macrolet ((x (values a b)))
                 (psetq x (values 3 4)))
               (list a b))
             '(3 4))
      (check (let ((x 0))
               (handler-case (psetq x (error "Abort assignment")) (error () nil))
               x)
             0)
      (check (let ((x 0))
               (block escape (psetq x (return-from escape 7)))
               x)
             0)
      (check (let ((x 0))
               (tagbody (psetq x (go done)) done)
               x)
             0)
      ;; Multiple stores must still capture each symbol macro's place subforms
      ;; before the next value is evaluated, as in upstream ANSI PSETQ.7.
      (check (let ((a (vector 0 1 2 3 4)) (i 0))
               (symbol-macrolet ((x (aref a (incf i)))
                                 (y (aref a (incf i))))
                 (psetq x (aref a (incf i)) y (aref a (incf i))))
               (list a i))
             '(#(0 2 2 4 4) 4))
      (check (let ((*assignment-value* 11) (x 0))
               (psetq x (progn (when suspend-p (sleep .001))
                                (values *assignment-value* 99)))
               (list x *assignment-value*))
             '(11 11)))
    (values :passed checks)))
