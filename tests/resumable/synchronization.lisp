(in-package :cl-user)
(defvar *lock-test-value* :global)
(defmacro with-test-lock ((lock) &body body)
  (let ((value (gensym "LOCK")))
    `(let ((,value ,lock))
       (assert (system::%acquire-cooperative-lock ,value t nil))
       (unwind-protect (progn ,@body)
         (system::%release-cooperative-lock ,value)))))

(ffi:set
 (ffi:ref "globalThis" "valtanSynchronizationTestSetup")
 (lambda ()
   (let ((lock (system::%make-cooperative-lock "counter" nil))
         (counter 0) (inside 0)
         (queue-lock (system::%make-cooperative-lock "queue" nil))
         (available (system::%make-cooperative-condition "available"))
         (items nil)
         (event-lock (system::%make-cooperative-lock "event" nil))
         (event (system::%make-cooperative-condition "event"))
         (signalled nil)
         (recursive (system::%make-cooperative-lock "recursive" t))
         (recursive-count 0)
         (cancel-lock (system::%make-cooperative-lock "cancel" nil))
         (cancel-event (system::%make-cooperative-condition "cancel"))
         (cleaned 0))
     (ffi:object
      "counter" (lambda (id)
                  (let ((*lock-test-value* id))
                    (dotimes (round 3)
                      (with-test-lock (lock)
                        (assert (= (incf inside) 1))
                        (let ((before counter))
                          (system::%resumable-yield nil)
                          (assert (= *lock-test-value* id))
                          (setf counter (1+ before)))
                        (assert (= (decf inside) 0))))
                    (values id :counted)))
      "count" (lambda () counter)
      "global" (lambda () *lock-test-value*)
      "producer" (lambda (id)
                   (dotimes (index 16)
                     (with-test-lock (queue-lock)
                       (push (+ (* id 16) index) items)
                       (system::%cooperative-condition-notify available nil)
                       (system::%resumable-yield nil)))
                   id)
      "consumer" (lambda (id)
                   (let ((*lock-test-value* id) (received nil))
                     (dotimes (index 16)
                       (with-test-lock (queue-lock)
                         (loop while (null items)
                               do (assert (system::%cooperative-condition-wait available queue-lock nil)))
                         (assert (= *lock-test-value* id))
                         (push (pop items) received)))
                     (values (ffi:cl->js (coerce received 'vector)) id)))
      "available" available
      "eventWait" (lambda ()
                    (with-test-lock (event-lock)
                      (loop until signalled
                            do (assert (system::%cooperative-condition-wait event event-lock nil)))
                      :notified))
      "signal" (lambda ()
                 (with-test-lock (event-lock)
                   (setf signalled t)
                   (system::%cooperative-condition-notify event t)))
      "event" event
      "timeout" (lambda ()
                  (let ((local (system::%make-cooperative-lock "timeout" nil))
                        (condition (system::%make-cooperative-condition "timeout")))
                    (with-test-lock (local)
                      (values (system::%cooperative-condition-wait condition local 5)
                              :timed-out))))
      "recursive" (lambda ()
                    (with-test-lock (recursive)
                      (with-test-lock (recursive)
                        (let ((before recursive-count))
                          (system::%resumable-yield nil)
                          (setf recursive-count (1+ before))))
                      (assert (= (ffi:ref recursive "depth") 1)))
                    :recursive)
      "recursiveCount" (lambda () recursive-count)
      "cancel" (lambda ()
                 (let ((*lock-test-value* :cancelling))
                   (with-test-lock (cancel-lock)
                     (unwind-protect
                          (system::%cooperative-condition-wait cancel-event cancel-lock nil)
                       (assert (eq (ffi:ref cancel-lock "owner")
                                   ((ffi:ref "lisp" "currentScheduledTask"))))
                       (assert (eq *lock-test-value* :cancelling))
                       (incf cleaned)))))
      "cancelEvent" cancel-event
      "cancelLock" cancel-lock
      "cleaned" (lambda () cleaned)))))
