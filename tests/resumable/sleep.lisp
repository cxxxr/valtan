(in-package :cl-user)
(defvar *sleep-test-value* :global)
(ffi:set
 (ffi:ref "globalThis" "valtanSleepTestSetup")
 (lambda ()
   (let ((started nil) (finished nil) (interleaved nil)
         (cancel-started nil) (cleaned 0))
     (ffi:object
      "sleep" (lambda ()
                (let ((*sleep-test-value* :sleeping))
                  (setf started t)
                  (let ((result (sleep 1/50)))
                    (assert (eq *sleep-test-value* :sleeping))
                    (setf finished t)
                    (values result :slept))))
      "other" (lambda ()
                (setf interleaved (and started (not finished)))
                (assert (eq *sleep-test-value* :global))
                42)
      "interleaved" (lambda () interleaved)
      "finished" (lambda () finished)
      "global" (lambda () *sleep-test-value*)
      "float" (lambda () (sleep 0.005))
      "zero" (lambda () (sleep 0))
      "invalid" (lambda () (handler-case (sleep -1) (type-error () :rejected)))
      "cancel" (lambda ()
                 (let ((*sleep-test-value* :cancelling))
                   (unwind-protect
                        (progn (setf cancel-started t) (sleep 60))
                     (sleep 0.005)
                     (assert (eq *sleep-test-value* :cancelling))
                     (incf cleaned))))
      "cancelStarted" (lambda () cancel-started)
      "cleaned" (lambda () cleaned)))))
