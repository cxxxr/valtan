(in-package :cl-user)
(defvar *interrupt-test-value* :global)
(ffi:set
 (ffi:ref "globalThis" "valtanInterruptTestSetup")
 (lambda ()
   (let ((cleaned 0) (seen 0) (jump nil) (order nil))
     (ffi:object
      "root" (lambda (promise)
               (let ((*interrupt-test-value* :target))
                 (multiple-value-bind (a b)
                     (multiple-value-prog1 (values :original 7)
                       (system::%resumable-await promise))
                   (values a b *interrupt-test-value*))))
      "callback" (lambda (promise)
                   (assert (eq *interrupt-test-value* :target))
                   (setf *interrupt-test-value* :modified)
                   (let ((*interrupt-test-value* :callback))
                     (system::%resumable-await promise)
                     (assert (eq *interrupt-test-value* :callback))
                     (values :discarded 99)))
      "handler" (lambda (promise)
                  (let ((*interrupt-test-value* :handled-target))
                    (handler-case
                        (unwind-protect (system::%resumable-await promise)
                          (incf cleaned))
                      (simple-error () (values :handled *interrupt-test-value*)))))
      "error" (lambda () (error "Error from interrupt callback"))
      "catch" (lambda (promise)
                (catch 'interrupt-exit
                  (unwind-protect (system::%resumable-await promise)
                    (sleep 0.001)
                    (incf cleaned))))
      "throw" (lambda () (throw 'interrupt-exit (values :caught 17)))
      "signalRoot" (lambda (promise)
                     (handler-bind ((simple-condition
                                     (lambda (condition)
                                       (declare (ignore condition))
                                       (sleep 0.001)
                                       (incf seen))))
                       (system::%resumable-await promise)
                       seen))
      "signal" (lambda () (signal 'simple-condition :format-control "Interrupt signal"))
      "seen" (lambda () seen)
      "goRoot" (lambda (promise)
                 (tagbody
                   (setf jump (lambda () (go done)))
                   (system::%resumable-await promise)
                   (error "GO interrupt did not transfer control")
                  done)
                 (values :jumped 23))
      "jump" (lambda () jump)
      "cancelRoot" (lambda (promise)
                     (let ((*interrupt-test-value* :cancel-root))
                       (unwind-protect (system::%resumable-await promise)
                         (sleep 0.001)
                         (assert (eq *interrupt-test-value* :cancel-root))
                         (push :root order))))
      "cancelCallback" (lambda (promise)
                         (assert (eq *interrupt-test-value* :cancel-root))
                         (let ((*interrupt-test-value* :cancel-callback))
                           (unwind-protect (system::%resumable-await promise)
                             (sleep 0.001)
                             (assert (eq *interrupt-test-value* :cancel-callback))
                             (push :callback order))))
      "order" (lambda () (ffi:cl->js (coerce (reverse order) 'vector)))
      "cleaned" (lambda () cleaned)
      "global" (lambda () *interrupt-test-value*)))))
