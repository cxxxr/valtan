(in-package :cl-user)
(defvar *eval-test-value* :global)
(defvar *eval-test-promise* nil)
(defvar *eval-test-cleaned* 0)
(defvar *eval-test-order* 0)
(defvar *eval-test-ltv-count* 0)
(setf *eval-test-cleaned* 0 *eval-test-ltv-count* 0)
(ffi:set
 (ffi:ref "globalThis" "valtanEvalTestSetup")
 (lambda ()
   (multiple-value-bind (code constants)
       (compiler:compile-toplevel
        '(values *eval-test-value* (system::%resumable-await *eval-test-promise*)
                 *eval-test-value* (load-time-value (incf *eval-test-ltv-count*)))
        t t t)
     (let ((shared (ffi:js-eval code constants)))
       (ffi:object
        "await" (lambda (promise)
                  (let ((*eval-test-promise* promise) (*eval-test-value* :local))
                    (eval '(unwind-protect
                               (values (system::%resumable-await *eval-test-promise*) *eval-test-value*)
                             (system::%resumable-await ((ffi:ref "Promise" "resolve") nil))
                             (assert (eq *eval-test-value* :local))
                             (incf *eval-test-cleaned*)))))
        "global" (lambda () *eval-test-value*)
        "cleaned" (lambda () *eval-test-cleaned*)
        "order" (lambda () *eval-test-order*)
        "setOrder" (lambda (value) (setf *eval-test-order* value))
        "macrolet" (lambda (promise)
                     (let ((*eval-test-promise* promise))
                       (eval '(macrolet ((define-ordered-constant (name)
                                          (list 'defconstant name *eval-test-order*)))
                                (defparameter *eval-test-order* 5)
                                (system::%resumable-await *eval-test-promise*)
                                (define-ordered-constant +resumable-eval-ordered+)
                                (values +resumable-eval-ordered+ *eval-test-order*)))))
        "symbolMacro" (lambda (promise)
                        (let ((*eval-test-promise* promise))
                          (eval '(symbol-macrolet ((place *eval-test-order*))
                                   (locally (declare (special *eval-test-order*))
                                     (setq place 9)
                                     (system::%resumable-await *eval-test-promise*)
                                     (values place *eval-test-order*))))))
        "evalWhen" (lambda (promise)
                     (let ((*eval-test-promise* promise))
                       (eval '(progn
                                (eval-when (:compile-toplevel :load-toplevel)
                                  (error "EVAL executed compile/load-only body"))
                                (eval-when (:execute)
                                  (system::%resumable-await *eval-test-promise*)
                                  (values :executed 17))))))
        "empty" (lambda () (eval '(values)))
        "nullEnvironment" (lambda ()
                            (let ((eval-test-lexical :lexical))
                              (declare (ignore eval-test-lexical))
                              (eval '(boundp 'eval-test-lexical))))
        "throw" (lambda (promise)
                  (let ((*eval-test-promise* promise))
                    (catch 'eval-done
                      (eval '(progn (system::%resumable-await *eval-test-promise*)
                                    (throw 'eval-done (values :caught 23)))))))
        "shared" (lambda (promise id)
                   (let ((*eval-test-promise* promise) (*eval-test-value* id))
                     (funcall shared)))
        "ltvCount" (lambda () *eval-test-ltv-count*)
        "load" (lambda (promise)
                 (let ((*eval-test-promise* promise))
                   (with-input-from-string
                       (stream "(in-package :cl-user)
(defparameter *eval-test-order* 31)
(system::%resumable-await *eval-test-promise*)
(incf *eval-test-order*)")
                     (load stream))
                   (values *eval-test-order* :loaded)))
        "entry" '(progn
                    (system::%resumable-await ((ffi:ref "Promise" "resolve") nil))
                    (values :entry 55))
        "compiledStream"
        (lambda (promise)
          (let* ((*eval-test-promise* promise)
                 (compiler::*file-compilation-p* t)
                 (text
                   (with-output-to-string (stream)
                     (write-line cl::*compiled-file-header* stream)
                     (dolist (form '((defparameter *eval-test-order* 51)
                                     (system::%resumable-await *eval-test-promise*)
                                     (incf *eval-test-order*)))
                       (cl::%write-compiled-form
                        (compiler:compile-toplevel form t nil t) stream t)))))
            (with-input-from-string (stream text) (load stream))
            (values *eval-test-order* :compiled-stream)))
        "compiledFile"
        (lambda (promise)
          (let* ((*eval-test-promise* promise)
                 (input (make-pathname :name (symbol-name (gensym "resumable-eval-"))
                                       :type "lisp" :defaults #p"/tmp/"))
                 (output (compile-file-pathname input)))
            (unwind-protect
                 (progn
                   (with-open-file (stream input :direction :output :if-exists :supersede)
                     (write-line "(in-package :cl-user)" stream)
                     (write-line "(defparameter *eval-test-order* 41)" stream)
                     (write-line "(system::%resumable-await *eval-test-promise*)" stream)
                     (write-line "(incf *eval-test-order*)" stream))
                   (multiple-value-bind (path warnings failure) (compile-file input)
                     (declare (ignore warnings))
                     (assert path)
                     (assert (not failure)))
                   (load output)
                   (values *eval-test-order* :compiled))
              (when (probe-file input) (delete-file input))
              (when (probe-file output) (delete-file output)))))
        "nil" nil)))))
