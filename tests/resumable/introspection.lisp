(defpackage :valtan-introspection-tests (:use :cl) (:export :original))
(in-package :valtan-introspection-tests)

(defun original (a &optional (b 12 bp) &rest rest &key ((:key value) 17 vp)
                 &allow-other-keys &aux (aux a))
  (declare (ignore b bp rest value vp aux))
  a)
(defun empty () 42)
(defun (setf sample-accessor) (new-value object) (list new-value object))
(defmacro destructuring ((var &optional (value 7)) &body body)
  `(let ((,var ,value)) ,@body))
(defmacro empty-macro () 1)
(defgeneric generic (object &key option))
(defmethod generic ((object t) &key option) (list object option))

(defun run-checks ()
  (let ((checks 0))
    (flet ((check (actual expected)
             (assert (equal actual expected) () "Introspection: ~S != ~S" actual expected)
             (incf checks))
           (arguments (name)
             (multiple-value-list (system::operator-lambda-list name)))
           (function-arguments (function)
             (multiple-value-list (system::function-lambda-list function))))
      (check (arguments 'original)
             '((a &optional (b 12 bp) &rest rest &key ((:key value) 17 vp)
                &allow-other-keys &aux (aux a)) t))
      (check (arguments 'empty) '(nil t))
      (check (arguments '(setf sample-accessor)) '((new-value object) t))
      (check (arguments 'cl:function-lambda-expression) '((cl::function) t))
      (check (arguments 'destructuring) '(((var &optional (value 7)) &body body) t))
      (check (arguments 'empty-macro) '(nil t))
      (macroexpand-1 '(destructuring (x) x))
      (check (arguments 'destructuring) '(((var &optional (value 7)) &body body) t))
      (compile 'destructuring)
      (check (arguments 'destructuring) '(((var &optional (value 7)) &body body) t))
      (let ((copy (system::operator-lambda-list 'original)))
        (setf (car copy) 'changed)
        (check (car (system::operator-lambda-list 'original)) 'a))
      (let ((copy (system::operator-lambda-list 'destructuring)))
        (setf (caar copy) 'changed)
        (check (caar (system::operator-lambda-list 'destructuring)) 'var))
      (let ((calls 0))
        (let ((function (lambda (&optional (value (incf calls))) value)))
          (check (function-arguments function) '((&optional (value (incf calls))) t))
          (check calls 0)
          (check (funcall function) 1)))
      (flet ((local (x &rest tail) (cons x tail)))
        (check (function-arguments #'local) '((x &rest tail) t)))
      (eval '(defun redefined (old) old))
      (let ((old #'redefined))
        (eval '(defun redefined (new &optional extra) (list new extra)))
        (check (function-arguments old) '((old) t))
        (check (arguments 'redefined) '((new &optional extra) t))
        (setf (fdefinition 'alias) old)
        (check (arguments 'alias) '((old) t)))
      (defun nested (x &key y) (list x y))
      (check (arguments 'nested) '((x &key y) t))
      (defmacro nested-macro ((x) &body body) `(progn ,x ,@body))
      (check (arguments 'nested-macro) '(((x) &body body) t))
      (eval '(defmacro replaceable (x) x))
      (check (arguments 'replaceable) '((x) t))
      (setf (symbol-plist 'replaceable) nil)
      (check (arguments 'replaceable) '((x) t))
      (setf (macro-function 'replaceable) (lambda (form env) (declare (ignore env)) (cadr form)))
      (check (arguments 'replaceable) '(nil nil))
      (eval '(defmacro replaceable (a b) `(list ,a ,b)))
      (check (arguments 'replaceable) '((a b) t))
      (eval '(defun replaceable (now-function) now-function))
      (check (arguments 'replaceable) '((now-function) t))
      (fmakunbound 'replaceable)
      (check (arguments 'replaceable) '(nil nil))
      (check (function-arguments #'cons) '(nil nil))
      (check (arguments 'unknown-operator) '(nil nil))
      (check (nth-value 1 (find-symbol "ORIGINAL" :valtan-introspection-tests)) :external)
      (let ((package *package*))
        (check (handler-case (eval '(in-package :introspection-nonexistent-package))
                 (error () :caught)) :caught)
        (check (eq package *package*) t))
      (check (arguments 'if) '(nil nil))
      (check (arguments 'defun) '(nil nil))
      (check (arguments 'generic) '((object &key option) t))
      (let ((function #'generic))
        (ensure-generic-function 'generic :lambda-list '(renamed &key option))
        (check (function-arguments function) '((renamed &key option) t))
        (ensure-generic-function 'generic :lambda-list '(object &key option)))
      (unwind-protect
           (progn
             (trace original generic cons)
             (check (car (system::operator-lambda-list 'original)) 'a)
             (check (arguments 'generic) '((object &key option) t))
             (check (arguments 'cons) '(nil nil)))
        (untrace original generic cons))
      (check (handler-case (system::function-lambda-list 42)
               (type-error () :type-error)) :type-error)
      (values :passed checks))))
