(defsystem "resumable"
  :serial t
  :components ((:file "performance/resumable")
               (:file "resumable/checks")
               (:file "resumable/callbacks")
               (:file "resumable/scheduler")
               (:file "resumable/eval")
               (:file "resumable/synchronization")
               (:file "resumable/sleep")
               (:file "resumable/interrupt")
               (:file "resumable/native-errors"))
  :target :node
  :target-features (:valtan-resumable)
  :compile-mode :runtime)
