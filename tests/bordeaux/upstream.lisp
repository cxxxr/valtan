(in-package :cl-user)
(defun bordeaux-upstream-summary ()
  (let* ((cases (loop for name in (fiveam::test-names)
                      for test = (fiveam:get-test name)
                      when (and (typep test 'fiveam::test-case)
                                (member (symbol-package name)
                                        (list (find-package :bordeaux-threads/test)
                                              (find-package :bordeaux-threads-2/test))))
                        collect test))
         (results (append (fiveam:run :bordeaux-threads)
                          (fiveam:run :bordeaux-threads-2)))
         (passed (count-if #'fiveam::test-passed-p results))
         (skipped (count-if (lambda (result) (typep result 'fiveam::test-skipped)) results))
         (counts (make-hash-table :test 'eq)))
    (dolist (result results) (incf (gethash (fiveam::test-case result) counts 0)))
    (labels ((name (test) (ffi:cl->js (prin1-to-string (fiveam::name test))))
             (array (items function) (ffi:cl->js (map 'vector function items))))
      (ffi:object
       "registered" (length cases) "results" (length results)
       "passed" passed "skipped" skipped "failed" (- (length results) passed skipped)
       "registeredNames" (array cases #'name)
       "resultCounts" (array cases (lambda (test) (ffi:object "test" (name test) "count" (gethash test counts 0))))
       "unexecuted" (array (remove-if (lambda (test) (gethash test counts)) cases) #'name)
       "nonpassed" (array (remove-if #'fiveam::test-passed-p results)
                          (lambda (result)
                            (ffi:object "test" (name (fiveam::test-case result))
                                        "kind" (ffi:cl->js (symbol-name (type-of result)))
                                        "reason" (ffi:cl->js (fiveam::reason result)))))))))
(ffi:set (ffi:ref "globalThis" "valtanBordeauxUpstream") #'bordeaux-upstream-summary)
(ffi:set (ffi:ref "globalThis" "valtanBordeauxKernel") (ffi:ref "lisp"))
