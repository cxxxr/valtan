(in-package :cl-test)
(deftest export-empty-list (export nil) t)
(deftest defpackage-exports-nil-symbol
  (let ((p (eval '(defpackage "REG-NIL" (:use :cl) (:export #:nil)))))
    (values (find-symbol "NIL" p) (nth-value 1 (find-symbol "NIL" p))))
  nil :external)
(deftest keyword-external-status
  (nth-value 1 (find-symbol "PACKAGE-REGRESSION-KEY" :keyword))
  nil)
(deftest keyword-intern-status
  (progn (intern "PACKAGE-REGRESSION-KEY" :keyword)
         (nth-value 1 (find-symbol "PACKAGE-REGRESSION-KEY" :keyword)))
  :external)
(deftest package-use-and-unuse
  (let* ((a (make-package "REG-A" :use nil))
         (b (make-package "REG-B" :use nil))
         (x (intern "X" a)))
    (export x a)
    (use-package a b)
    (values (eq x (find-symbol "X" b)) (nth-value 1 (find-symbol "X" b))
            (equal (package-used-by-list a) (list b))
            (unuse-package a b) (find-symbol "X" b)))
  t :inherited t t nil)
(deftest package-shadowing-and-conflicts
  (let* ((a (make-package "REG-C" :use nil))
         (b (make-package "REG-D" :use nil))
         (x (intern "X" a)) (y (intern "X" b)))
    (export x a)
    (values (handler-case (use-package a b)
              (package-error (c) (eq (package-error-package c) b)))
            (shadow "X" b) (use-package a b)
            (eq y (find-symbol "X" b))
            (equal (package-shadowing-symbols b) (list y))))
  t t t t t)
(deftest import-and-unintern-home
  (let* ((p (make-package "REG-E" :use nil)) (s (make-symbol "X")))
    (values (import s p) (eq (symbol-package s) p)
            (unintern s p) (symbol-package s) (find-symbol "X" p)))
  t t t nil nil)
(deftest rename-preserves-package-identity
  (let* ((a (make-package "REG-F" :use nil))
         (b (make-package "REG-G" :use (list a)))
         (x (intern "X" a)))
    (export x a)
    (rename-package a "REG-H" '("REG-H-NICK"))
    (values (eq a (find-package "REG-H-NICK")) (find-package "REG-F")
            (eq a (symbol-package x)) (eq x (find-symbol "X" b))))
  t nil t t)
(deftest export-inherited-symbol
  (let* ((a (make-package "REG-I" :use nil))
         (b (make-package "REG-J" :use (list a)))
         (c (make-package "REG-K" :use (list b)))
         (x (intern "X" a)))
    (export x a) (export x b)
    (values (eq x (find-symbol "X" c)) (nth-value 1 (find-symbol "X" b))
            (eq a (symbol-package x)) (unexport x b) (find-symbol "X" c)))
  t :external t t nil)
(deftest deleted-package-lifetime
  (let* ((p (make-package "REG-L" :use nil)) (s (intern "X" p)))
    (values (delete-package p) (packagep p) (package-name p)
            (find-package "REG-L") (delete-package p) (symbol-package s)))
  t t nil nil nil nil)
(deftest defpackage-option-order
  (let ((p (eval '(defpackage "REG-M" (:export #:CAR #:X) (:shadow #:CAR)
                   (:import-from "REG-A" #:X) (:intern #:PRIVATE)
                   (:use :cl) (:documentation "package documentation")))))
    (values (eq p (symbol-package (find-symbol "CAR" p)))
            (eq (find-symbol "X" p) (find-symbol "X" "REG-A"))
            (nth-value 1 (find-symbol "X" p))
            (nth-value 1 (find-symbol "PRIVATE" p))
            (documentation p t)))
  t t :external :internal "package documentation")
(deftest defpackage-rejects-duplicate-options
  (handler-case (eval '(defpackage "REG-N" (:size 1) (:size 2)))
    (program-error () :rejected))
  :rejected)
(deftest delete-package-continue
  (let* ((p (make-package "REG-O" :use nil))
         (user (make-package "REG-P" :use (list p))))
    (handler-bind ((package-error (lambda (c) (declare (ignore c)) (invoke-restart 'continue))))
      (delete-package p))
    (values (package-name p) (package-use-list user)))
  nil nil)
(deftest do-symbols-block-and-result
  (values (do-symbols (s "REG-M" :missing) (when (string= (symbol-name s) "CAR") (return :found)))
          (do-symbols (s "REG-E" s)))
  :found nil)
(deftest package-iterator-status
  (let ((entries nil))
    (with-package-iterator (next "REG-J" :internal :external :inherited)
      (loop (multiple-value-bind (found symbol status package) (next)
              (unless found (return))
              (push (list (symbol-name symbol) status (package-name package)) entries))))
    entries)
  (("X" :internal "REG-J")))
