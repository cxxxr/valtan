(in-package :cl-test)

(defclass gray-input (gray:fundamental-character-input-stream)
  ((data :initarg :data :reader gray-data)
   (position :initform 0 :accessor gray-position)))
(defmethod gray:stream-read-char ((s gray-input))
  (if (= (gray-position s) (length (gray-data s))) :eof
      (prog1 (char (gray-data s) (gray-position s)) (incf (gray-position s)))))
(defmethod gray:stream-unread-char ((s gray-input) character)
  (decf (gray-position s)) character)
(defmethod gray:stream-file-position ((s gray-input)) (gray-position s))
(defmethod (setf gray:stream-file-position) (position (s gray-input))
  (setf (gray-position s) (case position (:start 0) (:end (length (gray-data s))) (t position))) t)
(defclass gray-output (gray:fundamental-character-output-stream)
  ((data :initform (make-string-output-stream) :reader gray-data)
   (column :initform 0 :accessor gray-column)
   (events :initform nil :accessor gray-events)))
(defmethod gray:stream-write-char ((s gray-output) character)
  (write-char character (gray-data s))
  (if (char= character #\Newline) (setf (gray-column s) 0) (incf (gray-column s)))
  character)
(defmethod gray:stream-line-column ((s gray-output)) (gray-column s))
(defmethod gray:stream-finish-output ((s gray-output)) (push :finish (gray-events s)))
(defmethod gray:stream-force-output ((s gray-output)) (push :force (gray-events s)))
(defmethod gray:stream-clear-output ((s gray-output)) (push :clear (gray-events s)))
(defclass gray-byte-input (gray:fundamental-binary-input-stream)
  ((data :initarg :data :accessor gray-bytes)))
(defmethod gray:stream-read-byte ((s gray-byte-input))
  (if (gray-bytes s) (pop (gray-bytes s)) :eof))
(defclass gray-byte-output (gray:fundamental-binary-output-stream)
  ((data :initform nil :accessor gray-bytes)))
(defmethod gray:stream-write-byte ((s gray-byte-output) byte) (push byte (gray-bytes s)) byte)
(defclass gray-bulk-output (gray-output) ())
(defmethod gray:stream-write-sequence ((s gray-bulk-output) seq start end &key)
  (push (list start end) (gray-events s)) (call-next-method))
(defclass gray-nonblocking (gray-input) ())
(defmethod gray:stream-read-char-no-hang ((s gray-nonblocking)) nil)

(deftest gray-stream-type-and-lifetime
  (let ((s (make-instance 'gray-input :data "a")))
    (values (streamp s) (typep s 'stream) (input-stream-p s) (output-stream-p s)
            (stream-element-type s) (open-stream-p s)
            (close s) (open-stream-p s)
            (handler-case (read-char s) (stream-error () :closed))))
  t t t nil character t t nil :closed)
(deftest gray-read-peek-unread-and-eof
  (let ((s (make-instance 'gray-input :data "ab")))
    (values (peek-char nil s) (read-char s) (unread-char #\a s)
            (read-char s) (read-char s) (read-char s nil :end)
            (handler-case (read-char s) (end-of-file () :eof))))
  #\a #\a nil #\a #\b :end :eof)
(deftest gray-read-line-and-listen
  (let ((s (make-instance 'gray-input :data (format nil "abc~%tail"))))
    (values (listen s) (multiple-value-list (read-line s))
            (multiple-value-list (read-line s)) (listen s)
            (multiple-value-list (read-line s nil :end))))
  t ("abc" nil) ("tail" t) nil (:end t))
(deftest gray-nonblocking-read
  (let ((s (make-instance 'gray-nonblocking :data "a")))
    (values (read-char-no-hang s) (listen s) (read-char s)))
  nil nil #\a)
(deftest gray-sequence-input-bounds
  (let ((s (make-instance 'gray-input :data "abc")) (out (make-string 6 :initial-element #\-)))
    (values (read-sequence out s :start 1 :end 5) out
            (handler-case (read-sequence out s :start 5 :end 2) (type-error () :bad))))
  4 "-abc--" :bad)
(deftest gray-write-format-and-lines
  (let ((s (make-instance 'gray-output)))
    (values (fresh-line s)
            (progn (format s "~A~D" "x" 12) (fresh-line s))
            (progn (write-string "abcde" s :start 1 :end 4) (terpri s))
            (get-output-stream-string (gray-data s))))
  nil t nil "x12
bcd
")
(deftest gray-output-flush-operations
  (let ((s (make-instance 'gray-output)))
    (finish-output s) (force-output s) (clear-output s)
    (gray-events s))
  (:clear :force :finish))
(deftest gray-binary-sequences
  (let ((in (make-instance 'gray-byte-input :data (list 0 128 255)))
        (out (make-instance 'gray-byte-output)) (seq (vector 9 9 9 9 9)))
    (values (stream-element-type in) (read-sequence seq in :start 1) seq
            (write-sequence seq out :start 1 :end 4) (reverse (gray-bytes out))
            (read-byte in nil :end)))
  (unsigned-byte 8) 4 #(9 0 128 255 9) #(9 0 128 255 9) (0 128 255) :end)
(deftest gray-specialized-bulk-output
  (let ((s (make-instance 'gray-bulk-output)))
    (write-sequence "abcdef" s :start 1 :end 4)
    (values (gray-events s) (get-output-stream-string (gray-data s))))
  ((1 4)) "bcd")
(deftest gray-file-position
  (let ((s (make-instance 'gray-input :data "abc")))
    (values (file-position s) (file-position s 2) (read-char s)
            (file-position s :start) (read-char s) (file-position s :end)
            (read-char s nil :end)))
  0 t #\c t #\a t :end)
(deftest gray-composite-streams
  (let* ((a (make-instance 'gray-input :data "ab"))
         (b (make-instance 'gray-input :data "cd"))
         (out (make-instance 'gray-output))
         (in (make-echo-stream (make-concatenated-stream a b) out)))
    (values (read-char in) (unread-char #\a in) (read-line in nil nil)
            (get-output-stream-string (gray-data out))
            (progn (close in) (open-stream-p a))))
  #\a nil "abcd" "abcd" t)
(deftest gray-composite-nonblocking-and-force
  (let* ((in (make-instance 'gray-nonblocking :data "a"))
         (out (make-instance 'gray-output))
         (two-way (make-two-way-stream (make-concatenated-stream in)
                                      (make-broadcast-stream out))))
    (force-output two-way)
    (values (read-char-no-hang two-way) (gray-position in) (gray-events out)))
  nil 0 (:force))
(deftest gray-direct-write-string-null-end
  (let ((s (make-instance 'gray-output)))
    (gray:stream-write-string s "abcd" 1 nil)
    (get-output-stream-string (gray-data s)))
  "bcd")
