(in-package :cl-test)
(defun transcendental-near (a b) (< (abs (- a b)) 1d-12))
(deftest transcendental-real-values
  (and (eql (sin 0) 0.0) (eql (cos 0) 1.0) (eql (exp 0) 1.0)
       (transcendental-near (tan (/ pi 4)) 1)
       (transcendental-near (sqrt 9) 3)
       (transcendental-near (atan 1 -1) (* 3/4 pi))
       (transcendental-near (asinh (sinh 2)) 2)
       (transcendental-near (acosh (cosh 2)) 2)
       (transcendental-near (atanh (tanh 1/2)) 1/2))
  t)
(deftest transcendental-complex-identities
  (let ((z #c(0.3d0 0.4d0)))
    (and (transcendental-near (* (sqrt z) (sqrt z)) z)
         (transcendental-near (+ (* (sin z) (sin z)) (* (cos z) (cos z))) 1)
         (transcendental-near (tan z) (/ (sin z) (cos z)))
         (transcendental-near (- (* (cosh z) (cosh z)) (* (sinh z) (sinh z))) 1)
         (transcendental-near (tanh z) (/ (sinh z) (cosh z)))
         (transcendental-near (exp (log z)) z)))
  t)
(deftest transcendental-complex-inverses
  (every (lambda (z)
           (and (transcendental-near (sin (asin z)) z)
                (transcendental-near (cos (acos z)) z)
                (transcendental-near (tan (atan z)) z)
                (transcendental-near (sinh (asinh z)) z)
                (transcendental-near (cosh (acosh z)) z)
                (transcendental-near (tanh (atanh z)) z)))
         '(#c(0.3d0 0.4d0) #c(2d0 -0.5d0) #c(-2d0 0.5d0)))
  t)
(deftest transcendental-real-axis-branches
  (and (transcendental-near (sqrt -4) #c(0 2))
       (transcendental-near (sqrt #c(-4.0d0 -0.0d0)) #c(0 -2))
       (minusp (imagpart (asin 2))) (plusp (imagpart (asin -2)))
       (plusp (imagpart (acosh -2)))
       (transcendental-near (phase #c(-1.0d0 -0.0d0)) (- pi))
       (transcendental-near (cis (/ pi 2)) #c(0 1)))
  t)
(deftest noninteger-powers-and-signum
  (and (transcendental-near (expt 9 1/2) 3)
       (transcendental-near (expt -4 1/2) #c(0 2))
       (eql (expt 0 0.0) 1.0) (eql (expt 0 0.5) 0.0)
       (eql (signum -3/4) -1) (eql (signum -0.0) -0.0)
       (transcendental-near (signum #c(3 4)) #c(0.6 0.8)))
  t)
(deftest transcendental-type-checks
  (values (handler-case (sqrt 'x) (type-error () :rejected))
          (handler-case (sin 'x) (type-error () :rejected))
          (handler-case (atan #c(1 2) 1) (type-error () :rejected))
          (handler-case (cis #c(1 2)) (type-error () :rejected)))
  :rejected :rejected :rejected :rejected)
