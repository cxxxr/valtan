(defpackage #:mcclim-text-checks (:use #:clim #:clim-lisp))
(in-package #:mcclim-text-checks)
(defvar *checks* 0)
(defun check (value label)
  (assert value () "Text assertion ~D failed: ~S" (1+ *checks*) label)
  (incf *checks*))
(defun bounds (medium string &rest options)
  (multiple-value-list (apply #'climi::text-bounding-rectangle* medium string options)))
;; Compare every pixel, including antialiasing. Require nonempty reference ink
;; so a missing draw cannot make the comparison pass vacuously.
(ffi:js-eval "globalThis.mcclimTextPixelsEqual=(a,b)=>{
  const x=a.context.getImageData(0,0,160,160).data;
  const y=b.context.getImageData(0,0,160,160).data;
  return y.some((v,i)=>i%4===3&&v!==0)&&x.every((v,i)=>v===y[i]);
};return true;")
(defun same-pixels (a b)
  (eq ((ffi:ref "mcclimTextPixelsEqual") a b) (ffi:ref "true")))
(setf *checks* 0)
(let* ((port (find-port :server-path '(:browser)))
       (medium (make-instance 'mcclim-browser:browser-medium :port port))
       (reference (make-instance 'mcclim-browser:browser-medium :port port))
       (a (mcclim-browser::host-call "createSurface" 160 160))
       (b (mcclim-browser::host-call "createSurface" 160 160))
       (style (make-text-style :fix :roman 20))
       (text (format nil "M~%M")))
  (setf (climi::medium-drawable medium) a (climi::medium-drawable reference) b
        (medium-text-style medium) style (medium-text-style reference) style)
  (unwind-protect
       (multiple-value-bind (xmin ymin xmax ymax dx dy)
           (climi::text-bounding-rectangle* medium "M")
         (declare (ignore dy))
         (let ((height (text-style-height style medium)))
           (labels ((compare-lines (align-x align-y transformation rotate)
                      (setf (medium-transformation medium) transformation
                            (medium-transformation reference) transformation)
                      (mcclim-browser::canvas-call a "clearRect" 0 0 160 160)
                      (mcclim-browser::canvas-call b "clearRect" 0 0 160 160)
                      ;; Construct the reference from two independent single-line
                      ;; draws, separated by font height rather than block bounds.
                      (let* ((ox (case align-x (:left (- xmin)) (:right (- xmax))
                                           (:center (/ (+ xmin xmax) -2)) (otherwise 0)))
                             (oy (case align-y (:top (- ymin)) (:bottom (- (+ height ymax)))
                                           (:center (/ (+ ymin height ymax) -2)) (otherwise 0))))
                        (draw-text* medium text 60 60 :align-x align-x :align-y align-y
                                    :toward-x (if rotate 60 61) :toward-y (if rotate 61 60)
                                    :transform-glyphs t :ink +white+)
                        (dotimes (line 2)
                          (let* ((offset (+ oy (* line height)))
                                 (x (+ 60 (if rotate (- offset) ox)))
                                 (y (+ 60 (if rotate ox offset))))
                            (draw-text* reference "M" x y :align-x :baseline :align-y :baseline
                                        :toward-x (+ x (if rotate 0 1))
                                        :toward-y (+ y (if rotate 1 0))
                                        :transform-glyphs t :ink +white+)))
                        (check (same-pixels a b) (list :pixels align-x align-y rotate transformation)))))
             ;; This is the first assertion: old block bounds misplace bottom alignment.
             (compare-lines :left :bottom +identity-transformation+ nil)
             (dolist (transformation (list +identity-transformation+ (make-scaling-transformation 3/2 3/2)))
               (dolist (align-x '(:left :right :center))
                 (dolist (align-y '(:baseline :top :bottom :center))
                   (compare-lines align-x align-y transformation nil))))
             (dolist (align-y '(:baseline :top :bottom :center))
               (compare-lines :center align-y +identity-transformation+ t)))
           (setf (medium-transformation medium) +identity-transformation+)
           (check (equal (bounds medium #\M) (bounds medium "M")) :character)
           (check (equal (bounds medium "") '(0 0 0 0 0 0)) :empty)
           (check (equal (bounds medium text :start nil :end nil) (bounds medium text)) :nil-range)
           (check (equal (bounds medium (format nil "~%M") :start 1) (bounds medium "M")) :start)
           (check (equal (bounds medium (format nil "M~%") :end 1) (bounds medium "M")) :end)
           (dolist (direction '(:top-to-bottom :bottom-to-top :right-to-left :left-to-right))
             (setf (climi::medium-page-direction medium) direction)
             (let ((advance (if (member direction '(:top-to-bottom :right-to-left)) height (- height))))
               (check (equal (bounds medium text)
                             (list xmin (min ymin (+ advance ymin)) xmax
                                   (max ymax (+ advance ymax)) dx advance))
                      (list :multiline direction))
               (check (equal (bounds medium (format nil "~%M"))
                             (list xmin (min 0 (+ advance ymin)) xmax
                                   (max 0 (+ advance ymax)) dx advance))
                      (list :leading-blank direction))
               (check (equal (bounds medium (format nil "M~%"))
                             (list xmin (min ymin advance) xmax (max ymax advance) 0 advance))
                      (list :trailing-blank direction))
               (check (equal (bounds medium (format nil "~%~%"))
                             (list 0 (min 0 (* 2 advance)) 0 (max 0 (* 2 advance)) 0 (* 2 advance)))
                      (list :blank-lines direction))
               (check (equal (bounds medium (format nil "xM~%Mx") :start 1 :end 4)
                             (bounds medium text)) (list :substring direction))
               (check (= (sixth (bounds medium text)) (nth-value 3 (text-size medium text)))
                      (list :cursor direction))))
           (setf (climi::medium-page-direction medium) :top-to-bottom)
           (let ((large (make-text-style :fix :bold 32)))
             (check (= (sixth (bounds medium text :text-style large))
                       (nth-value 3 (text-size medium text :text-style large))) :explicit-style))
           (check (eq (medium-text-style medium) style) :preserve-style)))
    (mcclim-browser::host-call "releaseSurface" a)
    (mcclim-browser::host-call "releaseSurface" b)))
(format t "~&MCCLIM-TEXT-CHECKS-PASS ~D~%" *checks*)
(values :passed *checks*)
