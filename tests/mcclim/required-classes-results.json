  "native": {
    "implementation": "SBCL",
    "source": "(require :asdf)\n(load (merge-pathnames #p\"quicklisp/setup.lisp\" (user-homedir-pathname)))\n(ql:quickload :closer-mop :silent t)\n(defpackage :required-classes-checks (:use :cl) (:local-nicknames (:mop :closer-mop)))\n(in-package :required-classes-checks)\n;; Class-only lookup receives only required argument classes. Optional/rest\n;; arguments must still reach the methods and the EQL-dependent fallback.\n(defclass observed-generic (standard-generic-function) ()\n  (:metaclass mop:funcallable-standard-class))\n(defvar *observed-classes* :unset)\n(defvar *observed-arguments* :unset)\n(defmethod mop:compute-applicable-methods-using-classes :around ((gf observed-generic) classes)\n  (setf *observed-classes* (copy-list classes))\n  (call-next-method))\n(defmethod compute-applicable-methods :around ((gf observed-generic) args)\n  (setf *observed-arguments* (copy-list args))\n  (call-next-method))\n(defgeneric observed-call (x &optional optional &rest rest)\n  (:generic-function-class observed-generic))\n(defmethod observed-call ((x t) &optional optional &rest rest)\n  (list x optional rest))\n(assert (equal '(\"x\" 4 (:extra t)) (observed-call \"x\" 4 :extra t)))\n(assert (= 1 (length *observed-classes*)))\n(defmethod observed-call ((x (eql :special)) &optional optional &rest rest)\n  (list x optional rest))\n(assert (equal '(:special 7 (:extra nil)) (observed-call :special 7 :extra nil)))\n(assert (= 1 (length *observed-classes*)))\n(assert (equal '(:special 7 :extra nil) *observed-arguments*))\n(defgeneric observed-zero (&key option) (:generic-function-class observed-generic))\n(defmethod observed-zero (&key option) option)\n(assert (= 42 (observed-zero :option 42)))\n(assert (null *observed-classes*))\n\n(format t \"REQUIRED-CLASSES-NATIVE-PASS~%\")\n",
    "output": "REQUIRED-CLASSES-NATIVE-PASS\n",
    "passedAssertions": 7
  },
