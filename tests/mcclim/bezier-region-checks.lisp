;; Evaluated after bezier-canvas-checks.lisp, using its box and pixel helpers.
(in-package #:valtan-bezier-canvas-checks)
(defvar *region-checks* 0)
(assert (= 1 (length (multiple-value-list (mcclim-browser::host-call "createSurface" 1 1)))))
(let* ((*checks* 0)
       (surface (mcclim-browser::host-call "createSurface" 32 32))
       (medium (make-instance 'mcclim-browser:browser-medium
                              :port (find-port :server-path '(:browser))))
       (red (make-rgb-color 1 0 0)) (green (make-rgb-color 0 1 0))
       (blue (make-rgb-color 0 0 1))
       (a (box 2 2 16 16)) (b (box 10 10 26 26 t))
       (union (region-union a b))
       (difference (mcclim-bezier:region-difference union (box 6 6 20 20)))
       (lens (mcclim-bezier:make-bezier-area* '(2 16 2 2 26 2 26 16 26 30 2 30 2 16)))
       (curve (mcclim-bezier:make-bezier-curve* '(2 4 6 4 10 4 14 4))))
  (setf (climi::medium-drawable medium) surface)
  (flet ((clear ()
           (format t "~&MCCLIM-BEZIER-REGION-PROGRESS ~D~%" *checks*)
           (setf (medium-clipping-region medium) +everywhere+)
           (mcclim-browser::canvas-call medium "clearRect" 0 0 32 32))
         (background () (draw-rectangle* medium 0 0 32 32 :filled t :ink blue)))
    ;; Curved boundaries, not just straight Bezier approximations of rectangles.
    (draw-rectangle* medium 0 0 32 32 :filled t :ink red :clipping-region lens)
    (check-pixel surface 14 16 '(255 0 0 255))
    (check-pixel surface 14 2 '(0 0 0 0))
    (check-pixel surface 30 16 '(0 0 0 0))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t
                     :ink (compose-in red (make-opacity 1/2)) :clipping-region union)
    (check-pixel surface 4 4 '(255 0 0 128))
    (check-pixel surface 12 12 '(255 0 0 128))
    (check-pixel surface 22 22 '(255 0 0 128))
    (check-pixel surface 30 30 '(0 0 0 0))
    (clear)
    (background)
    (draw-rectangle* medium 0 0 32 32 :filled t
                     :ink (compose-in red (make-opacity 1/2)) :clipping-region difference)
    (check-pixel surface 4 4 '(128 0 127 255))
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 12 12 '(0 0 255 255))
    (check-pixel surface 22 22 '(128 0 127 255))
    (check-pixel surface 30 30 '(0 0 255 255))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink blue
                     :clipping-region
                     (make-instance 'climi::standard-region-intersection
                       :regions (list union (make-ellipse* 16 16 6 0 0 6))))
    (check-pixel surface 14 14 '(0 0 255 255))
    (check-pixel surface 4 4 '(0 0 0 0))
    (check-pixel surface 24 24 '(0 0 0 0))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink green
                     :clipping-region (climi::region-complement a))
    (check-pixel surface 4 4 '(0 0 0 0))
    (check-pixel surface 20 20 '(0 255 0 255))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink green
                     :clipping-region
                     (transform-region (make-translation-transformation 8 6) (box 1 1 5 5)))
    (check-pixel surface 10 8 '(0 255 0 255))
    (check-pixel surface 2 2 '(0 0 0 0))
    (check-pixel surface 18 14 '(0 0 0 0))
    (clear)
    (setf (medium-foreground medium) red)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink lens)
    (check-pixel surface 14 16 '(255 0 0 255))
    (check-pixel surface 14 2 '(0 0 0 0))
    (clear)
    (background)
    (setf (medium-foreground medium) green)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink difference)
    (check-pixel surface 4 4 '(0 255 0 255))
    (check-pixel surface 12 12 '(0 0 255 255))
    (check-pixel surface 22 22 '(0 255 0 255))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink (compose-in union (make-opacity 1/2)))
    (check-pixel surface 4 4 '(0 255 0 128))
    (check-pixel surface 12 12 '(0 255 0 128))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t
                     :ink (transform-region (make-translation-transformation 8 6) (box 1 1 5 5)))
    (check-pixel surface 10 8 '(0 255 0 255))
    (check-pixel surface 2 2 '(0 0 0 0))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t
                     :ink (compose-over (compose-in red a) (compose-in blue b)))
    (check-pixel surface 4 4 '(255 0 0 255))
    (check-pixel surface 12 12 '(255 0 0 255))
    (check-pixel surface 22 22 '(0 0 255 255))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink red :clipping-region curve)
    (check-pixel surface 8 4 '(0 0 0 0))
    (draw-rectangle* medium 0 0 32 32 :filled t :ink curve)
    (check-pixel surface 8 4 '(0 0 0 0))
    (clear)
    (draw-design medium union :ink difference)
    (check-pixel surface 4 4 '(0 255 0 255))
    (check-pixel surface 12 12 '(0 0 0 0))
    (check-pixel surface 22 22 '(0 255 0 255))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :clipping-region difference
                     :ink (make-rectangular-tile (make-pattern #2A((0 1)) (vector red blue)) 2 1))
    (check-pixel surface 4 4 '(255 0 0 255))
    (check-pixel surface 5 4 '(0 0 255 255))
    (check-pixel surface 12 12 '(0 0 0 0))
    (setf *region-checks* *checks*)))
(format t "~&MCCLIM-BEZIER-REGIONS-PASS ~D~%" *region-checks*)
(values :passed *region-checks*)
