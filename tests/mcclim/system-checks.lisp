(in-package :cl-user)

(let ((variable (clim-internals::make-dynamic-variable)))
  (assert (not (clim-internals::dynamic-variable-bound-p variable)))
  (setf (clim-internals::dynamic-variable-value variable) 7)
  (clim-internals::dynamic-variable-progv (list variable) (list 9)
    (assert (= 9 (clim-internals::dynamic-variable-value variable))))
  (assert (= 7 (clim-internals::dynamic-variable-value variable)))
  (clim-internals::dynamic-variable-makunbound variable)
  (assert (not (clim-internals::dynamic-variable-bound-p variable))))

(defclass mcclim-dynamic-test ()
  ((value :dynamic t :initform 2 :accessor mcclim-test-value)
   (ordinary :initform 3))
  (:metaclass clim-internals::class-with-dynamic-slots))
(let ((object (make-instance 'mcclim-dynamic-test)))
  (assert (= 2 (mcclim-test-value object)))
  (clim-internals::slot-dlet (((object 'value) 9))
    (assert (= 9 (mcclim-test-value object)))
    (setf (mcclim-test-value object) 10)
    (assert (= 10 (mcclim-test-value object))))
  (assert (= 2 (mcclim-test-value object)))
  (assert (= 3 (slot-value object 'ordinary)))
  (slot-makunbound object 'value)
  (assert (not (slot-boundp object 'value))))

(multiple-value-bind (x y) (clim:point-position (clim:make-point 2 3))
  (assert (= x 2)) (assert (= y 3)))
(multiple-value-bind (x y)
    (clim:transform-position (clim:make-translation-transformation 4 5) 2 3)
  (assert (= x 6)) (assert (= y 8)))
(let ((region (clim:make-rectangle* 0 0 10 20)))
  (assert (clim:region-contains-position-p region 5 10))
  (assert (not (clim:region-contains-position-p region 11 10))))
(write-line "MCCLIM-SYSTEM-CHECKS-PASS")
