(defpackage #:mcclim-png-checks (:use #:clim #:clim-lisp))
(in-package #:mcclim-png-checks)

(defun check-image (file width height expected)
  (multiple-value-bind (pixels designs) (read-bitmap-file file :format :png)
    (assert (null designs))
    (assert (equal (array-dimensions pixels) (list height width)))
    (assert (equal (loop for i below (array-total-size pixels)
                        collect (row-major-aref pixels i)) expected))
    (assert (equalp (climi::pattern-array (make-pattern-from-bitmap-file file)) pixels)))
  (let* ((pattern (make-pattern-from-bitmap-file file :format :png))
         (surface (mcclim-browser::host-call "createSurface" width height))
         (medium (make-instance 'mcclim-browser:browser-medium
                               :port (find-port :server-path '(:browser)))))
    (assert (= (pattern-width pattern) width))
    (assert (= (pattern-height pattern) height))
    (setf (climi::medium-drawable medium) surface)
    (draw-rectangle* medium 0 0 width height :filled t :ink +white+)
    (draw-rectangle* medium 0 0 width height :filled t :ink pattern)
    (let* ((context (mcclim-browser::property surface "context"))
           (data (ffi:ref ((ffi:ref context "getImageData") 0 0 width height) "data")))
      (loop for argb in expected for index from 0
            for alpha = (ldb (byte 8 24) argb)
            do (loop for shift in '(16 8 0) for channel from 0
                     for component = (ldb (byte 8 shift) argb)
                     for wanted = (round (+ (* component alpha) (* 255 (- 255 alpha))) 255)
                     for actual = (ffi:aget data (+ (* index 4) channel))
                     do (assert (<= (abs (- actual wanted)) 1) ()
                                "PNG rendering mismatch in ~A pixel ~D channel ~D: ~D vs ~D"
                                file index channel actual wanted))
               (assert (= (ffi:aget data (+ (* index 4) 3)) 255)))))
  t)

(defun run (cases bad-crc truncated)
  (assert (climi::bitmap-format-supported-p :png))
  (dolist (entry cases) (apply #'check-image entry))
  (assert (handler-case (progn (read-bitmap-file bad-crc :format :png) nil)
            (png-read:crc-failure () t)))
  (assert (handler-case (progn (read-bitmap-file truncated :format :png) nil)
            (error () t) (png-read:crc-failure () t)))
  (format t "~&MCCLIM-PNG-CHECKS-PASS ~D~%" (+ 2 (* 3 (length cases))))
  (values :passed (+ 2 (* 3 (length cases)))))
