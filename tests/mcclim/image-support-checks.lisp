(defpackage :valtan-image-tests (:use :cl))
(in-package :valtan-image-tests)
(defvar *checks* 0)
(defun check (actual expected)
  (assert (equal actual expected) () "Image support: ~S != ~S" actual expected)
  (incf *checks*))
(defun matches (text &optional (package :cl))
  (first (valtan-image-support:completions text package)))

(check (matches "lis") '("lisp-implementation-type" "lisp-implementation-version" "list" "list*"
                          "list-all-packages" "list-length" "listen" "listp"))
(check (matches "cl:m-v-b") '("cl:multiple-value-bind"))
(check (matches "m-v-b") '("multiple-value-bind"))
(check (matches "m-v-c") '("multiple-value-call"))
(check (matches "mvb") nil)
(check (matches "CL:M-V-B") '("CL:MULTIPLE-VALUE-BIND"))
(check (matches "missing-image-package:anything") nil)
(check (second (valtan-image-support:completions "m-v-b" :cl)) "multiple-value-bind")
(check (multiple-value-list (valtan-image-support:arglist 'let))
       '((valtan-image-support::bindings &body valtan-image-support::body) t))
(check (nth-value 1 (valtan-image-support:arglist 'cons)) nil)

(let ((package (make-package "VALTAN-IMAGE-COMPLETIONS" :nicknames '("VIC") :use '("CL"))))
  (unwind-protect
       (progn
         (export (intern "PUBLIC-NAME" package) package)
         (intern "PRIVATE-NAME" package)
         (export (intern "Mixed Name" package) package)
         (export (intern "A:B" package) package)
         (check (matches "vic:p-n") '("vic:public-name"))
         (check (matches "vic::p-n") '("vic::package-name" "vic::package-nicknames" "vic::parse-namestring"
                                      "vic::pathname-name" "vic::pprint-newline" "vic::print-not-readable"
                                      "vic::print-not-readable-object" "vic::private-name" "vic::public-name"))
         (check (matches "p-n" package) '("package-name" "package-nicknames" "parse-namestring"
                                        "pathname-name" "pprint-newline" "print-not-readable"
                                        "print-not-readable-object" "private-name" "public-name"))
         (check (matches "vic::m-v-b") '("vic::multiple-value-bind"))
         (check (matches "vic:m-v-b") nil)
         (check (matches "vic:|Mix") '("vic:|Mixed Name|"))
         (check (matches "vic:|mix") nil)
         (check (matches "vic:|A:") '("vic:|A:B|"))
         (check (not (null (member "valtan-image-completions:" (matches "v-i-c") :test #'string=))) t)
         (check (not (null (member "vic:" (matches "vic") :test #'string=))) t)
         (let ((*package* package))
           (system:add-package-local-nickname "SHORT" :cl package)
           (check (matches "short:m-v-b" package) '("short:multiple-value-bind")))
         (check (nth-value 1 (find-symbol "NOT-INTERNED" package)) nil)
         (matches "vic:not-interned")
         (check (nth-value 1 (find-symbol "NOT-INTERNED" package)) nil))
    (delete-package package)))

(defvar *init-evaluations* 0)
(defclass image-parent ()
  ((inherited :initarg :inherited :initform (incf *init-evaluations*))
   (odd :initarg not-a-keyword)))
(defclass image-child (image-parent)
  ((own :initarg :own :initform 17))
  (:default-initargs :own (progn (incf *init-evaluations*) 23)))
(defmethod initialize-instance :after ((object image-child) &key ((:extra extra) 91))
  (declare (ignore object extra)))
(defmethod shared-initialize :after ((object image-child) slots &key (shared 32))
  (declare (ignore object slots shared)))
(let ((keys (valtan-image-support:class-keywords ''image-child)))
  (flet ((description (name) (find name keys :key #'caar)))
    (check (description :inherited) '((:inherited inherited) (incf *init-evaluations*)))
    (check (description 'not-a-keyword) '((not-a-keyword odd) nil))
    (check (description :own) '((:own own) (progn (incf *init-evaluations*) 23)))
    (check (description :extra) '((:extra extra) 91))
    (check (description :shared) '((:shared shared) 32))
    (check (count :own keys :key #'caar) 1)))
(check *init-evaluations* 0)
(check (valtan-image-support:class-keywords 'missing-class) nil)
(check (valtan-image-support:class-keywords '(progn (incf *init-evaluations*) image-child)) nil)
(check *init-evaluations* 0)
(format t "IMAGE-SUPPORT-PASS ~D~%" *checks*)
(assert (= *checks* 33))
