(defpackage :mop-checks (:use :cl) (:local-nicknames (:mop :closer-mop)))
(in-package :mop-checks)

;; Exercise the protocol used by McCLIM dynamic slots: custom direct and
;; effective slot definitions plus raw location access beneath slot hooks.
(defclass marked-direct-slot (mop:standard-direct-slot-definition)
  ((marker :initarg :marker :initform nil :reader slot-marker)))
(defclass marked-effective-slot (mop:standard-effective-slot-definition)
  ((marker :initarg :marker :initform nil :accessor slot-marker)))
(defclass marked-class (standard-class)
  ((tag :initarg :tag :initform nil :reader class-tag)))
(defmethod mop:validate-superclass ((class marked-class) (super standard-class)) t)
(defmethod mop:direct-slot-definition-class ((class marked-class) &rest args)
  (declare (ignore args)) (find-class 'marked-direct-slot))
(defmethod mop:effective-slot-definition-class ((class marked-class) &rest args)
  (declare (ignore args)) (find-class 'marked-effective-slot))
(defmethod mop:compute-effective-slot-definition ((class marked-class) name direct-slots)
  (declare (ignore name))
  (let ((effective (call-next-method)))
    (setf (slot-marker effective) (some (lambda (slot)
                                        (and (typep slot 'marked-direct-slot) (slot-marker slot))) direct-slots))
    effective))
(defmethod allocate-instance ((class marked-class) &rest initargs)
  (declare (ignore initargs))
  (let ((object (call-next-method)))
    (dolist (slot (mop:class-slots class))
      (when (slot-marker slot)
        (setf (mop:standard-instance-access object (mop:slot-definition-location slot)) (list nil nil))))
    object))
(defun slot-cell (object slot)
  (mop:standard-instance-access object (mop:slot-definition-location slot)))
(defmethod mop:slot-boundp-using-class ((class marked-class) object (slot marked-effective-slot))
  (if (slot-marker slot) (first (slot-cell object slot)) (call-next-method)))
(defmethod mop:slot-value-using-class ((class marked-class) object (slot marked-effective-slot))
  (if (slot-marker slot)
      (if (first (slot-cell object slot)) (second (slot-cell object slot))
          (slot-unbound class object (mop:slot-definition-name slot)))
      (call-next-method)))
(defmethod (setf mop:slot-value-using-class) (value (class marked-class) object (slot marked-effective-slot))
  (if (slot-marker slot)
      (setf (first (slot-cell object slot)) t (second (slot-cell object slot)) value)
      (call-next-method)))
(defmethod mop:slot-makunbound-using-class ((class marked-class) object (slot marked-effective-slot))
  (if (slot-marker slot) (setf (first (slot-cell object slot)) nil) (call-next-method))
  object)

(defclass cell-object ()
  ((value :initarg :value :marker t :accessor cell-value)
   (plain :initform 7 :accessor plain-value))
  (:metaclass marked-class) (:tag useful))
(assert (equal '(useful) (class-tag (find-class 'cell-object))))
(assert (mop:class-finalized-p (find-class 'cell-object)))
(let* ((object (make-instance 'cell-object :value 42))
       (slot (find 'value (mop:class-slots (class-of object)) :key #'mop:slot-definition-name)))
  (assert (typep slot 'marked-effective-slot))
  (assert (equal '(t 42) (slot-cell object slot)))
  (assert (= 42 (cell-value object)))
  (assert (= 7 (plain-value object)))
  (setf (cell-value object) 99)
  (assert (= 99 (second (slot-cell object slot))))
  (slot-makunbound object 'value)
  (assert (not (slot-boundp object 'value)))
  (assert (handler-case (progn (cell-value object) nil) (unbound-slot () t))))

(defclass shared-base () ((shared :allocation :class :initform 12)))
(defclass shared-child (shared-base) ())
(let ((base (make-instance 'shared-base)) (child (make-instance 'shared-child)))
  (assert (= 12 (slot-value child 'shared)))
  (setf (slot-value child 'shared) 13)
  (assert (= 13 (slot-value base 'shared))))

(defclass future-child (future-parent) ((child-slot :initform 3)))
(assert (typep (find-class 'future-parent) 'mop:forward-referenced-class))
(assert (not (mop:class-finalized-p (find-class 'future-child))))
(defclass future-parent () ((parent-slot :initform 2)))
(assert (mop:class-finalized-p (find-class 'future-child)))
(let ((child (make-instance 'future-child)))
  (assert (= 2 (slot-value child 'parent-slot)))
  (assert (= 3 (slot-value child 'child-slot))))
(assert (equal '(x &optional y) (mop:extract-lambda-list '((x integer) &optional y))))
(assert (equal '(integer) (mop:extract-specializer-names '((x integer) &optional y))))
;; McCLIM presentation GFs remove otherwise applicable methods through the
;; MOP. Verify both class-only dispatch and EQL-dependent fallback dispatch.
(defclass filtered-generic (standard-generic-function) ()
  (:metaclass mop:funcallable-standard-class))
(defvar *class-protocol-calls* 0)
(defvar *argument-protocol-calls* 0)
(defmethod mop:compute-applicable-methods-using-classes :around ((gf filtered-generic) classes)
  (incf *class-protocol-calls*)
  (multiple-value-bind (methods definitive) (call-next-method)
    (values (remove-if (lambda (method) (eq (car (mop:method-specializers method)) (find-class 'integer))) methods)
            definitive)))
(defmethod compute-applicable-methods :around ((gf filtered-generic) args)
  (incf *argument-protocol-calls*)
  (remove-if (lambda (method) (eq (car (mop:method-specializers method)) (find-class 'integer)))
             (call-next-method)))
(defgeneric filtered-call (x) (:generic-function-class filtered-generic))
(defmethod filtered-call ((x t)) :general)
(defmethod filtered-call ((x integer)) :integer)
(assert (typep #'filtered-call 'filtered-generic))
(assert (eq :general (filtered-call 3)))
(assert (plusp *class-protocol-calls*))
(defmethod filtered-call ((x (eql 5))) :five)
(assert (eq :five (filtered-call 5)))
(assert (eq :general (filtered-call 6)))
(assert (plusp *argument-protocol-calls*))
(defclass first-parent () ())
(defclass second-parent () ())
(defclass changing-child (first-parent) ())
(defgeneric choose-parent (object))
(defmethod choose-parent ((object first-parent)) :first)
(defmethod choose-parent ((object second-parent)) :second)
(defgeneric parent-keywords (object &key))
(defmethod parent-keywords ((object first-parent) &key first) first)
(defmethod parent-keywords ((object second-parent) &key second) second)
(defvar *changing-object* (make-instance 'changing-child))
(assert (eq :first (choose-parent *changing-object*)))
(assert (= 3 (parent-keywords *changing-object* :first 3)))
(defclass changing-child (second-parent) ())
(assert (eq :second (choose-parent *changing-object*)))
(assert (= 4 (parent-keywords *changing-object* :second 4)))
(assert (handler-case (progn (parent-keywords *changing-object* :first 3) nil)
          (program-error () t)))
(write-line "MOP-CHECKS-PASS") (finish-output)
