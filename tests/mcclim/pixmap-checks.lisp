(defpackage #:mcclim-pixmap-checks (:use #:clim #:clim-lisp))
(in-package #:mcclim-pixmap-checks)
(defvar *checks* 0)
(defun check (value)
  (assert value () "Pixmap assertion ~D failed" (1+ *checks*))
  (incf *checks*))
(defun pixel (drawable x y)
  (let* ((surface (mcclim-browser::canvas-surface drawable))
         (context (mcclim-browser::property surface "context"))
         (data (ffi:ref ((ffi:ref context "getImageData") x y 1 1) "data")))
    (loop for i below 4 collect (ffi:aget data i))))
(defun check-pixel (drawable x y expected)
  (let ((actual (pixel drawable x y)))
    (assert (equal actual expected) () "Pixmap (~D,~D): expected ~S, got ~S" x y expected actual)
    (incf *checks*)))

;; Exercise the native-coordinate protocol independently of user transforms.
(defclass offset-medium (mcclim-browser:browser-medium)
  ((native :initarg :native :reader native)))
(defmethod climi::medium-native-transformation ((medium offset-medium)) (native medium))
(defmethod climi::medium-device-transformation ((medium offset-medium))
  (compose-transformations (native medium) (medium-transformation medium)))

(setf *checks* 0)
(let* ((port (find-port :server-path '(:browser)))
       (source (make-instance 'mcclim-browser:browser-medium :port port))
       (destination (make-instance 'mcclim-browser:browser-medium :port port))
       (a (mcclim-browser::host-call "createSurface" 24 24))
       (b (mcclim-browser::host-call "createSurface" 24 24)))
  (setf (climi::medium-drawable source) a (climi::medium-drawable destination) b)
  (labels ((reset ()
             (setf (medium-transformation source) +identity-transformation+
                   (medium-transformation destination) +identity-transformation+
                   (medium-clipping-region source) +everywhere+
                   (medium-clipping-region destination) +everywhere+)
             (mcclim-browser::canvas-call a "clearRect" 0 0 24 24)
             (draw-rectangle* destination 0 0 24 24 :filled t :ink +blue+))
           (red-source () (draw-rectangle* source 0 0 8 8 :filled t :ink +red+))
           (stripes ()
             (loop for ink in (list +red+ +green+ +blue+ +white+) for x from 0 by 4
                   do (draw-rectangle* destination x 0 (+ x 4) 4 :filled t :ink ink))))
    (reset)
    (draw-rectangle* source 0 0 4 4 :filled t :ink +red+)
    (medium-copy-area source 0 0 8 8 destination 4 4)
    (check-pixel destination 5 5 '(255 0 0 255))
    (check-pixel destination 10 10 '(0 0 0 0))
    (check-pixel destination 15 15 '(0 0 255 255))
    (reset)
    (draw-rectangle* source 0 0 4 4 :filled t :ink (compose-in +red+ (make-opacity 1/2)))
    (medium-copy-area source 0 0 4 4 destination 4 4)
    (check-pixel destination 5 5 '(255 0 0 128))
    (reset) (red-source)
    (setf (medium-clipping-region source) +nowhere+
          (medium-clipping-region destination) (make-rectangle* 8 8 12 12))
    (medium-copy-area source 0 0 8 8 destination 6 6)
    (check-pixel destination 7 7 '(0 0 255 255))
    (check-pixel destination 9 9 '(255 0 0 255))
    (check-pixel destination 13 13 '(0 0 255 255))
    (reset) (red-source)
    (setf (medium-clipping-region destination)
          (region-difference (make-rectangle* 2 2 16 16) (make-rectangle* 7 7 10 10)))
    (medium-copy-area source 0 0 8 8 destination 4 4)
    (check-pixel destination 5 5 '(255 0 0 255))
    (check-pixel destination 8 8 '(0 0 255 255))
    (check-pixel destination 11 11 '(255 0 0 255))
    (reset) (stripes)
    (copy-area destination 0 0 12 4 4 0)
    (loop for x in '(1 5 9 13) for expected in '((255 0 0 255) (255 0 0 255) (0 255 0 255) (0 0 255 255))
          do (check-pixel destination x 1 expected))
    (reset) (stripes)
    (copy-area destination 4 0 12 4 0 0)
    (loop for x in '(1 5 9 13) for expected in '((0 255 0 255) (0 0 255 255) (255 255 255 255) (255 255 255 255))
          do (check-pixel destination x 1 expected))
    (reset) (red-source)
    (medium-copy-area source -2 -2 4 4 destination 4 4)
    (check-pixel destination 5 5 '(0 0 255 255))
    (check-pixel destination 6 6 '(255 0 0 255))
    (check-pixel destination 8 8 '(0 0 255 255))
    (medium-copy-area source 0 0 4 4 destination -2 -2)
    (check-pixel destination 0 0 '(255 0 0 255))
    (check-pixel destination 2 2 '(0 0 255 255))
    (copy-area destination 0 0 0 8 2 2)
    (copy-area destination 0 0 8 0 2 2)
    (check-pixel destination 2 2 '(0 0 255 255))
    (reset)
    (draw-rectangle* destination 4 4 8 8 :filled t :ink +red+)
    (let ((tr (make-translation-transformation 4 4)))
      (setf (medium-transformation destination) tr)
      (copy-area destination 0 0 4 4 4 0)
      (check-pixel destination 8 4 '(255 0 0 255))
      (check-pixel destination 4 0 '(0 0 255 255))
      (check (eq tr (medium-transformation destination)))
      (check (handler-case (progn (copy-area destination 0 0 :bad 4 4 0) nil) (type-error () t)))
      (check (eq tr (medium-transformation destination))))
    (reset)
    (draw-rectangle* source 2 3 6 7 :filled t :ink +red+)
    (let ((from (make-translation-transformation 2 3)) (to (make-scaling-transformation 2 2)))
      (setf (medium-transformation source) from (medium-transformation destination) to)
      (medium-copy-area source 0 0 2 2 destination 4 3)
      (check-pixel destination 8 6 '(255 0 0 255))
      (check-pixel destination 10 6 '(0 0 255 255))
      (check (and (eq from (medium-transformation source)) (eq to (medium-transformation destination)))))
    (reset) (red-source)
    (let ((pixmap (copy-to-pixmap source 0 0 4 4 nil 2 1)))
      (check (and (= (pixmap-width pixmap) 6) (= (pixmap-height pixmap) 5) (= (pixmap-depth pixmap) 32)))
      (check-pixel pixmap 2 1 '(255 0 0 255))
      (check-pixel pixmap 0 0 '(0 0 0 0))
      (check (eq pixmap (copy-from-pixmap pixmap 0 0 6 5 destination 4 4)))
      (check-pixel destination 4 4 '(0 0 0 0))
      (check-pixel destination 6 5 '(255 0 0 255))
      (let ((other (allocate-pixmap source 6 5)))
        (medium-copy-area pixmap 0 0 6 5 other 0 0)
        (check-pixel other 2 1 '(255 0 0 255))
        (check-pixel other 0 0 '(0 0 0 0))
        (deallocate-pixmap other))
      (check (eq pixmap (copy-to-pixmap source 12 12 2 2 pixmap 2 1)))
      (check-pixel pixmap 2 1 '(0 0 0 0))
      (deallocate-pixmap pixmap))
    (let ((pixmap (with-output-to-pixmap (offscreen destination :width 8 :height 6)
                    ;; Establish the background explicitly; the pixmap protocol
                    ;; does not specify the initial pixel contents.
                    (draw-rectangle* offscreen 0 0 8 6 :filled t :ink +blue+)
                    (draw-rectangle* offscreen 1 1 5 4 :filled t :ink +green+))))
      (check-pixel pixmap 2 2 '(0 255 0 255))
      (check-pixel pixmap 0 0 '(0 0 255 255))
      (copy-from-pixmap pixmap 0 0 8 6 destination 0 0)
      (check-pixel destination 2 2 '(0 255 0 255))
      (check-pixel destination 0 0 '(0 0 255 255))
      (deallocate-pixmap pixmap))
    (let* ((pixmap (allocate-pixmap source 2.2 4.7))
           (surface (mcclim-browser::pixmap-surface pixmap))
           (canvas (mcclim-browser::property surface "canvas")))
      (check (and (= (pixmap-width pixmap) 3) (= (pixmap-height pixmap) 5)))
      (check (and (= (mcclim-browser::property canvas "width") 3) (= (mcclim-browser::property canvas "height") 5)))
      (deallocate-pixmap pixmap)
      (check (null (mcclim-browser::pixmap-surface pixmap)))
      (check (and (zerop (mcclim-browser::property canvas "width")) (zerop (mcclim-browser::property canvas "height"))))
      (deallocate-pixmap pixmap))
    (let ((from (make-instance 'offset-medium :port port :native (make-translation-transformation 3 2)))
          (to (make-instance 'offset-medium :port port :native (make-translation-transformation 5 4))))
      (reset)
      (setf (climi::medium-drawable from) a (climi::medium-drawable to) b)
      (draw-rectangle* from 0 0 4 4 :filled t :ink +red+)
      (setf (medium-clipping-region to) (make-rectangle* 1 1 4 4))
      (medium-copy-area from 0 0 4 4 to 0 0)
      (check-pixel to 6 5 '(255 0 0 255))
      (check-pixel to 5 4 '(0 0 255 255))
      (check-pixel to 0 0 '(0 0 255 255)))))
(assert (= *checks* 53))
(format t "~&MCCLIM-PIXMAP-CHECKS-PASS ~D~%" *checks*)
(values :passed *checks*)
