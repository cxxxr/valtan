(in-package #:valtan-fiveam-execution-checks)

(defun run-report-checks ()
  (flet ((report (failure skip)
           (let ((*hidden-failure* failure) (*hidden-skip* skip))
             ((ffi:ref "JSON" "parse")
              (ffi:cl->js (mcclim-upstream-checks::run 'nested-suite))))))
    (let ((result (report nil nil)))
      (assert (string= (ffi:js->cl (ffi:ref result "status")) "passed"))
      (assert (= (ffi:ref result "registered") 3))
      (assert (= (ffi:ref result "outerResults") 4))
      (assert (= (ffi:ref result "results") 6))
      (assert (= (ffi:ref result "executionResults") 9))
      (assert (= (ffi:ref (ffi:ref result "executions") "length") 5)))
    (dolist (kind '("executionFailed" "executionSkipped"))
      (let ((result (report (string= kind "executionFailed")
                            (string= kind "executionSkipped"))))
        (assert (string= (ffi:js->cl (ffi:ref result "status")) "failed"))
        (assert (= (ffi:ref result "outerResults") 4))
        (assert (= (ffi:aget result (ffi:cl->js kind)) 1))
        (assert (= (ffi:ref (ffi:ref result "executionNonpassed") "length") 1)))))
  (write-line "FIVEAM-NESTED-REPORT-PASS")
  t)

(run-report-checks)
