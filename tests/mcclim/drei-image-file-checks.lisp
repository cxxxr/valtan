;; Run with the real Drei adapter in Node, where COMPILE-FILE can write files.
(defpackage #:valtan-drei-file-tests (:use #:cl))
(in-package #:valtan-drei-file-tests)
(defvar *checks* 0)
(defun check (value) (assert value) (incf *checks*))

(let* ((image (drei-lisp-syntax::default-image))
       (source (make-pathname :name (symbol-name (gensym "drei-image-source-")) :type "lisp"))
       (artifact (compile-file-pathname source)))
  (unwind-protect
       (progn
         (with-open-file (stream source :direction :output :if-exists :error)
           (write-line "(in-package :valtan-drei-file-tests)" stream)
           (write-line "(defun file-generated (x) (+ x 9))" stream))
         (check (typep image 'drei-lisp-syntax::valtan-local-image))
         (multiple-value-bind (result notes)
             (drei-lisp-syntax::compile-file-for-drei image source *package*)
           (check (first result))
           (check (and (numberp (second result)) (>= (second result) 0)))
           (check (null notes)))
         (check (not (fboundp 'file-generated)))
         (check (probe-file artifact))
         (multiple-value-bind (result notes)
             (drei-lisp-syntax::compile-file-for-drei image source *package* t)
           (check (first result))
           (check (null notes)))
         (check (= (funcall (fdefinition 'file-generated) 42) 51))
         (check (equal (drei-lisp-syntax::arglist image 'file-generated) '(x)))
         (check (probe-file source)))
    (when (probe-file source) (delete-file source))
    (when (probe-file artifact) (delete-file artifact))))
(assert (= *checks* 11))
(format t "DREI-IMAGE-FILE-PASS ~D~%" *checks*)
