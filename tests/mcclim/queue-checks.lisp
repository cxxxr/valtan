(in-package :cl-user)
(let ((queue (make-instance 'climi::simple-queue)))
  (assert (null (climi::queue-listen queue)))
  (assert (null (climi::queue-read-no-hang queue)))
  (assert (equal (multiple-value-list (climi::queue-read-or-wait queue 0 nil)) '(nil :timeout)))
  (climi::queue-append queue :a)
  (climi::queue-append queue :b)
  (assert (climi::queue-listen queue))
  (assert (eq (climi::queue-peek queue) :a))
  (assert (eq (climi::queue-peek-if (lambda (x) (eq x :b)) queue) :b))
  (assert (equal (multiple-value-list
                  (climi::queue-listen-or-wait queue 0 (constantly t))) '(nil :wait-function)))
  (assert (eq (climi::queue-read queue) :a))
  (assert (eq (climi::queue-read-no-hang queue) :b))
  (assert (null (climi::queue-read-no-hang queue)))
  (climi::queue-schedule queue :later .01)
  (assert (eq (climi::queue-read-or-wait queue 1 nil) :later))
  (assert (null (climi::queue-listen queue)))
  (climi::queue-schedule queue :one 0)
  (climi::queue-schedule queue :two 0)
  (assert (eq (climi::queue-peek-if (lambda (x) (eq x :two)) queue) :two))
  (assert (equal (climi::queue-drain queue) '(:one :two)))
  (let ((polls 0))
    (assert (equal (multiple-value-list
                    (climi::queue-listen-or-wait queue 1 (lambda () (= (incf polls) 3))))
                   '(nil :wait-function)))
    (assert (= polls 3)))
  (let ((start (get-internal-real-time)))
    (assert (equal (multiple-value-list (climi::queue-listen-or-wait queue .02 nil)) '(nil :timeout)))
    (assert (>= (- (get-internal-real-time) start) (* .015 internal-time-units-per-second)))))
(write-line "PORTLESS-QUEUE-PASS")
