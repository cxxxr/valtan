;; Destination-dependent designs must retain their operations through nesting.
(defpackage #:mcclim-composite-flipping-checks (:use #:clim #:clim-lisp))
(in-package #:mcclim-composite-flipping-checks)
(defvar *checks* 0)
(defun pixels (surface)
  (let* ((context (mcclim-browser::property surface "context"))
         (data (ffi:ref ((ffi:ref context "getImageData") 0 0 24 24) "data")))
    (loop for i below (* 24 24 4) collect (ffi:aget data i))))
(defun check-pixel (surface x y expected)
  (let* ((start (* 4 (+ x (* y 24)))) (actual (subseq (pixels surface) start (+ start 4))))
    (assert (equal actual expected) () "Composite flip (~D,~D): expected ~S, got ~S" x y expected actual)
    (incf *checks*)))

(let* ((surface (mcclim-browser::host-call "createSurface" 24 24))
       (medium (make-instance 'mcclim-browser:browser-medium :port (find-port :server-path '(:browser))))
       (red (make-rgb-color 1 0 0)) (blue (make-rgb-color 0 0 1))
       (green (make-rgb-color 0 1 0)) (flip (make-flipping-ink red blue))
       (box (make-rectangle* 4 4 12 12)))
  (setf (climi::medium-drawable medium) surface *checks* 0)
  (labels ((reset ()
             (setf (medium-clipping-region medium) +everywhere+)
             (draw-rectangle* medium 0 0 24 24 :filled t :ink red))
           (paint (ink) (draw-rectangle* medium 0 0 24 24 :filled t :ink ink))
           (twice (drawer)
             (let ((before (pixels surface)))
               (funcall drawer)
               (assert (not (equal before (pixels surface)))) (incf *checks*)
               (funcall drawer)
               (assert (equal before (pixels surface))) (incf *checks*))))
    (reset)
    (draw-rectangle* medium 4 4 20 20 :filled t :ink (compose-over flip red))
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 2 2 '(255 0 0 255))
    ;; An opaque background is repainted on each OVER, then flipped again.
    (paint (compose-over flip red))
    (check-pixel surface 8 8 '(0 0 255 255))
    (reset)
    (paint (compose-over flip flip))
    (check-pixel surface 8 8 '(255 0 0 255))
    (paint (compose-over (compose-in green (make-opacity 1/2)) flip))
    (check-pixel surface 8 8 '(0 128 127 255))
    (reset)
    (paint (compose-over (compose-in flip box) red))
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 2 2 '(255 0 0 255))
    (reset)
    (paint (compose-in flip box))
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 2 2 '(255 0 0 255))
    (paint (compose-in flip box))
    (check-pixel surface 8 8 '(255 0 0 255))
    (twice (lambda () (paint (compose-in flip box))))
    (paint (compose-out flip box))
    (check-pixel surface 8 8 '(255 0 0 255))
    (check-pixel surface 2 2 '(0 0 255 255))
    (paint (compose-out flip box))
    (check-pixel surface 2 2 '(255 0 0 255))
    (twice (lambda () (paint (compose-out flip box))))
    (paint (transform-region (make-translation-transformation 4 2) (compose-in flip box)))
    (check-pixel surface 10 8 '(0 0 255 255))
    (check-pixel surface 5 5 '(255 0 0 255))
    (reset)
    (draw-rectangle* medium 0 0 20 20 :filled t :ink (compose-in flip box)
                     :transformation (make-translation-transformation 4 2))
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 14 8 '(255 0 0 255))
    ;; Flip opacity is determined by both source designs, not by painting XOR
    ;; onto an empty transparent surface (which has no color to exchange).
    (reset)
    (paint (compose-in green flip))
    (check-pixel surface 8 8 '(0 255 0 255))
    (reset)
    (paint (compose-out green flip))
    (check-pixel surface 8 8 '(255 0 0 255))
    (paint (compose-in green (make-flipping-ink (compose-in red box) blue)))
    (check-pixel surface 8 8 '(0 255 0 255))
    (check-pixel surface 2 2 '(255 0 0 255))
    (reset)
    (let* ((indices (make-array '(1 2) :initial-contents '((0 1))))
           (palette (vector flip +transparent-ink+))
           (pattern (make-pattern indices palette))
           (tile (make-rectangular-tile pattern 2 1)))
      (draw-pattern* medium pattern 4 6)
      (check-pixel surface 4 6 '(0 0 255 255))
      (check-pixel surface 5 6 '(255 0 0 255))
      (check-pixel surface 6 6 '(255 0 0 255))
      (draw-pattern* medium pattern 4 6)
      (twice (lambda () (draw-pattern* medium pattern 4 6)))
      (paint tile)
      (check-pixel surface 4 6 '(0 0 255 255))
      (check-pixel surface 5 6 '(255 0 0 255))
      (paint tile)
      (twice (lambda () (paint tile)))
      (paint (transform-region (make-translation-transformation 1 0) tile))
      (check-pixel surface 4 6 '(255 0 0 255))
      (check-pixel surface 5 6 '(0 0 255 255))
      (reset)
      (paint (transform-region (compose-transformations (make-translation-transformation 12 4)
                                                        (make-rotation-transformation (/ pi 2))) pattern))
      (check-pixel surface 11 4 '(0 0 255 255))
      (check-pixel surface 11 5 '(255 0 0 255))
      (reset)
      (setf (aref palette 0) (make-flipping-ink red green))
      (paint tile)
      (check-pixel surface 4 6 '(0 255 0 255))
      (check-pixel surface 5 6 '(255 0 0 255))
      (reset)
      (setf (aref palette 0) flip (aref indices 0 0) 1 (aref indices 0 1) 0)
      (paint tile)
      (check-pixel surface 4 6 '(255 0 0 255))
      (check-pixel surface 5 6 '(0 0 255 255))
      (reset)
      (paint (compose-in green tile))
      (check-pixel surface 4 6 '(255 0 0 255))
      (check-pixel surface 5 6 '(0 255 0 255)))
    (reset)
    (let ((foreground (medium-foreground medium)))
      (unwind-protect
           (progn
             (setf (medium-foreground medium) flip)
             (paint box)
             (check-pixel surface 8 8 '(0 0 255 255))
             (check-pixel surface 2 2 '(255 0 0 255)))
        (setf (medium-foreground medium) foreground)))
    (reset)
    (paint (compose-over (compose-in flip (make-rectangle* 4 4 14 14))
                         (compose-in flip (make-rectangle* 10 4 20 14))))
    (check-pixel surface 6 8 '(0 0 255 255))
    (check-pixel surface 12 8 '(255 0 0 255))
    (check-pixel surface 18 8 '(0 0 255 255))
    (check-pixel surface 2 2 '(255 0 0 255))
    (reset)
    (setf (medium-clipping-region medium)
          (region-difference (make-rectangle* 0 0 24 24) (make-rectangle* 9 9 15 15)))
    (twice (lambda () (draw-circle* medium 12 12 8.5 :filled t
                                   :ink (compose-in flip (make-rectangle* 4 4 20 20)))))
    (twice (lambda () (draw-text* medium "M" 3 19 :text-size 18
                                 :ink (compose-out flip (make-rectangle* 0 0 2 24)))))))
(assert (= *checks* 54))
(format t "~&MCCLIM-COMPOSITE-FLIPPING-CHECKS-PASS ~D~%" *checks*)
(values :passed *checks*)
