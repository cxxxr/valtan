;; Real upstream Bezier designs, rendered through the optional browser adapter.
(defpackage #:valtan-bezier-canvas-checks (:use #:clim #:clim-lisp))
(in-package #:valtan-bezier-canvas-checks)
(defvar *checks* 0)
(defun pixel (surface x y)
  (let* ((context (mcclim-browser::property surface "context"))
         (image ((ffi:ref context "getImageData") x y 1 1))
         (data (ffi:ref image "data")))
    (loop for i below 4 collect (ffi:aget data i))))
(defun check-pixel (surface x y expected)
  (let ((actual (pixel surface x y)))
    (assert (equal actual expected) () "Bezier pixel (~D,~D): expected ~S, got ~S"
            x y expected actual)
    (incf *checks*)))
(defun box (left top right bottom &optional reverse)
  (let* ((points (list (make-point left top) (make-point right top)
                       (make-point right bottom) (make-point left bottom)))
         (points (if reverse (reverse points) points)))
    (mcclim-bezier:make-bezier-area
     (cons (first points)
           (loop for (a b) on (append points (list (first points))) while b
                 append (list a b b))))))

(let* ((surface (mcclim-browser::host-call "createSurface" 32 32))
       (medium (make-instance 'mcclim-browser:browser-medium
                              :port (find-port :server-path '(:browser))))
       (red (make-rgb-color 1 0 0)) (green (make-rgb-color 0 1 0))
       (blue (make-rgb-color 0 0 1))
       (curve (mcclim-bezier:make-bezier-curve* '(2 4 6 4 10 4 14 4)))
       (a (box 2 2 16 16)) (b (box 10 10 26 26 t))
       (union (region-union a b))
       (difference (mcclim-bezier:region-difference union (box 6 6 20 20))))
  (setf (climi::medium-drawable medium) surface *checks* 0)
  (flet ((clear ()
           (setf (medium-clipping-region medium) +everywhere+)
           (mcclim-browser::canvas-call medium "clearRect" 0 0 32 32)))
    (draw-design medium curve :ink red :line-thickness 2 :line-cap-shape :butt)
    (check-pixel surface 8 4 '(255 0 0 255))
    (check-pixel surface 8 7 '(0 0 0 0))
    (check-pixel surface 1 4 '(0 0 0 0))
    (clear)
    (draw-design medium curve :ink red :line-thickness 2 :line-dashes '(4 4))
    (check-pixel surface 4 4 '(255 0 0 255))
    (check-pixel surface 8 4 '(0 0 0 0))
    (clear)
    (draw-design medium (mcclim-bezier:make-bezier-curve* '(2 20 2 2 26 2 26 20))
                 :ink red :line-thickness 4)
    (check-pixel surface 14 6 '(255 0 0 255))
    (check-pixel surface 14 15 '(0 0 0 0))
    (clear)
    (draw-design medium a :ink red)
    (check-pixel surface 8 8 '(255 0 0 255))
    (check-pixel surface 0 0 '(0 0 0 0))
    (clear)
    (draw-design medium union :ink (compose-in red (make-opacity 1/2)))
    (check-pixel surface 4 4 '(255 0 0 128))
    (check-pixel surface 12 12 '(255 0 0 128))
    (check-pixel surface 22 22 '(255 0 0 128))
    (check-pixel surface 30 30 '(0 0 0 0))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink blue)
    (draw-design medium difference :ink (compose-in red (make-opacity 1/2)))
    (check-pixel surface 4 4 '(128 0 127 255))
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 12 12 '(0 0 255 255))
    (check-pixel surface 22 22 '(128 0 127 255))
    (check-pixel surface 30 30 '(0 0 255 255))
    (clear)
    (draw-design medium (box 1 1 5 5) :ink green
                 :transformation (make-translation-transformation 8 6))
    (check-pixel surface 10 8 '(0 255 0 255))
    (check-pixel surface 18 14 '(0 0 0 0))
    (check-pixel surface 2 2 '(0 0 0 0))
    (assert (identity-transformation-p (medium-transformation medium)))
    (clear)
    (draw-design medium (box 1 1 5 5) :ink green
                 :transformation (make-scaling-transformation 3 2))
    (check-pixel surface 4 3 '(0 255 0 255))
    (check-pixel surface 11 8 '(0 255 0 255))
    (check-pixel surface 16 6 '(0 0 0 0))
    (clear)
    (draw-design medium union :ink (compose-in red (make-opacity 1/2))
                 :transformation (make-translation-transformation 2 4))
    (check-pixel surface 5 7 '(255 0 0 128))
    (check-pixel surface 14 17 '(255 0 0 128))
    (check-pixel surface 30 30 '(0 0 0 0))
    (clear)
    (draw-design medium union :ink blue :clipping-region (make-ellipse* 16 16 6 0 0 6))
    (check-pixel surface 14 14 '(0 0 255 255))
    (check-pixel surface 4 4 '(0 0 0 0))
    (check-pixel surface 24 24 '(0 0 0 0))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink green)
    (draw-design medium difference
                 :ink (make-rectangular-tile (make-pattern #2A((0 1)) (vector red blue)) 2 1))
    (check-pixel surface 4 4 '(255 0 0 255))
    (check-pixel surface 5 4 '(0 0 255 255))
    (check-pixel surface 12 12 '(0 255 0 255))
    (clear)
    (draw-design medium difference
                 :ink (compose-in red (make-rectangle* 0 0 10 10)))
    (check-pixel surface 4 4 '(255 0 0 255))
    (check-pixel surface 8 8 '(0 0 0 0))
    (check-pixel surface 22 22 '(0 0 0 0))
    (clear)
    (draw-rectangle* medium 0 0 32 32 :filled t :ink +white+)
    (draw-design medium union :ink +flipping-ink+)
    (check-pixel surface 4 4 '(0 0 0 255))
    (check-pixel surface 12 12 '(0 0 0 255))
    (draw-design medium union :ink +flipping-ink+)
    (check-pixel surface 4 4 '(255 255 255 255))
    (check-pixel surface 12 12 '(255 255 255 255))))
(format t "~&MCCLIM-BEZIER-DRAWING-PASS ~D~%" *checks*)

;; Use an actual application pane to exercise the upstream recording/replay
;; methods, including movement of the recorded Bezier design.
(let ((pane (find-pane-named *application-frame* 'valtan-clim-demo::canvas)))
  ;; Recording streams expose a faux BASIC-MEDIUM while recording is enabled.
  ;; Select the backend medium and replay with recording disabled, as the CLIM
  ;; redisplay path does. WITH-OUTPUT-TO-OUTPUT-RECORD enables recording locally.
  (with-output-recording-options (pane :record nil :draw t)
    (let* ((medium (sheet-medium pane))
           (original (climi::medium-drawable medium))
           (surface (mcclim-browser::host-call "createSurface" 600 280)))
      (assert (typep medium 'mcclim-browser:browser-medium))
      (unwind-protect
           (progn
             (setf (climi::medium-drawable medium) surface)
             (let ((record (with-output-to-output-record (pane)
                             (draw-design pane (box 2 2 10 10) :ink +red+
                                          :transformation (make-translation-transformation 4 6)))))
               (check-pixel surface 8 10 '(0 0 0 0))
               (replay record pane)
               (check-pixel surface 8 10 '(255 0 0 255))
               (check-pixel surface 3 3 '(0 0 0 0))
               (mcclim-browser::canvas-call medium "clearRect" 0 0 600 280)
               (setf (output-record-position record) (values 20 22))
               (replay record pane)
               (check-pixel surface 22 24 '(255 0 0 255))
               (check-pixel surface 8 10 '(0 0 0 0))))
        (setf (climi::medium-drawable medium) original)))))
(format t "~&MCCLIM-BEZIER-REPLAY-PASS ~D~%" *checks*)
(values :passed *checks*)
