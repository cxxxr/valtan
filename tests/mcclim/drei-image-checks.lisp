;; Sent to the real McCLIM workbench. Uses upstream buffer/view/mark classes.
(defpackage :valtan-drei-image-tests (:use :cl))
(in-package :valtan-drei-image-tests)
(defvar *checks* 0)
(defun check (value) (assert value) (incf *checks*))
(let* ((image (drei-lisp-syntax::default-image))
       (buffer (make-instance 'drei:drei-buffer))
       (view (make-instance 'drei:drei-buffer-view :buffer buffer))
       (mark (drei-buffer:make-buffer-mark buffer))
       (package *package*))
  (check (typep image 'drei-lisp-syntax::valtan-local-image))
  (multiple-value-bind (result notes)
      (drei-lisp-syntax::compile-string-for-drei
       image "(defun generated (x) (+ x 5))" package view mark)
    (check (first result))
    (check (and (numberp (second result)) (>= (second result) 0)))
    (check (null notes)))
  (check (= (funcall (fdefinition 'generated) 7) 12))
  (check (equal (drei-lisp-syntax::arglist image 'generated) '(x)))
  (multiple-value-bind (result notes)
      (drei-lisp-syntax::compile-string-for-drei
       image "(defparameter *compile-order* 11)
              (defmacro compile-order-macro () *compile-order*)
              (defun compiled-order () (compile-order-macro))" package view mark)
    (check (first result))
    (check (null notes)))
  (check (= (funcall (fdefinition 'compiled-order)) 11))
  (multiple-value-bind (result notes)
      (drei-lisp-syntax::compile-string-for-drei image "(warn \"image warning\")" package view mark)
    (check (first result))
    (check (= (length notes) 1))
    (check (typep (first notes) 'drei-lisp-syntax::warning-compiler-note))
    (check (search "image warning" (drei-lisp-syntax::message (first notes)))))
  (multiple-value-bind (result notes)
      (drei-lisp-syntax::compile-string-for-drei image "(error \"image error\")" package view mark)
    (check (null (first result)))
    (check (typep (first notes) 'drei-lisp-syntax::error-compiler-note))
    (check (search "image error" (drei-lisp-syntax::message (first notes)))))
  (multiple-value-bind (result notes)
      (drei-lisp-syntax::compile-string-for-drei image "(defun unfinished (" package view mark)
    (check (null (first result)))
    (check (typep (first notes) 'drei-lisp-syntax::compiler-note)))
  (multiple-value-bind (result notes)
      (drei-lisp-syntax::compile-file-for-drei image "/missing-valtan-image-file.lisp" package t)
    (check (null (first result)))
    (check (typep (first notes) 'drei-lisp-syntax::error-compiler-note)))
  (check (handler-case
             (drei-lisp-syntax::compile-string-for-drei image "42" :missing-image-package view mark)
           (package-error () t)))
  (check (eq *package* package)))
(assert (= *checks* 22))
(values :drei-image-checks *checks*)
