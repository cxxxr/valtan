(defpackage :valtan-stage (:use :cl))
(in-package :valtan-stage)
(system:initialize-file-system (ffi:ref "globalThis.valtanStageFS") (ffi:ref "globalThis.valtanStagePath"))
(ffi:set (ffi:ref "globalThis.valtanStageKernel") (ffi:ref "lisp"))
(defvar *records* (ffi:array))
(defvar *serial* 0)
(ffi:set (ffi:ref "globalThis.valtanStageRecords") *records*)
(defun stage-source (source filename features)
  (declare (ignore source))
  (dolist (feature features) (pushnew feature *features*))
  (let ((*package* (find-package :cl-user)) (*readtable* *readtable*)
        (artifact (format nil "~A/~D.fasl" (ffi:js->cl (ffi:ref "globalThis.valtanStageArtifacts")) (incf *serial*))))
    (format t "~&TARGET-STAGE ~A~%" filename)
    (progv system::*file-local-variables* (mapcar #'symbol-value system::*file-local-variables*)
      (multiple-value-bind (output warnings failure) (compile-file filename :output-file artifact)
        (declare (ignore warnings))
        (when failure (error "Target compilation failed for ~A" filename))
        (let ((system::*compiled-file-literals* (system:make-raw-array 0))
              (*load-pathname* output) (*load-truename* output) (*readtable* (copy-readtable nil)))
          ((ffi:ref "globalThis.valtanStageLoad") (ffi:ref "lisp") (ffi:cl->js (namestring output))))
        ((ffi:ref *records* "push")
         (ffi:object :source (ffi:cl->js filename) :artifact (ffi:cl->js artifact)))))))
(setf (fdefinition 'system::load-embedded-source) #'stage-source)
