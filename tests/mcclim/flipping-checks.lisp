;; Real CLIM drawing contracts for solid flipping designs. The browser-only
;; host test is separate; these calls exercise medium ink and clipping dispatch.
(defpackage #:mcclim-flipping-checks (:use #:clim #:clim-lisp))
(in-package #:mcclim-flipping-checks)
(defvar *checks* 0)
(defun pixels (surface)
  (let* ((context (mcclim-browser::property surface "context"))
         (image ((ffi:ref context "getImageData") 0 0 24 24))
         (data (ffi:ref image "data")))
    (loop for i below (* 24 24 4) collect (ffi:aget data i))))
(defun check-pixel (surface x y expected)
  (let* ((start (* 4 (+ x (* y 24))))
         (actual (subseq (pixels surface) start (+ start 4))))
    (assert (equal actual expected) () "Expected ~S at ~S,~S; got ~S" expected x y actual)
    (incf *checks*)))

(let* ((surface (mcclim-browser::host-call "createSurface" 24 24))
       (medium (make-instance 'mcclim-browser:browser-medium
                             :port (find-port :server-path '(:browser))))
       (red (make-rgb-color 1 0 0)) (blue (make-rgb-color 0 0 1))
       (green (make-rgb-color 0 1 0)) (yellow (make-rgb-color 1 1 0)))
  (setf (climi::medium-drawable medium) surface *checks* 0
        (medium-foreground medium) red (medium-background medium) blue)
  (flet ((reset ()
           (setf (medium-clipping-region medium) +everywhere+)
           (draw-rectangle* medium 0 0 24 24 :filled t :ink red))
         (rectangle (ink)
           (draw-rectangle* medium 4 4 16 16 :filled t :ink ink))
         (twice (drawer)
           (let ((before (pixels surface)))
             (funcall drawer)
             (assert (not (equal before (pixels surface))))
             (funcall drawer)
             (assert (equal before (pixels surface)))
             (incf *checks*))))
    (reset)
    (rectangle +flipping-ink+)
    (check-pixel surface 8 8 '(0 0 255 255))
    (check-pixel surface 2 2 '(255 0 0 255))
    (rectangle +flipping-ink+)
    (check-pixel surface 8 8 '(255 0 0 255))
    (let ((ink (make-flipping-ink red green)))
      (rectangle ink)
      (check-pixel surface 8 8 '(0 255 0 255))
      (rectangle ink)
      (check-pixel surface 8 8 '(255 0 0 255)))
    (let* ((first (make-rectangular-tile (make-pattern #2A((0 1)) (vector red blue)) 2 1))
           (second (make-rectangular-tile (make-pattern #2A((0 1)) (vector green yellow)) 2 1)))
      (draw-rectangle* medium 0 0 24 24 :filled t :ink first)
      (rectangle (make-flipping-ink first second))
      (check-pixel surface 4 8 '(0 255 0 255))
      (check-pixel surface 5 8 '(255 255 0 255))
      (check-pixel surface 6 8 '(0 255 0 255)))
    (reset)
    (setf (medium-clipping-region medium)
          (region-difference (make-rectangle* 0 0 24 24) (make-rectangle* 7 7 11 11)))
    (rectangle +flipping-ink+)
    (check-pixel surface 8 8 '(255 0 0 255))
    (check-pixel surface 12 12 '(0 0 255 255))
    (reset)
    ;; Fractional edge coverage must not accumulate after the second drawing.
    (twice (lambda () (draw-circle* medium 12 12 8.5 :filled t :ink +flipping-ink+)))
    (twice (lambda () (draw-text* medium "M" 3 19 :text-size 18 :ink +flipping-ink+)))))
(assert (= *checks* 12))
(format t "~&MCCLIM-FLIPPING-CHECKS-PASS ~D~%" *checks*)
(values :passed *checks*)
