;; Reference values measured with upstream ZPB-TTF 1.0.6 on SBCL and the same
;; CL-DejaVu 2.37 font. Includes a composite glyph and a supplementary character.
(zpb-ttf:with-font-loader (font (cl-dejavu:font-pathname "DejaVuSans.ttf"))
  (assert (equal (list (zpb-ttf:family-name font)
                       (zpb-ttf:units/em font)
                       (zpb-ttf:glyph-count font))
                 '("DejaVu Sans" 2048 6253)))
  (dolist (expected '((65 36 1401 2 16 0 1384 1493)
                      (233 171 1260 3 113 -29 1151 1638)
                      (955 848 1212 1 61 0 1151 1556)
                      (128512 5857 2135 9 170 -150 1965 1646)))
    (let* ((code (first expected))
           (glyph (zpb-ttf:find-glyph (code-char code) font))
           (box (zpb-ttf:bounding-box glyph))
           (actual (list code (zpb-ttf:font-index glyph)
                         (zpb-ttf:advance-width glyph) (zpb-ttf:contour-count glyph)
                         (zpb-ttf:xmin box) (zpb-ttf:ymin box)
                         (zpb-ttf:xmax box) (zpb-ttf:ymax box))))
      (assert (equal actual expected) () "Font metrics differ: ~S vs ~S" actual expected)
      (dotimes (i (zpb-ttf:contour-count glyph))
        (let ((points (zpb-ttf:contour glyph i)))
          (assert (plusp (length points)))
          (loop for point across points do
            (assert (realp (zpb-ttf:x point)))
            (assert (realp (zpb-ttf:y point)))))))))
(write-line "ZPB-TTF-PARSE-PASS")
