(defvar *ltv-loads* 0)
(defun ltv-initialize () (incf *ltv-loads*) (list :loaded))
(defun ltv-value () (load-time-value (ltv-initialize)))
(assert (= *ltv-loads* 1))
(assert (eq (ltv-value) (ltv-value)))
(assert (equal (ltv-value) '(:loaded)))
(assert (= *ltv-loads* 1))
(assert (equal (mapcar #'funcall
                        (loop for i below 3 collect (let ((saved i)) (lambda () saved))))
               '(0 1 2)))
(defun auxiliary-shadowing (x &aux (original (lambda () x)) (x (1+ x)))
  (list (funcall original) x))
(assert (equal '(3 4) (auxiliary-shadowing 3)))
(defvar *auxiliary-shadowing* :outside)
(defun special-auxiliary-shadowing (*auxiliary-shadowing*
                                  &aux (*auxiliary-shadowing* (1+ *auxiliary-shadowing*)))
  *auxiliary-shadowing*)
(assert (= 4 (special-auxiliary-shadowing 3)))
(assert (eq :outside *auxiliary-shadowing*))
(assert (= 42 (funcall (first (multiple-value-list (lambda () 42))))))
(let ((next (lambda () 21)) (previous nil))
  (psetf next (lambda () 42) previous next)
  (assert (= 42 (funcall next)))
  (assert (= 21 (funcall previous))))
(write-line "LOAD-TIME-VALUE-PASS")
(defun paired-place (cell) (values (car cell) (cdr cell)))
(defsetf paired-place (cell) (x y)
  `(progn (setf (car ,cell) ,x (cdr ,cell) ,y) (values ,x ,y)))
(defun store-pair (cell x y)
  (setf (paired-place cell) (values x y)))
(let ((cell (cons nil nil)))
  (assert (equal '(3 9) (multiple-value-list (store-pair cell 3 9))))
  (assert (equal '(3 . 9) cell)))
(defvar *macrolet-load-value* :initial)
;; Install this macro at execution time so both compilation modes exercise EVAL.
(eval '(defmacro macrolet-load-value () `',*macrolet-load-value*))
(assert (= 20
           (eval '(macrolet ((step-value (value)
                              `(progn (setf *macrolet-load-value* ,value)
                                      (macrolet-load-value))))
                    (step-value 10)
                    (step-value 20)))))

(defun keyed-place (cell &key scale) (declare (ignore scale)) (car cell))
(defsetf keyed-place (cell &key (scale 1)) (value)
  `(setf (car ,cell) (* ,value ,scale)))
(let ((cell (list 0)))
  (assert (= 12 (setf (keyed-place cell :scale 3) 4)))
  (assert (= 12 (car cell))))
