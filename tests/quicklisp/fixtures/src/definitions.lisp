(defpackage :fixture-utils (:use :cl) (:export :twice :*loads* :*read-value* :*file* :*sub-value*))
(in-package :fixture-utils)
(when (ffi:js-eval "return process.env.VALTAN_FIXTURE_FAIL === 'yes' ? lisp.S_t : lisp.S_nil;")
  (error "EXPECTED-FIXTURE-LOAD-FAILURE"))
(defvar *loads* 0)
(incf *loads*)
(defparameter *file* (pathname-name *load-truename*))
(assert (member :valtan *features*))
(assert (member :node *features*))
(assert (not (member :sbcl *features*)))
(defmacro twice (form &environment env)
  (declare (ignore env))
  `(let ((value ,form)) (+ value value)))
;; Test nested macro definitions closing over lexical state (as in Anaphora).
(let ((increment 3))
  (defmacro plus-three (form) `(+ ,form ,increment)))
