#-fixture-asdf-feature (error "Target source reader lost a feature announced by an ASDF definition")
(assert (member :fixture-asdf-feature *features*))
#-fixture-dependency-feature (error "Target source reader lost a dependency system's feature")
(assert (member :fixture-dependency-feature *features*))
(assert (not (member :sbcl *features*)))
(assert (= fixture-utils:*loads* 1))
(let* ((system (asdf:find-system :fixture-utils))
       (module (asdf:find-component system "src" :registered t))
       (file (asdf:find-component module "MixedCase.dat" :registered t)))
  (assert (typep system 'asdf:system))
  (assert (string= (asdf:component-version system) "1.0"))
  (assert (eq system (asdf:component-parent module))))
;; Metadata remains usable even when the test harness removes the source tree.
(let* ((system (asdf:find-system "fixture-utils"))
       (file (asdf:find-component system '("src" "MixedCase.dat"))))
  (assert file)
  (assert (eq (asdf:component-system file) system))
  (assert (string= (asdf:component-name file) "MixedCase.dat"))
  (assert (string= (pathname-name (asdf:component-pathname file)) "MixedCase"))
  (assert (equal (asdf:component-pathname file)
                 (asdf:system-relative-pathname system "src/MixedCase.dat")))
  (assert (eq file (asdf:find-component nil '("fixture-utils" "src" "MixedCase.dat"))))
  (assert (eq file (asdf:find-component system file)))
  (assert (null (asdf:find-component system '("missing" "child")))))
(assert (null (asdf:find-component nil nil)))
(assert (null (asdf:find-system "absent-from-bundle" nil)))
(assert (handler-case (progn (asdf:find-system "absent-from-bundle") nil)
          (asdf:missing-component () t)))
(assert (asdf:find-system "fixture-utils/sub"))
#-fixture-no-optional-backend (error "Target source reader did not receive project features")
(assert (member :fixture-no-optional-backend *features*))
(assert (eq cl-user::*project-feature-component* :loaded))
(assert (eq fixture-utils::*file-local-value* :outer))
(assert (eq fixture-utils::*file-local-observed* :inside))
(handler-case
    (system::load-embedded-source
     "(setf fixture-utils::*file-local-value* :failed) (error \"expected file error\")"
     "/fixture-failed.lisp" nil)
  (error ()))
(assert (eq fixture-utils::*file-local-value* :outer))
(assert (= fixture-utils:*sub-value* 84))
(assert (= (fixture-utils:twice 21) 42))
(assert (string= fixture-utils:*file* "definitions"))
(assert (= (char-code (read-from-string "#\\nul")) 0))
(assert (= (char-code (name-char :escape)) 27))
(assert (char= (name-char (char-name (code-char 0))) (code-char 0)))
(assert (equal (loop for first = t then nil repeat 3 collect first) '(t nil nil)))
(assert (equal (loop for value = 1 then nil repeat 3 collect value) '(1 nil nil)))
(write-line "QUICKLISP-FIXTURE-PASS")
