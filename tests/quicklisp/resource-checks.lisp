(let* ((data (asdf:system-relative-pathname "resource-fixture" "assets/Data.bin"))
       (text (asdf:system-relative-pathname "resource-fixture" "assets/nested/日本語.txt")))
  (assert (probe-file data))
  (assert (equal (truename data) data))
  (assert (integerp (file-write-date data)))
  (assert (null (probe-file (asdf:system-relative-pathname "resource-fixture" "assets/host-only.bin"))))
  (assert (= (length (directory (asdf:system-relative-pathname "resource-fixture" "assets/**/*.*"))) 2))
  (assert (= (length (directory (asdf:system-relative-pathname "resource-fixture" "assets/nested/"))) 1))
  (with-open-file (in data :element-type '(unsigned-byte 8))
    (assert (= (file-length in) 6))
    (assert (= (read-byte in) 0))
    (assert (file-position in 3))
    (assert (= (read-byte in) 255))
    (assert (file-position in :start))
    (let ((bytes (make-array 6 :element-type '(unsigned-byte 8))))
      (assert (= (read-sequence bytes in) 6))
      (assert (equalp bytes #(0 1 128 255 0 42)))))
  (with-open-file (in data :element-type '(signed-byte 8))
    (file-position in 2)
    (assert (= (read-byte in) -128)))
  (with-open-file (in data :element-type '(unsigned-byte 16))
    (assert (= (file-length in) 3))
    (assert (= (read-byte in) 1))
    (assert (= (read-byte in) 33023))
    (assert (= (read-byte in) 42))
    (assert (eq (read-byte in nil :eof) :eof)))
  (with-open-file (in text)
    (assert (string= (read-line in) "日本語😀"))
    (file-position in :start)
    (assert (char= (peek-char nil in) #\日))
    (assert (char= (read-char in) #\日))
    (unread-char #\日 in)
    (assert (char= (read-char in) #\日)))
  (assert (null (open data :direction :output :if-exists nil)))
  (assert (handler-case (progn (open data :direction :output :if-exists :supersede) nil)
            (file-error () t)))
  (assert (handler-case (progn (delete-file data) nil) (file-error () t)))
  (assert (handler-case (progn (rename-file data "renamed.bin") nil) (file-error () t)))
  (with-open-file (one data :element-type '(unsigned-byte 8))
    (read-byte one)
    (with-open-file (two data :element-type '(unsigned-byte 8))
      (assert (= (read-byte two) 0)))
    (assert (= (read-byte one) 1))))
(write-line "EMBEDDED-RESOURCES-PASS")
