(in-package :cl-user)
(defparameter *portability-checks* 0)
(defmacro portability-check (form)
  `(progn (incf *portability-checks*) (assert ,form () "Portability check failed: ~S" ',form)))

(portability-check (equal (uiop:split-string "a:b::c" :separator ":") '("a" "b" "" "c")))
(portability-check (string= (uiop:strcat "a" "b" "c") "abc"))
(portability-check (uiop:string-prefix-p "pre" "prefix"))
(portability-check (uiop:string-suffix-p "prefix" "fix"))
(portability-check (uiop:string-enclosed-p "[" "[x]" "]"))
(portability-check (equal (uiop:ensure-list :x) '(:x)))
(portability-check (uiop:emptyp ""))
(portability-check (equal (uiop:remove-plist-keys '(:a :c) '(:a 1 :b 2 :c 3)) '(:b 2)))
(portability-check (equal (uiop:parse-version "1.2.30") '(1 2 30)))
(portability-check (string= (uiop:unparse-version '(1 2 30)) "1.2.30"))
(portability-check (uiop:version< "1.2.9" "1.2.10"))
(portability-check (uiop:version<= "1.2" "1.2"))
(portability-check (uiop:version= "1.2.0" "1.2.0"))
(portability-check (uiop:featurep '(:and :valtan (:not :sbcl))))
(portability-check (eq (uiop:implementation-type) :valtan))
(portability-check (not (eq (not (null (member :little-endian *features*)))
                          (not (null (member :big-endian *features*))))))
(uiop:define-package :valtan-uiop-export-test (:use :cl) (:export :entry))
(uiop:define-package :valtan-uiop-reexport-test (:use :cl) (:use-reexport :valtan-uiop-export-test))
(portability-check (eq (find-symbol "ENTRY" :valtan-uiop-export-test)
                       (find-symbol "ENTRY" :valtan-uiop-reexport-test)))
(portability-check (eq (nth-value 1 (find-symbol "ENTRY" :valtan-uiop-reexport-test)) :external))
(uiop:define-package :valtan-uiop-local-test (:use :cl)
  (:local-nicknames (:lib :valtan-uiop-export-test)))
(let ((*package* (find-package :valtan-uiop-local-test)))
  (portability-check (eq (find-package :lib) (find-package :valtan-uiop-export-test)))
  (portability-check (eq (read-from-string "lib:entry") (find-symbol "ENTRY" :valtan-uiop-export-test))))
(uiop:define-package :valtan-uiop-local-test (:use :cl))
(let ((*package* (find-package :valtan-uiop-local-test)))
  (portability-check (null (find-package :lib))))
(portability-check (uiop:directory-pathname-p (uiop:ensure-directory-pathname "abc")))
(portability-check (equal (pathname-directory (uiop:parse-unix-namestring "a/b.txt")) '(:relative "a")))
(portability-check (string= (uiop:unix-namestring (uiop:subpathname #p"/tmp/a/" "b/c" :type "txt")) "/tmp/a/b/c.txt"))
(portability-check (string= (namestring (uiop:pathname-parent-directory-pathname #p"/a/b/c.txt")) "/a/"))
(portability-check (uiop:absolute-pathname-p #p"/a/b"))
(portability-check (uiop:relative-pathname-p #p"a/b"))
(portability-check (uiop:subpathp #p"/a/b/c.txt" #p"/a/"))
(portability-check (equal (uiop:safe-read-from-string "(1 2 3)") '(1 2 3)))
(portability-check (handler-case (uiop:safe-read-from-string "#.(error \"must not execute\")")
                      (reader-error () t) (:no-error (&rest values) (declare (ignore values)) nil)))
(portability-check (equal (with-input-from-string (s (format nil "one~%two~%")) (uiop:slurp-stream-lines s)) '("one" "two")))
(portability-check (equal (with-input-from-string (s "(a b) 42") (uiop:slurp-stream-forms s)) '((a b) 42)))
(portability-check (string= (with-input-from-string (s "hello")
                            (with-output-to-string (out) (uiop:copy-stream-to-stream s out))) "hello"))

#+node
(progn
  (let ((name "VALTAN_PORTABILITY_TEST_VARIABLE"))
    (unwind-protect
         (progn
           (setf (uiop:getenv name) "value")
           (portability-check (string= (uiop:getenv name) "value"))
           (setf (uiop:getenv name) "")
           (portability-check (string= (uiop:getenv name) ""))
           (portability-check (null (uiop:getenvp name))))
      (setf (uiop:getenv name) nil))
    (portability-check (null (uiop:getenv name))))
  (portability-check (uiop:directory-pathname-p (uiop:getcwd)))
  (let* ((dir (uiop:subpathname (uiop:temporary-directory)
                               (format nil "valtan-uiop-~A-~D/" (get-universal-time) (random 100000000))))
         (file (uiop:subpathname dir "nested/input.txt"))
         (copy (uiop:subpathname dir "copy.txt"))
         (old-cwd (uiop:getcwd)))
    (unwind-protect
         (progn
           (ensure-directories-exist file)
           (uiop:with-output-file (s file :if-exists :supersede)
             (write-string (format nil "日本語 😀~%second~%") s))
           (portability-check (uiop:file-exists-p file))
           (portability-check (uiop:directory-exists-p dir))
           (portability-check (equal (uiop:read-file-lines file) '("日本語 😀" "second")))
           (uiop:copy-file file copy)
           (portability-check (string= (uiop:read-file-string file) (uiop:read-file-string copy)))
           (portability-check (= (length (uiop:directory-files dir)) 1))
           (portability-check (= (length (uiop:subdirectories dir)) 1))
           (uiop:chdir dir)
           (portability-check (uiop:pathname-equal (uiop:getcwd) (truename dir)))
           (uiop:chdir old-cwd)
           (portability-check (handler-case (uiop:delete-directory-tree dir) (error () t)))
           (uiop:delete-directory-tree dir :validate t)
           (portability-check (not (probe-file dir))))
      (uiop:chdir old-cwd)
      (when (probe-file dir) (uiop:delete-directory-tree dir :validate t))))
  (let ((saved nil))
    (uiop:with-temporary-file (:stream s :pathname p)
      (setf saved p)
      (write-string "temp" s)
      (finish-output s)
      (portability-check (string= (uiop:read-file-string p) "temp")))
    (portability-check (not (probe-file saved)))))
(format t "PORTABILITY-SUITE uiop passed ~D~%" *portability-checks*)
