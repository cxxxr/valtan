(defsystem "mcclim-portability"
  :depends-on ("clim-core/system")
  ;; The browser loads the lower-level CLIM systems, bypassing mcclim.asd's
  ;; feature announcement. This adapter still uses the McCLIM implementation.
  :target-features (:mcclim)
  :components ((:file "environment")))

(defsystem "mcclim-portability/image-support"
  :depends-on ("closer-mop")
  :components ((:file "image-support")))

(defsystem "mcclim-portability/drei"
  :depends-on ("mcclim-portability" "mcclim-portability/image-support" "drei-mcclim"
               "valtan-drei-source")
  :components ((:file "drei-image")))
