#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(defstruct (pathname (:constructor %make-pathname) (:predicate pathnamep))
  host device directory name type version)

(defvar *default-pathname-defaults* (%make-pathname))

(defun pathname (pathspec)
  (cond ((pathnamep pathspec) pathspec)
        ((file-stream-p pathspec) (file-stream-pathname pathspec))
        ((synonym-stream-p pathspec) (pathname (synonym-stream-target pathspec)))
        ((stringp pathspec) (values (parse-namestring pathspec)))
        (t (type-error pathspec '(or pathname string)))))

(defun parse-namestring (thing &optional host (defaults *default-pathname-defaults*)
                              &key (start 0) end junk-allowed)
  (declare (ignore defaults junk-allowed))
  (when (pathnamep thing) (return-from parse-namestring (values thing start)))
  (unless (stringp thing) (type-error thing '(or string pathname)))
  (unless end (setq end (length thing)))
  (unless (and (integerp start) (integerp end) (<= 0 start end (length thing)))
    (error 'parse-error))
  (let ((parts nil) (from start) (directory nil) (file nil))
    (do ((i start (1+ i))) ((= i end))
      (when (char= (char thing i) #\/)
        (unless (= from i) (push (subseq thing from i) parts))
        (setq from (1+ i))))
    (when (> from start)
      (setq directory
            (cons (if (char= (char thing start) #\/) :absolute :relative)
                  (mapcar (lambda (part)
                            (cond ((string= part "*") :wild)
                                  ((string= part "**") :wild-inferiors)
                                  ((string= part "..") :up)
                                  (t part)))
                          (nreverse parts)))))
    (unless (= from end) (setq file (subseq thing from end)))
    (let* ((dot (and file (position #\. file :from-end t)))
           (name (and file (if (and dot (> dot 0)) (subseq file 0 dot) file)))
           (type (and dot (> dot 0) (subseq file (1+ dot)))))
      (values (%make-pathname :host host :directory directory :version (and file :newest)
                              :name (if (and name (string= name "*")) :wild name)
                              :type (if (and type (string= type "*")) :wild type))
              end))))

(defun make-pathname (&key (host nil host-p) (device nil device-p)
                          (directory nil directory-p) (name nil name-p)
                          (type nil type-p) (version nil version-p)
                          (defaults *default-pathname-defaults*) (case :local))
  (declare (ignore case))
  (let ((defaults (pathname defaults)))
    (%make-pathname :host (if host-p host (pathname-host defaults))
                    :device (if device-p device (pathname-device defaults))
                    :directory (if directory-p
                                   (if (stringp directory) (list :absolute directory) directory)
                                   (pathname-directory defaults))
                    :name (if name-p name (pathname-name defaults))
                    :type (if type-p type (pathname-type defaults))
                    :version (if version-p version (pathname-version defaults)))))

(defun file-namestring (pathspec)
  (let ((path (pathname pathspec)))
    (with-output-to-string (out)
      (let ((name (pathname-name path)) (type (pathname-type path)))
        (when (and name (not (eq name :unspecific)))
          (write-string (if (eq name :wild) "*" name) out))
        (when (and type (not (eq type :unspecific)))
          (write-char #\. out)
          (write-string (if (eq type :wild) "*" type) out))))))

(defun directory-namestring (pathspec)
  (let ((directory (pathname-directory (pathname pathspec))))
    (with-output-to-string (out)
      (when (consp directory)
        (when (eq (car directory) :absolute) (write-char #\/ out))
        (dolist (part (cdr directory))
          (write-string (case part (:wild "*") (:wild-inferiors "**")
                              ((:up :back) "..") (otherwise part)) out)
          (write-char #\/ out))))))

(defun namestring (pathspec)
  (concatenate 'string (directory-namestring pathspec) (file-namestring pathspec)))

(defun host-namestring (pathspec)
  (let ((host (pathname-host (pathname pathspec))))
    (if (stringp host) host "")))

(defun merge-pathnames (pathspec &optional (defaults *default-pathname-defaults*) (default-version :newest))
  (let* ((path (pathname pathspec)) (defaults (pathname defaults))
         (directory (pathname-directory path)))
    (when (and (consp directory) (eq (car directory) :relative))
      (setq directory (append (or (pathname-directory defaults) '(:relative)) (cdr directory))))
    (when (consp directory)
      (let ((result (list (car directory))))
        (dolist (part (cdr directory))
          (if (and (member part '(:up :back)) (cdr result) (stringp (car result)))
              (pop result) (push part result)))
        (setq directory (nreverse result))))
    (%make-pathname :host (or (pathname-host path) (pathname-host defaults))
                    :device (or (pathname-device path) (pathname-device defaults))
                    :directory (or directory (pathname-directory defaults))
                    :name (or (pathname-name path) (pathname-name defaults))
                    :type (or (pathname-type path) (pathname-type defaults))
                    :version (or (pathname-version path)
                                 (and (null (pathname-name path)) (pathname-version defaults))
                                 default-version))))
(defun enough-namestring (pathspec &optional (defaults *default-pathname-defaults*))
  (let ((text (namestring pathspec)) (prefix (directory-namestring defaults)))
    (if (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix)))
        (subseq text (length prefix)) text)))
(defun wild-pathname-p (pathspec &optional field-key)
  (let ((path (pathname pathspec)))
    (labels ((wild (x)
               (cond ((member x '(:wild :wild-inferiors)) t)
                     ((stringp x) (not (null (or (find #\* x) (find #\? x)))))
                     ((consp x) (some #'wild x)))))
      (if field-key
          (wild (case field-key (:host (pathname-host path)) (:device (pathname-device path))
                                (:directory (pathname-directory path)) (:name (pathname-name path))
                                (:type (pathname-type path)) (:version (pathname-version path))
                                (otherwise (type-error field-key '(member :host :device :directory :name :type :version)))))
          (some #'wild (list (pathname-host path) (pathname-device path) (pathname-directory path)
                            (pathname-name path) (pathname-type path) (pathname-version path)))))))

#+(and valtan node)
(setq *default-pathname-defaults* (parse-namestring (ffi:js->cl (*:file-op :cwd))))
