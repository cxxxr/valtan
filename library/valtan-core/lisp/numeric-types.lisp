(in-package :common-lisp)

;; Numeric sets are unions of intervals in three disjoint domains. Integers
;; and finite binary64 ranks are discrete; nonintegral rationals are dense.
;; An interval is (domain lower lower-open upper upper-open), with NIL bounds
;; denoting infinity. Float ranks distinguish EQL's two signed zeros.
(defun numeric-interval (domain lo lo-open hi hi-open)
  (cond ((eq domain 'ratio)
         (when lo (setq lo (rational lo) lo-open (or lo-open (integerp lo))))
         (when hi (setq hi (rational hi) hi-open (or hi-open (integerp hi)))))
        (t
         (when lo (setq lo (if lo-open (1+ (floor lo)) (ceiling lo))))
         (when hi (setq hi (if hi-open (1- (ceiling hi)) (floor hi))))
         (setq lo-open nil hi-open nil)))
  (unless (and lo hi (or (> lo hi) (and (= lo hi) (or lo-open hi-open))))
    (list domain lo lo-open hi hi-open)))

(defun numeric-interval-intersection (a b)
  (when (eq (first a) (first b))
    (let ((lo (second a)) (lo-open (third a)) (hi (fourth a)) (hi-open (fifth a))
          (blo (second b)) (bhi (fourth b)))
      (cond ((or (null lo) (and blo (> blo lo))) (setq lo blo lo-open (third b)))
            ((and blo (= blo lo)) (setq lo-open (or lo-open (third b)))))
      (cond ((or (null hi) (and bhi (< bhi hi))) (setq hi bhi hi-open (fifth b)))
            ((and bhi (= bhi hi)) (setq hi-open (or hi-open (fifth b)))))
      (numeric-interval (first a) lo lo-open hi hi-open))))

(defun numeric-interval-difference (a b)
  (let ((intersection (numeric-interval-intersection a b)))
    (if (null intersection)
        (list a)
        (remove nil
                (list (when (second intersection)
                        (numeric-interval (first a) (second a) (third a)
                                          (second intersection) (not (third intersection))))
                      (when (fourth intersection)
                        (numeric-interval (first a) (fourth intersection) (not (fifth intersection))
                                          (fourth a) (fifth a))))))))

(defun numeric-sets-intersection (a b)
  (let ((result nil))
    (dolist (x a)
      (dolist (y b)
        (let ((intersection (numeric-interval-intersection x y)))
          (when intersection (push intersection result)))))
    result))

(defun numeric-type-intervals (type)
  (unless (or (symbolp type) (consp type))
    (return-from numeric-type-intervals (values nil nil)))
  (setq type (expand-deftype type))
  (let* ((name (if (consp type) (car type) type))
         (args (if (consp type) (cdr type) nil)))
    (when (null type) (return-from numeric-type-intervals (values nil t)))
    (multiple-value-bind (lo hi integerp) (integer-type-bounds type)
      (when integerp
        (return-from numeric-type-intervals
          (values (remove nil (list (numeric-interval 'integer lo nil hi nil))) t))))
    (case name
      (bignum
       (values (list (numeric-interval 'integer nil nil (1- most-negative-fixnum) nil)
                     (numeric-interval 'integer (1+ most-positive-fixnum) nil nil nil)) t))
      (mod
       (values (remove nil (list (numeric-interval 'integer 0 nil (1- (first args)) nil))) t))
      ((real rational ratio float short-float single-float double-float long-float)
       (let* ((lo (first args)) (hi (second args))
              (lo-open (consp lo)) (hi-open (consp hi)) (intervals nil))
         (when lo-open (setq lo (car lo)))
         (when hi-open (setq hi (car hi)))
         (when (eq lo '*) (setq lo nil))
         (when (eq hi '*) (setq hi nil))
         (when (member name '(real rational))
           (push (numeric-interval 'integer lo lo-open hi hi-open) intervals))
         (when (member name '(real rational ratio))
           (push (numeric-interval 'ratio lo lo-open hi hi-open) intervals))
         (when (member name '(real float short-float single-float double-float long-float))
           (push (numeric-interval 'float
                                   (system:float-rank lo (if lo-open 2 1)) nil
                                   (system:float-rank hi (if hi-open 4 3)) nil) intervals))
         (values (remove nil intervals) t)))
      ((member eql)
       (let ((intervals nil))
         (dolist (value args)
           (unless (realp value) (return-from numeric-type-intervals (values nil nil)))
           (push (cond ((integerp value) (numeric-interval 'integer value nil value nil))
                       ((floatp value)
                        (let ((rank (system:float-rank value 0)))
                          (numeric-interval 'float rank nil rank nil)))
                       (t (numeric-interval 'ratio value nil value nil))) intervals))
         (values intervals t)))
      ((or and)
       (let ((result nil) (firstp t))
         ;; (AND) denotes T, which includes nonnumeric objects.
         (when (and (eq name 'and) (null args))
           (return-from numeric-type-intervals (values nil nil)))
         (dolist (arg args)
           (multiple-value-bind (intervals known) (numeric-type-intervals arg)
             (unless known (return-from numeric-type-intervals (values nil nil)))
             (setq result (if (eq name 'or) (append result intervals)
                              (if firstp intervals (numeric-sets-intersection result intervals))))
             (setq firstp nil)))
         (values result t)))
      (otherwise (values nil nil)))))

(defun numeric-subtypep (type1 type2)
  (multiple-value-bind (left known-left) (numeric-type-intervals type1)
    (unless known-left (return-from numeric-subtypep (values nil nil)))
    (when (or (null left) (member type2 '(t number)))
      (return-from numeric-subtypep (values t t)))
    (multiple-value-bind (right known-right) (numeric-type-intervals type2)
      (unless known-right (return-from numeric-subtypep (values nil nil)))
      (dolist (interval right)
        (setq left (mapcan (lambda (part) (numeric-interval-difference part interval)) left)))
      (values (null left) t))))
