#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(macrolet ((def (name op initial-value)
             `(defun ,name (&rest numbers)
                (let ((acc ,initial-value))
                  (dolist (n numbers)
                    (unless (numberp n)
                      (type-error n 'number))
                    (setq acc (,op acc n)))
                  acc))))
  (def + *:%add 0)
  (def * *:%mul 1))

(defun - (number &rest numbers)
  (unless (numberp number)
    (type-error number 'number))
  (if (null numbers)
      (*:%negate number)
      (dolist (n numbers number)
        (unless (numberp n)
          (type-error n 'number))
        (setq number (*:%sub number n)))))

(defun / (number &rest numbers)
  (unless (numberp number)
    (type-error number 'number))
  (if (null numbers)
      (/ 1 number)
      (dolist (n numbers number)
        (unless (numberp n)
          (type-error n 'number))
        (setq number (*:%div number n)))))

(defun logand (&rest integers)
  (let ((result -1))
    (dolist (i integers)
      (unless (integerp i)
        (type-error i 'integer))
      (setq result (*:%logand result i)))
    result))

(macrolet ((def (name cmp)
             (let ((predicate (if (eq name '=) 'numberp 'realp))
                   (type (if (eq name '=) 'number 'real)))
             `(defun ,name (number &rest numbers)
                (unless (,predicate number)
                  (type-error number ',type))
                (dolist (n numbers t)
                  (unless (,predicate n)
                    (type-error n ',type))
                  (unless (,cmp number n)
                    (return nil))
                  (setq number n))))))
  (def = *:%=)
  (def > *:%>)
  (def < *:%<)
  (def >= *:%>=)
  (def <= *:%<=))

(defun /= (number &rest numbers)
  (unless (numberp number) (type-error number 'number))
  (dolist (n numbers)
    (unless (numberp n) (type-error n 'number)))
  (do ((tail (cons number numbers) (cdr tail)))
      ((null tail) t)
    (dolist (other (cdr tail))
      (when (= (car tail) other) (return-from /= nil)))))

(defun conjugate (number)
  (unless (numberp number) (type-error number 'number))
  (if (cl:complexp number) (cl:complex (cl:realpart number) (- (cl:imagpart number))) number))

(defun rem (number divisor)
  (unless (numberp number)
    (type-error number 'number))
  (unless (numberp divisor)
    (type-error divisor 'number))
  (*:%rem number divisor))

(defun mod (number divisor)
  (nth-value 1 (floor number divisor)))

(defun floor (number &optional (divisor 1))
  (unless (numberp number)
    (type-error number 'number))
  (unless (numberp divisor)
    (type-error divisor 'number))
  (*:%floor number divisor))

(defun round (number &optional (divisor 1))
  (unless (numberp number)
    (type-error number 'number))
  (unless (numberp divisor)
    (type-error divisor 'number))
  (*:%round number divisor))

(defun truncate (number &optional (divisor 1))
  (unless (numberp number)
    (type-error number 'number))
  (unless (numberp divisor)
    (type-error divisor 'number))
  (*:%truncate number divisor))

(defun ceiling (number &optional (divisor 1))
  (unless (numberp number)
    (type-error number 'number))
  (unless (numberp divisor)
    (type-error divisor 'number))
  (*:%ceiling number divisor))

(defun floatp (x)
  (*:floatp x))

(defun realp (x)
  (and (numberp x)
       (not (cl:complexp x))))

(defun rationalp (x)
  (*:rationalp x))

(defun plusp (x)
  (< 0 x))

(defun minusp (x)
  (< x 0))

(defun 1+ (x)
  (+ x 1))

(defun 1- (x)
  (- x 1))

(defun zerop (x)
  (= x 0))

(defun evenp (x)
  (= 0 (rem x 2)))

(defun oddp (x)
  (not (evenp x)))

(defun min (number &rest more-numbers)
  (dolist (n more-numbers number)
    (when (< n number)
      (setq number n))))

(defun max (number &rest more-numbers)
  (dolist (n more-numbers number)
    (when (< number n)
      (setq number n))))

(defun expt (base power)
  (unless (numberp base) (type-error base 'number))
  (unless (numberp power) (type-error power 'number))
  (unless (integerp power)
    (return-from expt
      (cond ((zerop power) (if (or (cl:complexp base) (cl:complexp power)) (cl:complex 1.0 0.0) 1.0))
            ((and (zerop base) (realp power) (plusp power)) (* base power))
            (t (cl:exp (* power (cl:log base)))))))
  (let ((acc (cond ((floatp base) (cl:float 1 base))
                   ((and (cl:complexp base) (floatp (cl:realpart base))) (cl:complex 1.0 0.0))
                   (t 1)))
        (factor base)
        (exponent (cl:abs power)))
    (do () ((zerop exponent))
      (when (oddp exponent) (setq acc (* acc factor)))
      (setq exponent (cl:ash exponent -1))
      (unless (zerop exponent) (setq factor (* factor factor))))
    (if (minusp power) (/ acc) acc)))

(defstruct (random-state (:constructor %make-random-state))
  seed)

(defvar *random-state*
  (%make-random-state :seed (system:random most-positive-fixnum)))

(defun make-random-state (&optional state)
  (cond ((null state) (%make-random-state :seed (random-state-seed *random-state*)))
        ((eq state t) (%make-random-state :seed (system:random most-positive-fixnum)))
        ((random-state-p state) (%make-random-state :seed (random-state-seed state)))
        (t (type-error state '(or random-state boolean)))))

(defun random-bits (bits state)
  ;; A full-period 64-bit LCG; use its high bits for small requests.
  (let ((result 0))
    (do () ((zerop bits) result)
      (let ((take (min bits 64)))
        (setf (random-state-seed state)
              (mod (+ (* (random-state-seed state) 6364136223846793005)
                      1442695040888963407)
                   18446744073709551616))
        (setq result (+ (ash result take)
                        (ash (random-state-seed state) (- take 64))))
        (decf bits take)))))

(defun random (limit &optional (state *random-state*))
  (unless (random-state-p state) (type-error state 'random-state))
  (unless (and (realp limit) (> limit 0))
    (type-error limit '(or (integer 1 *) (cl:float (0) *))))
  (if (integerp limit)
      (let ((bits (integer-length (1- limit))))
        (do ((value (random-bits bits state) (random-bits bits state)))
            ((< value limit) value)))
      (do ((value (* limit (/ (random-bits 53 state) 9007199254740992))
                  (* limit (/ (random-bits 53 state) 9007199254740992))))
          ((< value limit) value))))

(defun ffloor (number &optional (divisor 1))
  (multiple-value-bind (q r) (floor number divisor) (values (cl:float q) r)))
(defun fceiling (number &optional (divisor 1))
  (multiple-value-bind (q r) (ceiling number divisor) (values (cl:float q) r)))
(defun ftruncate (number &optional (divisor 1))
  (multiple-value-bind (q r) (truncate number divisor) (values (cl:float q) r)))
(defun fround (number &optional (divisor 1))
  (multiple-value-bind (q r) (round number divisor) (values (cl:float q) r)))

(defun lognot (integer)
  (unless (integerp integer) (type-error integer 'integer))
  (- -1 integer))
(defun logior (&rest integers)
  (let ((result -1))
    (dolist (n integers) (setq result (logand result (lognot n))))
    (lognot result)))
(defun logxor (&rest integers)
  (let ((result 0))
    (dolist (n integers result)
      (setq result (logand (logior result n) (lognot (logand result n)))))))
(defun logeqv (&rest integers)
  (let ((result -1))
    (dolist (n integers result) (setq result (lognot (logxor result n))))))
(defun lognand (x y) (lognot (logand x y)))
(defun lognor (x y) (lognot (logior x y)))
(defun logandc1 (x y) (logand (lognot x) y))
(defun logandc2 (x y) (logand x (lognot y)))
(defun logorc1 (x y) (logior (lognot x) y))
(defun logorc2 (x y) (logior x (lognot y)))
(defun logtest (x y) (not (zerop (logand x y))))
(defun logbitp (index integer)
  (unless (and (integerp index) (>= index 0)) (type-error index '(integer 0 *)))
  (unless (integerp integer) (type-error integer 'integer))
  (oddp (cl:ash integer (- index))))
(defun logcount (integer)
  (unless (integerp integer) (type-error integer 'integer))
  (let ((value (if (minusp integer) (lognot integer) integer)) (count 0))
    (do () ((zerop value) count)
      (setq value (logand value (1- value)))
      (incf count))))
(defun boole (op x y)
  (unless (and (integerp op) (<= 0 op 15)) (type-error op '(integer 0 15)))
  (unless (integerp x) (type-error x 'integer))
  (unless (integerp y) (type-error y 'integer))
  (logior (if (logbitp 0 op) (lognor x y) 0)
          (if (logbitp 1 op) (logandc2 x y) 0)
          (if (logbitp 2 op) (logandc1 x y) 0)
          (if (logbitp 3 op) (logand x y) 0)))
(defun gcd (&rest integers)
  (let ((result 0))
    (dolist (n integers result)
      (unless (integerp n) (type-error n 'integer))
      (setq n (cl:abs n))
      (do () ((zerop n)) (psetq result n n (rem result n))))))
(defun lcm (&rest integers)
  (let ((result 1))
    (dolist (n integers result)
      (unless (integerp n) (type-error n 'integer))
      (setq result (if (or (zerop result) (zerop n)) 0
                      (cl:abs (* (/ result (gcd result n)) n)))))))

(defstruct (byte-specifier (:constructor %make-byte-specifier (size position))
                           (:conc-name byte-) (:copier nil))
  size position)
(defun byte (size position)
  (unless (and (integerp size) (>= size 0)) (type-error size '(integer 0 *)))
  (unless (and (integerp position) (>= position 0)) (type-error position '(integer 0 *)))
  (%make-byte-specifier size position))
(defun byte-mask (bytespec)
  (ash (1- (ash 1 (byte-size bytespec))) (byte-position bytespec)))
(defun ldb (bytespec integer)
  (unless (integerp integer) (type-error integer 'integer))
  (logand (1- (ash 1 (byte-size bytespec))) (ash integer (- (byte-position bytespec)))))
(defun ldb-test (bytespec integer) (not (zerop (ldb bytespec integer))))
(defun mask-field (bytespec integer)
  (unless (integerp integer) (type-error integer 'integer))
  (logand (byte-mask bytespec) integer))
(defun deposit-field (newbyte bytespec integer)
  (unless (integerp newbyte) (type-error newbyte 'integer))
  (unless (integerp integer) (type-error integer 'integer))
  (let ((mask (byte-mask bytespec)))
    (logior (logand newbyte mask) (logand integer (lognot mask)))))
(defun dpb (newbyte bytespec integer)
  (unless (integerp newbyte) (type-error newbyte 'integer))
  (deposit-field (ash newbyte (byte-position bytespec)) bytespec integer))

(define-setf-expander ldb (bytespec place cl:&environment environment)
  (cl:multiple-value-bind (vars forms stores setter accessor) (!get-setf-expansion place environment)
    (let ((spec (cl:gensym)) (new (cl:gensym)))
      (cl:values (cl:cons spec vars) (cl:cons bytespec forms) (cl:list new)
                 `(let ((,(cl:car stores) (dpb ,new ,spec ,accessor)) ,@(cl:cdr stores))
                    ,setter ,new)
                 `(ldb ,spec ,accessor)))))
(define-setf-expander mask-field (bytespec place cl:&environment environment)
  (cl:multiple-value-bind (vars forms stores setter accessor) (!get-setf-expansion place environment)
    (let ((spec (cl:gensym)) (new (cl:gensym)))
      (cl:values (cl:cons spec vars) (cl:cons bytespec forms) (cl:list new)
                 `(let ((,(cl:car stores) (deposit-field ,new ,spec ,accessor)) ,@(cl:cdr stores))
                    ,setter ,new)
                 `(mask-field ,spec ,accessor)))))

(defun isqrt (integer)
  (unless (and (integerp integer) (>= integer 0)) (type-error integer '(integer 0 *)))
  (if (< integer 2) integer
      (let ((estimate (ash 1 (ceiling (integer-length integer) 2))))
        (do () (nil)
          (let ((next (floor (+ estimate (floor integer estimate)) 2)))
            (when (>= next estimate) (return estimate))
            (setq estimate next))))))

(defun signum (number)
  (unless (numberp number) (type-error number 'number))
  (if (zerop number) number (/ number (cl:abs number))))
