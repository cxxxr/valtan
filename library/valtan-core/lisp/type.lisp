#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun parse-deftype-lambda-list (lambda-list)
    (let ((state nil))
      (mapcar (lambda (x)
                (cond ((eq x '&optional)
                       (setq state :optional)
                       x)
                      ((eq x '&key)
                       (setq state :key)
                       x)
                      ((member x lambda-list-keywords)
                       (setq state nil)
                       x)
                      ((member state '(:optional :key))
                       (if (symbolp x)
                           (list x ''*)
                           x))
                      (t
                       x)))
              lambda-list))))

(defmacro deftype (name lambda-list &body body)
  (setq lambda-list (parse-deftype-lambda-list lambda-list))
  `(progn
     (setf (deftype-expander ',name)
           (lambda ,lambda-list ,@body))
     ',name))

(defun deftype-expander (symbol)
  (get symbol 'deftype-expander))

(defun (cl:setf deftype-expander) (expander symbol)
  (cl:setf (cl:get symbol 'deftype-expander) expander))

(defun expand-deftype (type)
  (do ()
      (nil)
    (let ((name (if (consp type) (car type) type))
          (args (if (consp type) (cdr type) nil)))
      (let ((expander (deftype-expander name)))
        (if expander
            (setq type (apply expander args))
            (return type))))))

(defun canonicalize-type (type)
  (setq type (expand-deftype type))
  (let ((name (if (consp type) (car type) type))
        (args (if (consp type) (cdr type) nil)))
    (case name
      ((array simple-array vector simple-vector bit-vector simple-bit-vector)
       (list 'array
             (if (member (car args) '(* nil))
                 t
                 (car args))))
      ((string simple-string base-string simple-base-string)
       '(array character))
      (otherwise
       type))))

(defun coerce (object result-type)
  (let* ((type (expand-deftype result-type))
         (name (if (consp type) (car type) type))
         (result
           (cond ((typep object type) object)
                 ((member name '(list cons null vector simple-vector
                                 string simple-string base-string simple-base-string
                                 bit-vector simple-bit-vector array simple-array))
                  (map type #'identity object))
                 ((eq name 'character)
                  (let ((string (if (symbolp object) (symbol-name object) object)))
                    (if (and (stringp string) (= (length string) 1))
                        (char string 0)
                        (type-error object result-type))))
                 ((member name '(float short-float single-float double-float long-float))
                  (unless (realp object) (type-error object 'real))
                  (*:make-float object))
                 ((eq name 'complex)
                  (unless (numberp object) (type-error object 'number))
                  (if (and (consp type) (cdr type) (not (eq (second type) '*)))
                      (complex (coerce (realpart object) (second type))
                               (coerce (imagpart object) (second type)))
                      (complex object)))
                 ((eq name 'function)
                  (if (symbolp object)
                      (fdefinition object)
                      (eval (list 'function object))))
                 (t (type-error object result-type)))))
    (unless (typep result result-type) (type-error object result-type))
    result))

(defun numeric-type-bounds-p (object bounds)
  (destructuring-bind (&optional (low '*) (high '*)) bounds
    (and (or (eq low '*)
             (if (consp low) (> object (car low)) (>= object low)))
         (or (eq high '*)
             (if (consp high) (< object (car high)) (<= object high))))))

(defun array-type-dimensions-p (object dimensions)
  (cond ((eq dimensions '*) t)
        ((integerp dimensions) (= (array-rank object) dimensions))
        ((listp dimensions)
         (and (= (length dimensions) (array-rank object))
              (every (lambda (expected actual) (or (eq expected '*) (= expected actual)))
                     dimensions (array-dimensions object))))))

(defun array-type-specifier-p (object type)
  (let* ((name (car type))
         (array-type (member name '(array simple-array)))
         (element-type (cond ((member name '(simple-vector)) t)
                             ((member name '(string simple-string base-string simple-base-string)) 'character)
                             ((member name '(bit-vector simple-bit-vector)) 'bit)
                             ((cdr type) (second type))
                             (t '*)))
         (dimensions (cond (array-type (if (cddr type) (third type) '*))
                           ((eq name 'vector) (list (if (cddr type) (third type) '*)))
                           (t (list (if (cdr type) (second type) '*))))))
    (and (typep object name)
         (or (eq element-type '*)
             (equal (array-element-type object) (upgraded-array-element-type element-type)))
         (array-type-dimensions-p object dimensions))))

(defun typep (object type &optional environment)
  (declare (ignore environment))
  (when (and (*:structure-p type) (eq (*:%structure-name type) 'standard-instance))
    (return-from typep (subclassp (class-of object) type)))
  ;; Compiler IR and other native structures use this exact-name case often.
  (when (and (*:structure-p object) (eq (*:%structure-name object) type))
    (return-from typep t))
  (case type
    (standard-instance (and (*:structure-p object) (eq (*:%structure-name object) 'standard-instance)))
    (standard-object
     (or (and (*:structure-p object) (eq (*:%structure-name object) 'standard-instance))
         (typep object 'generic-function)))
    ((nil) nil)
    (boolean (or (eq object nil) (eq object t)))
    (null (null object))
    (list (listp object))
    (cons (consp object))
    (atom (atom object))
    (symbol (symbolp object))
    (keyword (keywordp object))
    (string (cl:stringp object))
    (simple-string (simple-string-p object))
    (base-string (cl:stringp object))
    (simple-base-string (simple-string-p object))
    (character (characterp object))
    (base-char (characterp object))
    (standard-char (and (characterp object)
                        (standard-char-p object)))
    (hash-table (and (*:structure-p object)
                     (eq (*:%structure-name object) 'hash-table)))
    ;; Use direct structure checks to avoid circular dependency with defstruct predicates
    (vector (and (*:structure-p object)
                 (eq (*:%structure-name object) 'array)
                 (= 1 (array-rank object))))
    (simple-vector (and (*:structure-p object)
                        (eq (*:%structure-name object) 'array)
                        (= 1 (array-rank object))
                        (eq (array-element-type object) t)
                        (not (array-fill-pointer object))
                        (not (array-displaced-to object))))
    (array (and (*:structure-p object)
                (eq (*:%structure-name object) 'array)))
    (simple-array (and (*:structure-p object)
                       (eq (*:%structure-name object) 'array)
                       (not (array-fill-pointer object))
                       (not (array-displaced-to object))))
    (bit-vector (and (*:structure-p object)
                     (eq (*:%structure-name object) 'array)
                     (= 1 (array-rank object))
                     (eq (array-element-type object) 'bit)))
    (simple-bit-vector (and (*:structure-p object)
                            (eq (*:%structure-name object) 'array)
                            (= 1 (array-rank object))
                            (eq (array-element-type object) 'bit)
                            (not (array-fill-pointer object))
                            (not (array-displaced-to object))))
    (integer (integerp object))
    (bit (and (integerp object) (<= 0 object 1)))
    (signed-byte (integerp object))
    (unsigned-byte (and (integerp object) (>= object 0)))
    (ratio (and (rationalp object) (not (integerp object))))
    (fixnum (and (integerp object) (<= most-negative-fixnum object most-positive-fixnum)))
    (bignum (and (integerp object) (not (<= most-negative-fixnum object most-positive-fixnum))))
    (number (numberp object))
    (complex (complexp object))
    (real (realp object))
    (rational (rationalp object))
    ((float short-float single-float double-float long-float) (floatp object))
    (function (functionp object))
    (compiled-function (functionp object))
    ((generic-function standard-generic-function)
     (and (functionp object) (boundp '*generic-function-objects*)
          (not (null (gethash object *generic-function-objects*)))))
    (sequence (or (listp object) (vectorp object)))
    (stream (streamp object))
    (string-stream (or (string-input-stream-p object) (string-output-stream-p object)))
    (package (packagep object))
    ((pathname readtable random-state)
     (and (*:structure-p object) (eq (*:%structure-name object) type)))
    (extended-char (and (characterp object) (not (typep object 'base-char))))
    (structure-object (and (*:structure-p object)
                           (not (member (*:%structure-name object)
                                        '(array standard-instance hash-table readtable
                                          pathname random-state string-input-stream string-output-stream
                                          standard-input-stream standard-output-stream two-way-stream file-input-stream file-stream synonym-stream echo-stream
                                          broadcast-stream concatenated-stream)))))
    ((t) t)  ; type T means any object matches
    (otherwise
     (let ((expanded (expand-deftype type)))
       (unless (eq expanded type)
         (return-from typep (typep object expanded))))
     (cond ((consp type)
            (case (car type)
              (or (some (lambda (ty) (typep object ty)) (cdr type)))
              (and (every (lambda (ty) (typep object ty)) (cdr type)))
              (not (not (typep object (cadr type))))
              (member (not (null (member object (cdr type)))))
              (eql (eql object (cadr type)))
              (satisfies (not (null (funcall (cadr type) object))))
              (cons
               (and (consp object)
                    (destructuring-bind (&optional (car-type '*) (cdr-type '*)) (cdr type)
                      (and (or (eq car-type '*) (typep (car object) car-type))
                           (or (eq cdr-type '*) (typep (cdr object) cdr-type))))))
              ((integer rational real float short-float single-float double-float long-float)
               (and (typep object (car type)) (numeric-type-bounds-p object (cdr type))))
              ((signed-byte unsigned-byte)
               (and (integerp object)
                    (let ((size (if (cdr type) (second type) '*)))
                      (if (eq (car type) 'unsigned-byte)
                          (and (>= object 0) (or (eq size '*) (< object (ash 1 size))))
                          (or (eq size '*)
                              (let ((bound (ash 1 (1- size)))) (<= (- bound) object (1- bound))))))))
              (mod (and (integerp object) (<= 0 object) (< object (second type))))
              (complex
               (and (complexp object)
                    (or (null (cdr type)) (eq (second type) '*)
                        (and (typep (realpart object) (second type))
                             (typep (imagpart object) (second type))))))
              ((array simple-array vector simple-vector bit-vector simple-bit-vector
                      string simple-string base-string simple-base-string)
               (array-type-specifier-p object type))
              ((function values) (error "Unsupported TYPEP type specifier: ~S" type))
              (otherwise nil)))
           ((and (*:structure-p object)
                 (eq (*:%structure-name object)
                     'standard-instance)
                 (find-class type nil))
            (subclassp (class-of object) (find-class type nil)))
           ((*:structure-p object)
            (eq (*:%structure-name object)
                type))
           (t nil)))))

(defun integer-type-bounds (type)
  (let* ((name (if (consp type) (car type) type))
         (args (if (consp type) (cdr type) nil)))
    (case name
      (bit (values 0 1 t))
      (fixnum (values most-negative-fixnum most-positive-fixnum t))
      (integer
       (let ((lo (first args)) (hi (second args)))
         (when (eq lo '*) (setq lo nil))
         (when (eq hi '*) (setq hi nil))
         (when (consp lo) (setq lo (1+ (car lo))))
         (when (consp hi) (setq hi (1- (car hi))))
         (values lo hi t)))
      ((signed-byte unsigned-byte)
       (let ((bits (first args)))
         (if (or (null bits) (eq bits '*))
             (values (and (eq name 'unsigned-byte) 0) nil t)
             (if (eq name 'unsigned-byte)
                 (values 0 (1- (cl:ash 1 bits)) t)
                 (values (- (cl:ash 1 (1- bits))) (1- (cl:ash 1 (1- bits))) t)))))
      (otherwise (values nil nil nil)))))

(defun subtypep (type1 type2 &optional environment)
  (declare (ignore environment))
  (when (or (symbolp type1) (consp type1)) (setq type1 (expand-deftype type1)))
  (when (or (symbolp type2) (consp type2)) (setq type2 (expand-deftype type2)))
  (when (equal type1 type2) (return-from subtypep (values t t)))
  #+valtan
  (when (fboundp 'numeric-subtypep)
    (multiple-value-bind (subset known) (numeric-subtypep type1 type2)
      (when known (return-from subtypep (values subset t)))))
  ;; All four float formats use the same binary64 representation.
  (when (and (member type1 '(float short-float single-float double-float long-float))
             (member type2 '(float short-float single-float double-float long-float real number)))
    (return-from subtypep (values t t)))
  (multiple-value-bind (lo1 hi1 integer1) (integer-type-bounds type1)
    (when integer1
      (when (and lo1 hi1 (> lo1 hi1)) (return-from subtypep (values t t)))
      (when (member type2 '(rational real number)) (return-from subtypep (values t t)))
      (multiple-value-bind (lo2 hi2 integer2) (integer-type-bounds type2)
        (when integer2
          (return-from subtypep
            (values (and (or (null lo2) (and lo1 (>= lo1 lo2)))
                         (or (null hi2) (and hi1 (<= hi1 hi2)))) t))))))
  (cond ;; Same type
        ((eq type1 type2)
         (values t t))
        ;; Everything is a subtype of T
        ((eq type2 t)
         (values t t))
        ;; NIL is a subtype of everything
        ((eq type1 'nil)
         (values t t))
        ;; Character types
        ;; Valtan represents every Common Lisp character with the same
        ;; JavaScript string character, so BASE-CHAR and CHARACTER have the
        ;; same set of values in this implementation.
        ((and (member type1 '(character base-char))
              (member type2 '(character base-char)))
         (values t t))
        ((and (eq type1 'standard-char)
              (member type2 '(character base-char)))
         (values t t))
        ((and (member type1 '(character base-char standard-char extended-char))
              (eq type2 'character))
         (values t t))
        ;; Bit type
        ((and (eq type1 'bit)
              (member type2 '(bit integer fixnum number real rational t)))
         (values t t))
        ;; Integer types
        ((and (eq type1 'fixnum)
              (member type2 '(integer number real rational t)))
         (values t t))
        ((and (eq type1 'integer)
              (member type2 '(number real rational t)))
         (values t t))
        ;; Number types
        ((and (eq type1 'float)
              (member type2 '(number real t)))
         (values t t))
        ((and (eq type1 'real)
              (member type2 '(number t)))
         (values t t))
        ((and (eq type1 'rational)
              (member type2 '(real number t)))
         (values t t))
        ;; String types
        ((and (member type1 '(string simple-string base-string simple-base-string))
              (member type2 '(string vector array sequence t)))
         (values t t))
        ;; Vector/array types
        ((and (member type1 '(vector simple-vector bit-vector simple-bit-vector))
              (member type2 '(array sequence t)))
         (values t t))
        ((and (eq type1 'array)
              (eq type2 't))
         (values t t))
        ;; List types
        ((and (member type1 '(null cons list))
              (eq type2 'list))
         (values t t))
        ((and (member type1 '(null cons list))
              (eq type2 'sequence))
         (values t t))
        ((and (eq type1 'null)
              (member type2 '(list symbol atom t)))
         (values t t))
        ;; Symbol types
        ((and (eq type1 'keyword)
              (member type2 '(symbol atom t)))
         (values t t))
        ((and (eq type1 'symbol)
              (member type2 '(atom t)))
         (values t t))
        ;; Atom
        ((and (member type1 '(symbol number character array function hash-table))
              (eq type2 'atom))
         (values t t))
        ;; Function types
        ((and (eq type1 'compiled-function)
              (member type2 '(function t)))
         (values t t))
        ((and (member type1 '(null cons atom list))
              (member type2 '(null cons atom list)))
         (values nil t))
        ;; Unknown relationship
        (t
         (let ((class1 (cond ((symbolp type1) (find-class type1 nil))
                             ((and (*:structure-p type1)
                                   (eq (*:%structure-name type1) 'standard-instance)) type1)))
               (class2 (cond ((symbolp type2) (find-class type2 nil))
                             ((and (*:structure-p type2)
                                   (eq (*:%structure-name type2) 'standard-instance)) type2))))
           (if (and class1 class2)
               (values (subclassp class1 class2) t)
               (values nil nil))))))

(defmacro typecase (keyform &body cases)
  (let ((gvalue (cl:gensym)))
    `(let ((,gvalue ,keyform))
       (cond ,@(cl:mapcar (lambda (c)
                            (cl:destructuring-bind (type . body) c
                              (if (cl:member type '(otherwise t))
                                  `(t ,@body)
                                  `((typep ,gvalue ',type) ,@body))))
                          cases)))))

(defmacro etypecase (keyform &body cases)
  (let ((gvalue (cl:gensym))
        (expected-type
          `(or ,@(mapcar #'first cases))))
    `(let ((,gvalue ,keyform))
       (cond ,@(mapcar (lambda (c)
                         (destructuring-bind (type . body) c
                           `((typep ,gvalue ',type) ,@body)))
                       cases)
             (t (error 'type-error
                       :datum ,gvalue
                       :expected-type ',expected-type))))))

;; Simplified ctypecase without restart-case (signals error on no match)
(defmacro ctypecase (keyplace &body cases)
  (let ((gvalue (cl:gensym))
        (expected-type
          `(or ,@(mapcar #'first cases))))
    `(let ((,gvalue ,keyplace))
       (cond ,@(mapcar (lambda (c)
                         (destructuring-bind (type . body) c
                           `((typep ,gvalue ',type) ,@body)))
                       cases)
             (t (error 'type-error
                       :datum ,gvalue
                       :expected-type ',expected-type))))))

(defun type-of (object)
  (cond ((integerp object) (if (typep object 'fixnum) 'fixnum 'bignum))
        ((floatp object) 'single-float)
        ((rationalp object) 'ratio)
        ((complexp object) (list 'complex (type-of (realpart object))))
        ((characterp object) 'base-char)
        ((symbolp object)
         (cond ((null object) 'null) ((eq object t) 'boolean)
               ((keywordp object) 'keyword) (t 'symbol)))
        ((consp object) 'cons)
        ((arrayp object)
         (list (if (simple-array-p object) 'simple-array 'array)
               (array-element-type object) (array-dimensions object)))
        ((packagep object) 'package)
        ((functionp object) (if (typep object 'generic-function)
                               'standard-generic-function 'compiled-function))
        ((and (*:structure-p object) (eq (*:%structure-name object) 'standard-instance))
         (class-name (class-of object)))
        ((*:structure-p object) (*:%structure-name object))
        (t (error "Unexpected object: ~S" object))))
