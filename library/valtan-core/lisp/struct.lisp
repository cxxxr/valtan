#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(defun copy-structure (x)
  (unless (*:structure-p x)
    (type-error x 'structure-object))
  (*:%copy-structure x))

(defun %structure-subtype-p (name parent)
  (do ((name name (get name 'structure-parent)))
      ((null name) nil)
    (when (eq name parent) (return t))))

(defun %structure-instance-p (object name)
  (and (*:structure-p object)
       (%structure-subtype-p (*:%structure-name object) name)))

(defun %typed-structure-p (object representation size name-index name)
  (and (if (eq representation 'list) (listp object) (vectorp object))
       (>= (length object) size)
       (or (null name-index) (eq (elt object name-index) name))))

(eval-when (:compile-toplevel :load-toplevel :execute)
  ;; Descriptions use ordinary lists so both the host compiler and runtime
  ;; compiler can retain the layout, including inherited padding and tags.
  ;; A slot is (name initform type read-only index).
  (defun parse-structure-name-and-options (name-and-options slot-descriptions)
    (cl:let* ((name (if (cl:consp name-and-options) (cl:car name-and-options) name-and-options))
              (options (if (cl:consp name-and-options) (cl:cdr name-and-options) nil))
              (conc-name (cl:make-symbol (cl:format nil #"~A-" (cl:symbol-name name))))
              (default-constructor (cl:intern (cl:format nil #"MAKE-~A" (cl:symbol-name name))))
              (copier (cl:intern (cl:format nil #"COPY-~A" (cl:symbol-name name))))
              (predicate (cl:intern (cl:format nil #"~A-P" (cl:symbol-name name))))
              (constructors nil) (constructor-p nil) (predicate-p nil) (include nil)
              (representation nil) (named nil) (offset 0)
              (printer nil) (printer-p nil) (documentation nil))
      (cl:dolist (option options)
        (cl:unless (cl:consp option) (cl:setq option (cl:list option)))
        (cl:case (cl:car option)
          (:conc-name (cl:setq conc-name (cl:second option))
           (cl:when (cl:stringp conc-name) (cl:setq conc-name (cl:make-symbol conc-name))))
          (:constructor
           (cl:setq constructor-p t)
           (cl:let ((constructor (if (cl:cdr option) (cl:second option) default-constructor)))
             (cl:when constructor
               (cl:push (cl:list constructor (cl:not (cl:null (cl:cddr option))) (cl:third option)) constructors))))
          (:copier (cl:when (cl:cdr option) (cl:setq copier (cl:second option))))
          (:predicate (cl:setq predicate-p t)
           (cl:when (cl:cdr option) (cl:setq predicate (cl:second option))))
          (:include (cl:setq include (cl:cdr option)))
          (:type (cl:setq representation (cl:second option)))
          (:named (cl:setq named t))
          (:initial-offset (cl:setq offset (cl:second option)))
          ((:print-object :print-function) (cl:setq printer option printer-p t))
          (otherwise (cl:error #"Unknown DEFSTRUCT option ~S" option))))
      (cl:unless constructor-p (cl:setq constructors (cl:list (cl:list default-constructor nil nil))))
      (cl:when (cl:and representation (cl:not named))
        (cl:when (cl:and predicate-p predicate)
          (cl:error #"A typed structure predicate requires :NAMED"))
        (cl:setq predicate nil))
      (cl:when (cl:and named (cl:consp representation)
                       (cl:not (cl:typep name (cl:second representation))))
        (cl:error #"The structure name is not representable in ~S" representation))
      (cl:when (cl:and slot-descriptions (cl:stringp (cl:car slot-descriptions)))
        (cl:setq documentation (cl:pop slot-descriptions)))
      (cl:unless (cl:and (cl:integerp offset) (cl:>= offset 0))
        (cl:error #"Invalid structure initial offset ~S" offset))
      (cl:let* ((parent (cl:car include))
                (parent-description (cl:and parent (cl:get parent 'structure-description)))
                (slots (cl:copy-tree (cl:getf parent-description :slots)))
                (layout (cl:copy-tree (cl:getf parent-description :layout)))
                (name-index nil))
        (cl:when parent
          (cl:unless parent-description (cl:error #"Undefined included structure ~S" parent))
          (cl:unless (cl:equal representation (cl:getf parent-description :type))
            (cl:error #"Incompatible structure representations"))
          (cl:unless printer-p (cl:setq printer (cl:getf parent-description :printer)))
          (cl:dolist (override (cl:cdr include))
            (cl:let* ((parts (if (cl:consp override) override (cl:list override)))
                      (slot (cl:find (cl:car parts) slots :key #'cl:car :test #'cl:string=)))
              (cl:unless slot (cl:error #"Unknown included slot ~S" (cl:car parts)))
              (cl:when (cl:cdr parts) (cl:setf (cl:second slot) (cl:second parts)))
              (cl:do ((rest (cl:cddr parts) (cl:cddr rest))) ((cl:null rest))
                (cl:ecase (cl:car rest)
                  (:type (cl:setf (cl:third slot) (cl:cadr rest)))
                  (:read-only (cl:setf (cl:fourth slot) (cl:cadr rest))))))))
        (cl:setq layout (cl:append layout (cl:make-list offset)))
        (cl:when (cl:and representation named)
          (cl:setq name-index (cl:length layout)
                   layout (cl:append layout (cl:list (cl:list :name name)))))
        (cl:dolist (description slot-descriptions)
          (cl:let* ((parts (if (cl:consp description) description (cl:list description)))
                    (slot-name (cl:car parts))
                    (slot (cl:list slot-name (cl:second parts)
                                   (cl:getf (cl:cddr parts) :type t)
                                   (cl:getf (cl:cddr parts) :read-only)
                                   (cl:length layout))))
            (cl:when (cl:find slot-name slots :key #'cl:car :test #'cl:string=)
              (cl:error #"Duplicate structure slot ~S" slot-name))
            (cl:setq slots (cl:append slots (cl:list slot))
                     layout (cl:append layout (cl:list (cl:list :slot slot-name))))))
        (cl:list :name name :conc-name conc-name :constructors (cl:nreverse constructors)
                 :copier copier :predicate predicate :parent parent :type representation
                 :name-index name-index :slots slots :layout layout :printer printer
                 :documentation documentation))))

  (defun structure-allocation-form (description values)
    (cl:let* ((representation (cl:getf description :type))
              (contents (cl:mapcar
                         (lambda (entry)
                           (cl:case (cl:car entry)
                             (:slot (cl:cdr (cl:assoc (cl:second entry) values)))
                             (:name `(quote ,(cl:second entry)))
                             (otherwise nil)))
                         (cl:getf description :layout))))
      (cl:cond ((cl:null representation)
                `(*:make-structure ',(cl:getf description :name) ,@contents))
               ((cl:eq representation 'list) `(cl:list ,@contents))
               (t `(make-array ,(cl:length contents)
                               :element-type ',(if (cl:consp representation) (cl:second representation) t)
                               :initial-contents (cl:list ,@contents))))))

  (defun structure-constructor-form (constructor description)
    (cl:destructuring-bind (name boa-p lambda-list) constructor
      (cl:let ((slots (cl:getf description :slots)) (values nil))
        (cl:if (cl:not boa-p)
               (cl:let ((keys nil))
                 (cl:dolist (slot slots)
                   (cl:let ((variable (cl:gensym)))
                     (cl:push (cl:cons (cl:car slot) variable) values)
                     (cl:push `((,(cl:intern (cl:symbol-name (cl:car slot)) :keyword) ,variable)
                                ,(cl:second slot)) keys)))
                 `(defun ,name (&key ,@(cl:nreverse keys))
                    ,(structure-allocation-form description values)))
               (cl:let ((mode nil) (parameters nil) (bound nil) (defaults nil))
                 ;; BOA defaults become lambda-list initforms and may use
                 ;; earlier arguments; ordinary constructors use fresh names.
                 (cl:dolist (slot slots)
                   (cl:push (cl:cons (cl:car slot) (cl:second slot)) defaults))
                 (cl:dolist (parameter lambda-list)
                   (cl:cond ((cl:member parameter '(&optional &rest &key &allow-other-keys &aux))
                             (cl:unless (cl:eq parameter '&allow-other-keys) (cl:setq mode parameter)))
                            (t
                             (cl:let* ((head (if (cl:consp parameter) (cl:car parameter) parameter))
                                       (var (if (cl:consp head) (cl:second head) head))
                                       (default (cl:assoc var defaults)))
                               (cl:push var bound)
                               (cl:when (cl:and (cl:consp parameter) (cl:third parameter))
                                 (cl:push (cl:third parameter) bound))
                               (cl:when (cl:and default (cl:member mode '(&optional &key))
                                                (cl:or (cl:atom parameter) (cl:null (cl:cdr parameter))))
                                 (cl:setq parameter `(,head ,(cl:cdr default)))))))
                   (cl:push parameter parameters))
                 (cl:dolist (slot slots)
                   (cl:push (cl:cons (cl:car slot)
                                    (if (cl:member (cl:car slot) bound)
                                        (cl:car slot)
                                        (cl:cdr (cl:assoc (cl:car slot) defaults)))) values))
                 `(defun ,name ,(cl:nreverse parameters)
                    ,(structure-allocation-form description values)))))))

  (defun structure-check-form (description object)
    (cl:let ((representation (cl:getf description :type)))
      (if representation
          `(%typed-structure-p ,object ',(if (cl:consp representation) (cl:car representation) representation)
                               ,(cl:length (cl:getf description :layout))
                               ,(cl:getf description :name-index) ',(cl:getf description :name))
          `(%structure-instance-p ,object ',(cl:getf description :name)))))

  (defun structure-slot-form (description slot object)
    (cl:let ((representation (cl:getf description :type)) (index (cl:fifth slot)))
      (cl:cond ((cl:null representation) `(*:%structure-ref ,object ,index))
               ((cl:eq representation 'list) `(cl:nth ,index ,object))
               (t `(aref ,object ,index))))))

(defmacro defstruct (name-and-options &rest slot-descriptions)
  (cl:let* ((description (parse-structure-name-and-options name-and-options slot-descriptions))
            (name (cl:getf description :name))
            (representation (cl:getf description :type))
            (slots (cl:getf description :slots))
            (conc-name (cl:getf description :conc-name))
            (copier (cl:getf description :copier))
            (predicate (cl:getf description :predicate))
            (printer (cl:getf description :printer))
            (reader-constructor (cl:find-if (lambda (c) (cl:not (cl:second c)))
                                           (cl:getf description :constructors))))
    ;; Inclusion must be available during subsequent macro expansions as well
    ;; as after loading the compiled file.
    (*:put name 'structure-description description)
    `(progn
       (cl:setf (cl:get ',name 'structure-description) ',description
                  (cl:get ',name 'structure-parent) ',(cl:getf description :parent)
                  (cl:get ',name 'structure-defined) ,(cl:null representation)
                  (cl:get ',name 'structure-reader-constructor) ',(cl:car reader-constructor)
                  (cl:get ',name 'structure-slots) ',(cl:mapcar #'cl:car slots))
       ,@(cl:mapcar (lambda (constructor) (structure-constructor-form constructor description))
                    (cl:getf description :constructors))
       ,@(cl:when predicate
           `((defun ,predicate (object) ,(structure-check-form description 'object))))
       ,@(cl:when copier
           `((defun ,copier (object)
               (cl:unless ,(structure-check-form description 'object)
                 (type-error object ',(cl:or representation name)))
               ,(cl:cond ((cl:null representation) '(copy-structure object))
                          ((cl:eq representation 'list) '(cl:copy-list object))
                          (t '(copy-seq object))))))
       ,@(cl:mapcar
          (lambda (slot)
            (cl:let* ((slot-name (cl:car slot))
                      (accessor (if conc-name
                                    (cl:intern (cl:format nil #"~A~A" (cl:string conc-name) (cl:symbol-name slot-name)))
                                    slot-name))
                      (place (structure-slot-form description slot 'object)))
              `(progn
                 (defun ,accessor (object)
                   (cl:unless ,(structure-check-form description 'object)
                     (type-error object ',(cl:or representation name)))
                   ,place)
                 ,@(cl:unless (cl:fourth slot)
                     `((defun (cl:setf ,accessor) (value object)
                         (cl:unless ,(structure-check-form description 'object)
                           (type-error object ',(cl:or representation name)))
                         ,(if representation `(setf ,place value)
                              `(*:%structure-set object ,(cl:fifth slot) value)))))))) slots)
       ,@(cl:unless representation
           `((cl:setf (cl:get ',name 'structure-printer)
                      ,(if (cl:second printer)
                           `(lambda (object stream)
                              (cl:funcall (function ,(cl:second printer)) object stream
                                          ,@(cl:when (cl:eq (cl:car printer) :print-function) '(0))))
                           `(lambda (object stream)
                              (print-structure-slots object stream))))))
       ',name)))

(defun structure-printer (structure)
  (get (*:%structure-name structure) 'structure-printer))
