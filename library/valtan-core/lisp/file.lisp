#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(defun %file-namestring (path &optional wild-allowed)
  (when (and (not wild-allowed) (wild-pathname-p path))
    (error 'file-error :pathname path))
  (namestring (translate-logical-pathname path)))

(defun file-element-type (type)
  (when (eq type 'bit) (setq type '(unsigned-byte 1)))
  (cond ((or (eq type :default) (subtypep type 'character)) (values 'character 0 nil))
        ((member type '(signed-byte unsigned-byte))
         (values (list type 8) 1 (eq type 'signed-byte)))
        ((subtypep type 'integer)
         (let* ((type (expand-deftype type))
                (signed (or (eq (car type) 'signed-byte)
                            (and (eq (car type) 'integer)
                                 (let ((low (second type))) (< (if (consp low) (1+ (car low)) low) 0)))))
                (bits (case (car type)
                        ((signed-byte unsigned-byte) (second type))
                        (integer
                         (let ((lo (second type)) (hi (third type)))
                           (when (consp lo) (setq lo (1+ (car lo))))
                           (when (consp hi) (setq hi (1- (car hi))))
                           (+ (if signed 1 0) (max (cl:integer-length lo) (cl:integer-length hi)))))
                        (otherwise (if (eq type 'bit) 1 nil)))))
           (unless (and (integerp bits) (>= bits 0)) (type-error type 'type-specifier))
           (let ((bytes (max 1 (ceiling bits 8))))
             (values (list (if signed 'signed-byte 'unsigned-byte) (* bytes 8)) bytes signed))))
        (t (type-error type 'type-specifier))))

(defun open (filename &key (direction :input) (element-type 'character)
                          (if-exists nil exists-p) (if-does-not-exist nil missing-p)
                          (external-format :default))
  (declare (ignore external-format))
  #-valtan
  (make-file-input-stream :string-stream
    (make-string-input-stream (*:raw-string-to-array (system:read-whole-file filename))))
  #+valtan
  (let ((pathname (merge-pathnames (pathname filename))))
    (unless (member direction '(:input :output :io :probe))
      (type-error direction '(member :input :output :io :probe)))
    (unless exists-p (setq if-exists (if (eq (pathname-version pathname) :newest) :new-version :error)))
    (unless missing-p
      (setq if-does-not-exist (cond ((eq direction :probe) nil)
                                   ((or (eq direction :input) (member if-exists '(:overwrite :append))) :error)
                                   (t :create))))
    (unless (member if-exists '(nil :error :new-version :rename :rename-and-delete :overwrite :append :supersede))
      (type-error if-exists '(member nil :error :new-version :rename :rename-and-delete :overwrite :append :supersede)))
    (unless (member if-does-not-exist '(nil :error :create))
      (type-error if-does-not-exist '(member nil :error :create)))
    (when (wild-pathname-p pathname) (error 'file-error :pathname pathname))
    (multiple-value-bind (type bytes signed) (file-element-type element-type)
      (let ((handle (*:file-op :open (*:array-to-raw-string (%file-namestring pathname)) pathname
                              direction if-exists if-does-not-exist bytes signed)))
        (when handle
          (let ((stream (%make-file-stream :handle handle :pathname pathname :element-type type :direction direction)))
            (when (eq direction :probe) (close stream))
            stream))))))

(defmacro with-open-file ((var filename &rest options) &body body)
  `(with-open-stream (,var (open ,filename ,@options)) ,@body))
(defun probe-file (pathspec)
  (let* ((path (merge-pathnames (pathname pathspec)))
         (raw (*:file-op :probe (*:array-to-raw-string (%file-namestring path)) path)))
    (and raw (pathname (ffi:js->cl raw)))))
(defun truename (pathspec)
  (let ((path (merge-pathnames (pathname pathspec))))
    (pathname (ffi:js->cl (*:file-op :truename (*:array-to-raw-string (%file-namestring path)) path)))))
(defun directory (pathspec &key)
  (let* ((path (merge-pathnames (pathname pathspec)))
         (raw (*:file-op :directory (*:array-to-raw-string (%file-namestring path t)) path))
         (result nil))
    (dotimes (i (ffi:ref raw "length") (nreverse result))
      (push (pathname (ffi:js->cl (ffi:aget raw i))) result))))
(defun delete-file (pathspec)
  (let ((path (merge-pathnames (pathname pathspec))))
    (when (file-stream-p pathspec) (close pathspec))
    (*:file-op :delete (*:array-to-raw-string (%file-namestring path)) path)))
(defun rename-file (filespec new-name)
  (let* ((old (truename filespec)) (new (merge-pathnames new-name old))
         (raw (*:file-op :rename (*:array-to-raw-string (%file-namestring old))
                                (*:array-to-raw-string (%file-namestring new)) old)))
    (values new old (pathname (ffi:js->cl raw)))))
(defun ensure-directories-exist (pathspec &key verbose)
  (declare (ignore verbose))
  (let ((path (merge-pathnames (pathname pathspec))))
    (when (wild-pathname-p path) (error 'file-error :pathname path))
    (values pathspec (*:file-op :ensure-directories (*:array-to-raw-string (%file-namestring path)) path))))
(defun file-write-date (pathspec)
  (let ((path (merge-pathnames (pathname pathspec))))
    (*:file-op :write-date (*:array-to-raw-string (%file-namestring path)) path)))
(defun file-author (pathspec)
  (let* ((path (merge-pathnames (pathname pathspec)))
         (raw (*:file-op :author (*:array-to-raw-string (%file-namestring path)) path)))
    (and raw (ffi:js->cl raw))))
