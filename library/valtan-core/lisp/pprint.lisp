(in-package :common-lisp)

;;; Logical blocks retain a small document tree.  Rendering is delayed until
;;; the outer block ends, so conditional breaks can inspect the next section.
(defstruct (%pretty-block (:constructor %make-pretty-block))
  (prefix "") (suffix "") per-line-prefix nodes (width 0))
(defvar *pretty-blocks* nil)

(defun %pretty-stream (stream)
  (setq stream (output-stream-designator stream))
  (cond ((synonym-stream-p stream) (%pretty-stream (synonym-stream-target stream)))
        ((two-way-stream-p stream) (%pretty-stream (two-way-stream-output-stream stream)))
        ((echo-stream-p stream) (%pretty-stream (echo-stream-output-stream stream)))
        (t stream)))

(defun %pretty-current (stream)
  (cdr (assoc (%pretty-stream stream) *pretty-blocks*)))

(defun %pretty-capture (stream text)
  (let ((block (%pretty-current stream)))
    (when block
      (if (characterp text)
          (push text (%pretty-block-nodes block))
          (dotimes (i (length text))
            (push (char text i) (%pretty-block-nodes block))))
      t)))

(defun %pretty-node-width (node)
  (cond ((characterp node) (if (char= node #\Newline) 1000000000 1))
        ((%pretty-block-p node) (%pretty-block-width node))
        ((and (eq (car node) :newline) (eq (cadr node) :mandatory)) 1000000000)
        (t 0)))

(defun %pretty-tab-width (kind colnum colinc column section)
  (let* ((relative (member kind '(:line-relative :section-relative)))
         (position (- column (if (member kind '(:section :section-relative)) section 0))))
    (if relative
        (+ colnum (if (zerop colinc) 0 (mod (- (+ position colnum)) colinc)))
        (cond ((< position colnum) (- colnum position))
              ((zerop colinc) 0)
              (t (- colinc (mod (- position colnum) colinc)))))))

(defun %pretty-render (block stream)
  (let ((output nil) (column (or (stream-column stream) 0)) (line 1)
        (margin (or *print-right-margin* 80))
        (frames nil))
    (declare (special frames))
    (labels ((emit (char) (push char output) (incf column))
             (text (string) (dotimes (i (length string)) (emit (char string i))))
             (spaces (count) (dotimes (i (max 0 count)) (emit #\Space)))
             (newline (indent trim)
               (when trim
                 (loop while (and output (eql (car output) #\Space))
                       do (pop output) (decf column)))
               (when (and (not *print-readably*) *print-lines* (>= line *print-lines*))
                 (text " ..")
                 (dolist (frame frames) (text (%pretty-block-suffix (car frame))))
                 (throw 'pretty-lines nil))
               (push #\Newline output)
               (setq column 0)
               (incf line)
               (dolist (frame (reverse frames))
                 (let ((prefix (%pretty-block-per-line-prefix (car frame))))
                   (when prefix
                     (spaces (- (cadr frame) column))
                     (text prefix))))
               (spaces (- indent column)))
             (section-width (nodes suffix)
               (let ((width 0))
                 (dolist (node nodes (+ width (length suffix)))
                   (when (and (consp node) (eq (car node) :newline))
                     (return width))
                   (incf width (%pretty-node-width node)))))
             (render (block)
               (let* ((start column)
                      (broken (> (+ column (%pretty-block-width block)) margin))
                      (miser (and *print-miser-width*
                                  (<= (- margin column (length (%pretty-block-prefix block))) *print-miser-width*)))
                      (frames (cons (list block start) frames)))
                 (declare (special frames))
                 (text (%pretty-block-prefix block))
                 (let ((origin column) (indent column) (section column) (section-line line))
                   (loop for rest on (%pretty-block-nodes block)
                         for node = (car rest)
                         do (cond
                              ((characterp node)
                               (if (char= node #\Newline) (newline 0 nil) (emit node)))
                              ((%pretty-block-p node) (render node))
                              ((eq (car node) :indent)
                               (unless miser
                                 (setq indent (max 0 (+ (if (eq (cadr node) :block) origin column)
                                                       (round (caddr node)))))))
                              ((eq (car node) :tab)
                               (spaces (%pretty-tab-width (cadr node) (caddr node) (cadddr node)
                                                          column section)))
                              ((eq (car node) :newline)
                               (when (case (cadr node)
                                       (:mandatory t)
                                       (:linear broken)
                                       (:miser (and miser broken))
                                       (:fill (or (< section-line line) (and miser broken)
                                                  (> (+ column (section-width (cdr rest) (%pretty-block-suffix block)))
                                                     margin))))
                                 (newline indent t))
                               (setq section column section-line line))))
                   (text (%pretty-block-suffix block))))))
      ;; Frames are dynamic because NEWLINE needs all currently active suffixes
      ;; and per-line prefixes, including those of enclosing blocks.
      (catch 'pretty-lines (render block))
      (let ((*pretty-output-hook* nil))
        (write-string (coerce (nreverse output) 'string) stream)))))

(defun %pretty-circle-start (object stream)
  (when *print-circle*
    (let ((label (cdr (assoc object *print-circle-table*))))
      (when label
        (when (member object *print-circle-seen*)
          (print-label object stream)
          (return-from %pretty-circle-start t))
        (push object *print-circle-seen*)
        (write-char #\# stream)
        (print-decimal-integer label stream)
        (write-char #\= stream))))
  nil)

(defun %call-pretty-block (stream object prefix suffix per-line-prefix function)
  (unless (stringp prefix) (type-error prefix 'string))
  (unless (stringp suffix) (type-error suffix 'string))
  (unless (or (null per-line-prefix) (stringp per-line-prefix))
    (type-error per-line-prefix '(or null string)))
  (setq stream (%pretty-stream stream))
  (unless *printing-active*
    (let ((*print-circle-table* (when *print-circle* (make-circle-table object)))
          (*print-circle-seen* nil) (*printing-active* t))
      (return-from %call-pretty-block
        (%call-pretty-block stream object prefix suffix per-line-prefix function))))
    (cond ((not (listp object)) (write object :stream stream))
          ((and (not *print-readably*) *print-level* (>= *print-depth* *print-level*))
           (write-char #\# stream))
          ((%pretty-circle-start object stream))
          (t
           (let ((*print-depth* (1+ *print-depth*)))
             (if (not *print-pretty*)
                 (progn (write-string (or per-line-prefix prefix) stream)
                        (funcall function stream)
                        (write-string suffix stream))
                 (let* ((parent (%pretty-current stream))
                        (block (%make-pretty-block :prefix (or per-line-prefix prefix)
                                                  :suffix suffix :per-line-prefix per-line-prefix)))
                   (let ((*pretty-blocks* (acons stream block *pretty-blocks*))
                         (*pretty-output-hook* #'%pretty-capture))
                     (funcall function stream))
                   (setf (%pretty-block-nodes block) (nreverse (%pretty-block-nodes block))
                         (%pretty-block-width block)
                         (+ (length (%pretty-block-prefix block)) (length suffix)
                            (reduce #'+ (%pretty-block-nodes block) :key #'%pretty-node-width :initial-value 0)))
                   (if parent (push block (%pretty-block-nodes parent))
                       (%pretty-render block stream)))))))
  nil)

;;; STATE is (remaining-list pop-count).  A second value requests a lexical
;;; exit from the block after printing a dotted tail or a length abbreviation.
(defun %pretty-pop (state stream)
  (let ((tail (car state)))
    (cond ((and tail (not (consp tail)))
           (write-string ". " stream) (write tail :stream stream) (values nil t))
          ((and (not *print-readably*) *print-length* (>= (cadr state) *print-length*))
           (write-string "..." stream) (values nil t))
          ((and (> (cadr state) 0) *print-circle* (assoc tail *print-circle-table*))
           (write-string ". " stream) (write tail :stream stream) (values nil t))
          (t (setf (car state) (cdr tail))
             (incf (cadr state))
             (values (car tail) nil)))))

(defmacro pprint-logical-block ((stream object &key (prefix "" prefixp) (suffix "")
                                                     (per-line-prefix nil perlinep)) &body body)
  (when (and prefixp perlinep) (error "Both pretty prefixes were supplied"))
  (let ((out (gensym)) (value (gensym)) (state (gensym)) (done (gensym)))
    `(let* ((,out (output-stream-designator ,stream))
            (,value ,object) (,state (list ,value 0)))
       (%call-pretty-block
        ,out ,value ,prefix ,suffix
        ,(if perlinep `(let ((prefix ,per-line-prefix))
                        (unless (stringp prefix) (type-error prefix 'string)) prefix)
             nil)
        (lambda (,out)
          ,@(when (and stream (not (eq stream t))) `((declare (ignorable ,out))))
          (let ,(when (and stream (not (eq stream t))) `((,stream ,out)))
            (block ,done
              (macrolet ((pprint-pop ()
                           '(multiple-value-bind (value stop) (%pretty-pop ,state ,out)
                              (when stop (return-from ,done nil)) value))
                         (pprint-exit-if-list-exhausted ()
                           '(when (null (car ,state)) (return-from ,done nil))))
                ,@body))))))))

(defun pprint-newline (kind &optional (stream *standard-output*))
  (unless (member kind '(:linear :fill :miser :mandatory))
    (type-error kind '(member :linear :fill :miser :mandatory)))
  (let ((block (%pretty-current stream)))
    (when (and *print-pretty* block)
      (push (list :newline kind) (%pretty-block-nodes block))))
  nil)

(defun pprint-indent (relative-to n &optional (stream *standard-output*))
  (unless (member relative-to '(:block :current)) (type-error relative-to '(member :block :current)))
  (unless (realp n) (type-error n 'real))
  (let ((block (%pretty-current stream)))
    (when (and *print-pretty* block)
      (push (list :indent relative-to n) (%pretty-block-nodes block))))
  nil)

(defun pprint-tab (kind colnum colinc &optional (stream *standard-output*))
  (unless (member kind '(:line :section :line-relative :section-relative))
    (type-error kind '(member :line :section :line-relative :section-relative)))
  (unless (typep colnum '(integer 0 *)) (type-error colnum '(integer 0 *)))
  (unless (typep colinc '(integer 0 *)) (type-error colinc '(integer 0 *)))
  (let ((block (%pretty-current stream)))
    (when (and *print-pretty* block)
      (push (list :tab kind colnum colinc) (%pretty-block-nodes block))))
  nil)

(defun %pprint-list (stream object colon kind tabsize)
  (pprint-logical-block (stream object :prefix (if colon "(" "") :suffix (if colon ")" ""))
    (pprint-exit-if-list-exhausted)
    (loop
      (write (pprint-pop) :stream stream)
      (pprint-exit-if-list-exhausted)
      (write-char #\Space stream)
      (when tabsize (pprint-tab :section-relative 0 tabsize stream))
      (pprint-newline kind stream)))
  nil)

(defun pprint-fill (stream object &optional (colon t) atsign)
  (declare (ignore atsign))
  (%pprint-list stream object colon :fill nil))
(defun pprint-linear (stream object &optional (colon t) atsign)
  (declare (ignore atsign))
  (%pprint-list stream object colon :linear nil))
(defun pprint-tabular (stream object &optional (colon t) atsign (tabsize 16))
  (declare (ignore atsign))
  (%pprint-list stream object colon :fill (or tabsize 16)))

(defstruct (%pprint-table (:constructor %make-pprint-table)) entries)
(defvar *standard-pprint-dispatch* (%make-pprint-table))
(defun copy-pprint-dispatch (&optional (table *print-pprint-dispatch*))
  (setq table (or table *standard-pprint-dispatch*))
  (unless (%pprint-table-p table) (type-error table '(or null %pprint-table)))
  (%make-pprint-table :entries (copy-list (%pprint-table-entries table))))
(defun set-pprint-dispatch (type function &optional (priority 0) (table *print-pprint-dispatch*))
  (unless (%pprint-table-p table) (type-error table '%pprint-table))
  (unless (realp priority) (type-error priority 'real))
  (setf (%pprint-table-entries table)
        (remove type (%pprint-table-entries table) :key #'car :test #'equal))
  (when function
    (push (list type function priority) (%pprint-table-entries table)))
  nil)
(defun %pprint-fallback (stream object)
  (let ((*print-pretty* nil)) (write object :stream stream)))
(defun pprint-dispatch (object &optional (table *print-pprint-dispatch*))
  (setq table (or table *standard-pprint-dispatch*))
  (unless (%pprint-table-p table) (type-error table '(or null %pprint-table)))
  (let ((best nil))
    (dolist (entry (%pprint-table-entries table))
      (when (and (or (null best) (> (caddr entry) (caddr best))) (typep object (car entry)))
        (setq best entry)))
    (if best (values (cadr best) t) (values #'%pprint-fallback nil))))
(defun %pretty-write (stream object)
  (multiple-value-bind (function found) (pprint-dispatch object)
    (when found (funcall function stream object) t)))
(defun %pprint-vector (stream object)
  (if (and (not *print-array*) (not *print-readably*))
      (%pprint-fallback stream object)
      (unless (%pretty-circle-start object stream)
        (pprint-logical-block (stream (coerce object 'list) :prefix "#(" :suffix ")")
          (pprint-exit-if-list-exhausted)
          (loop (write (pprint-pop) :stream stream)
                (pprint-exit-if-list-exhausted)
                (write-char #\Space stream) (pprint-newline :fill stream))))))
(set-pprint-dispatch 'cons #'pprint-fill -10 *standard-pprint-dispatch*)
(set-pprint-dispatch '(and vector (not string) (not bit-vector)) #'%pprint-vector -10 *standard-pprint-dispatch*)
(setq *print-pprint-dispatch* (copy-pprint-dispatch nil))
(defun pprint (object &optional (stream *standard-output*))
  (terpri stream)
  (write object :stream stream :pretty t :escape t)
  (values))
