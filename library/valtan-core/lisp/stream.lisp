#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(defvar *:*get-stdin-line-function*)

;; A logical block captures output before choosing its line breaks.  Keeping
;; this hook here also covers writes through synonym and two-way streams.
(defvar *pretty-output-hook* nil)

(defstruct (two-way-stream (:constructor %make-two-way-stream))
  input-stream
  output-stream)

(defstruct (string-output-stream (:copier nil)
                                 (:constructor %make-string-output-stream))
  (buffer "") target (element-type 'character))

(defun make-string-output-stream (&key (element-type 'character))
  (unless (subtypep element-type 'character) (type-error element-type 'type-specifier))
  (%make-string-output-stream :buffer "" :element-type element-type))

(defun get-output-stream-string (stream)
  (let ((string (string-output-stream-buffer stream)))
    (setf (string-output-stream-buffer stream) "")
    string))

(defstruct (standard-output-stream (:copier nil))
  (buffer ""))

(defvar *standard-output* (make-standard-output-stream))
(defvar *error-output* (make-standard-output-stream))

(defun compute-text-column (text)
  (let ((pos (position #\newline text :from-end t)))
    (if pos
        (- (length text) pos 1)
        (length text))))

(defun %base-stream-column (stream)
  (cond ((two-way-stream-p stream)
         (stream-column (two-way-stream-output-stream stream)))
        ((string-output-stream-p stream)
         (compute-text-column (string-output-stream-buffer stream)))
        ((standard-output-stream-p stream)
         (compute-text-column (standard-output-stream-buffer stream)))
        (t
         (type-error stream 'output-stream))))

(defun %base-flush (stream)
  (when (two-way-stream-p stream)
    (return-from %base-flush (flush (two-way-stream-output-stream stream))))
  (when (standard-output-stream-p stream)
    (let ((x (standard-output-stream-buffer stream)))
      (when (< 0 (length x))
        (system:write-raw-string-to-stdout (*:array-to-raw-string x))
        (setf (standard-output-stream-buffer stream) "")))))

(defun %base-stream-write-char (stream char)
  (when (two-way-stream-p stream)
    (return-from %base-stream-write-char (stream-write-char (two-way-stream-output-stream stream) char)))
  (unless (characterp char)
    (type-error char 'character))
  (cond ((string-output-stream-p stream)
         (setf (string-output-stream-buffer stream)
               (*:string-append (string-output-stream-buffer stream)
                                      (string char)))
         char)
        ((standard-output-stream-p stream)
         (setf (standard-output-stream-buffer stream)
               (*:string-append (standard-output-stream-buffer stream)
                                (string char)))

         (when (char= char #\newline)
           (flush stream)))
        (t
         (type-error stream 'output-stream)))
  char)

(defun %base-stream-write-string (stream string)
  (when (two-way-stream-p stream)
    (return-from %base-stream-write-string (stream-write-string (two-way-stream-output-stream stream) string)))
  (unless (stringp string)
    (type-error string 'string))
  (cond ((string-output-stream-p stream)
         (setf (string-output-stream-buffer stream)
               (*:string-append (string-output-stream-buffer stream)
                                      string))
         string)
        ((standard-output-stream-p stream)
         (setf (standard-output-stream-buffer stream)
               (*:string-append (standard-output-stream-buffer stream)
                                string))
         (when (find #\newline string) (flush stream)))
        (t
         (type-error stream 'output-stream)))
  string)

(defmacro with-output-to-string ((var &optional string &key (element-type ''character)) &body body)
  (multiple-value-bind (forms declarations) (compiler::parse-body body nil)
    (let ((target (cl:gensym)))
      `(let* ((,target ,string)
              (,var (make-string-output-stream :element-type
                     (if ,target (array-element-type ,target) ,element-type))))
         (declare ,@declarations)
         (when ,target
           (unless (and (stringp ,target) (array-has-fill-pointer-p ,target))
             (type-error ,target '(and string (satisfies array-has-fill-pointer-p))))
           (setf (string-output-stream-target ,var) ,target))
         (unwind-protect
              (if ,target (progn ,@forms)
                  (progn ,@forms (get-output-stream-string ,var)))
           (close ,var))))))

(defun write-char (char &optional (stream *standard-output*))
  (stream-write-char stream char))

(defun write-string (string &optional (stream *standard-output*) &key (start 0) end)
  (unless (stringp string) (type-error string 'string))
  (setq end (sequence-io-bounds string start end))
  (stream-write-string stream (if (and (= start 0) (= end (length string))) string (subseq string start end)))
  string)
(defun write-line (string &optional (stream *standard-output*) &key (start 0) end)
  (write-string string stream :start start :end end)
  (stream-write-char stream #\newline)
  string)

(defun finish-output (&optional (stream *standard-output*))
  (flush stream)
  nil)

(defun force-output (&optional (stream *standard-output*))
  (flush stream)
  nil)

(defun terpri (&optional (stream *standard-output*))
  (write-char #\newline stream)
  nil)

(defun fresh-line (&optional (stream *standard-output*))
  (when (< 0 (stream-column stream))
    (terpri stream) t))

(defstruct (string-input-stream (:copier nil)
                                (:constructor %make-string-input-stream))
  string
  position
  end)

(defun make-string-input-stream (string &optional (start 0) end)
  (unless (stringp string) (type-error string 'string))
  (setq end (sequence-io-bounds string start end))
  (%make-string-input-stream :string string :position start :end end))

(defun string-input-stream-eof-p (stream)
  (>= (string-input-stream-position stream)
      (string-input-stream-end stream)))

(defstruct file-input-stream
  string-stream
  (line 1)
  (column 0))

(defstruct (standard-input-stream (:copier nil))
  (string "")
  (position 0))

(defun empty-buffer-p (stream)
  (<= (length (standard-input-stream-string stream))
      (standard-input-stream-position stream)))

(defun fetch-stdin-line (stream)
  (setf (standard-input-stream-string stream)
        (*:string-append (funcall *:*get-stdin-line-function*) (string #\newline))
        (standard-input-stream-position stream)
        0))

(defun fetch-stdin-line-if-required (stream)
  (do ()
      ((not (empty-buffer-p stream)))
    (fetch-stdin-line stream)))

(defvar *standard-input* (make-standard-input-stream))

(defun %base-stream-read-line (stream)
  (cond ((two-way-stream-p stream)
         (stream-read-line (two-way-stream-input-stream stream)))
        ((string-input-stream-p stream)
         (if (string-input-stream-eof-p stream)
             (values "" nil)
             (let ((start (string-input-stream-position stream)))
               (do ((i (string-input-stream-position stream) (1+ i)))
                   ((>= i (string-input-stream-end stream))
                    (setf (string-input-stream-position stream) i)
                    (values (subseq (string-input-stream-string stream) start) nil))
                 (when (char= #\newline
                              (aref (string-input-stream-string stream)
                                    i))
                   (setf (string-input-stream-position stream) (1+ i))
                   (return (values (subseq (string-input-stream-string stream)
                                           start i)
                                   t)))))))
        ((standard-input-stream-p stream)
         (fetch-stdin-line-if-required stream)
         (prog1 (values (if (= 0 (standard-input-stream-position stream))
                            (subseq (standard-input-stream-string stream)
                                    0
                                    (1- (length (standard-input-stream-string stream))))
                            (subseq (standard-input-stream-string stream)
                                    (standard-input-stream-position stream)
                                    (1- (length (standard-input-stream-string stream)))))
                        t)
           (setf (standard-input-stream-position stream)
                 (length (standard-input-stream-string stream)))))
        ((file-input-stream-p stream)
         (multiple-value-bind (string missing-newline-p)
             (stream-read-line (file-input-stream-string-stream stream))
           (cond (missing-newline-p
                  (incf (file-input-stream-line stream))
                  (setf (file-input-stream-column stream) 0))
                 (t
                  (setf (file-input-stream-column stream) (length string))))
           (values string missing-newline-p)))
        (t
         (type-error stream 'input-stream))))

(defun %base-stream-read-char (stream)
  (cond ((two-way-stream-p stream)
         (stream-read-char (two-way-stream-input-stream stream)))
        ((string-input-stream-p stream)
         (if (string-input-stream-eof-p stream)
             :eof
             (prog1 (aref (string-input-stream-string stream)
                          (string-input-stream-position stream))
               (incf (string-input-stream-position stream)))))
        ((standard-input-stream-p stream)
         (fetch-stdin-line-if-required stream)
         (prog1 (aref (standard-input-stream-string stream)
                      (standard-input-stream-position stream))
           (incf (standard-input-stream-position stream))))
        ((file-input-stream-p stream)
         (let ((char (stream-read-char (file-input-stream-string-stream stream))))
           (cond ((eq char :eof))
                 ((char= char #\newline)
                  (incf (file-input-stream-line stream))
                  (setf (file-input-stream-column stream) 0))
                 (t
                  (incf (file-input-stream-column stream))))
           char))
        (t
         (type-error stream 'input-stream))))

(defun %base-stream-unread-char (stream)
  (cond ((two-way-stream-p stream)
         (stream-unread-char (two-way-stream-input-stream stream)))
        ((string-input-stream-p stream)
         (decf (string-input-stream-position stream))
         nil)
        ((standard-input-stream-p stream)
         (decf (standard-input-stream-position stream))
         nil)
        ((file-input-stream-p stream)
         (stream-unread-char (file-input-stream-string-stream stream)))
        (t
         (type-error stream 'input-stream))))

(defun %base-stream-peek-char (stream)
  (cond ((two-way-stream-p stream)
         (stream-peek-char (two-way-stream-input-stream stream)))
        ((string-input-stream-p stream)
         (if (string-input-stream-eof-p stream)
             :eof
             (aref (string-input-stream-string stream)
                   (string-input-stream-position stream))))
        ((standard-input-stream-p stream)
         (fetch-stdin-line-if-required stream)
         (aref (standard-input-stream-string stream)
               (standard-input-stream-position stream)))
        ((file-input-stream-p stream)
         (stream-peek-char (file-input-stream-string-stream stream)))
        (t
         (type-error stream 'input-stream))))

(defmacro with-input-from-string ((var string &key index (start 0) end) &body body)
  (multiple-value-bind (forms declarations) (compiler::parse-body body nil)
    `(let ((,var (make-string-input-stream ,string ,start ,end)))
       (declare ,@declarations)
       (unwind-protect
            (multiple-value-prog1 (progn ,@forms)
              ,@(when index `((setf ,index (file-position ,var)))))
         (close ,var)))))

(defmacro with-open-stream ((var stream) &body body)
  (multiple-value-bind (forms declarations) (compiler::parse-body body nil)
    (let ((abort (cl:gensym)))
      `(let ((,var ,stream) (,abort t))
         (declare ,@declarations)
         (unwind-protect
              (multiple-value-prog1 (progn ,@forms) (setq ,abort nil))
           (when ,var (close ,var :abort ,abort)))))))

(defun %base-close (stream)
  (declare (ignore stream))
  t)

(defun %base-streamp (x)
  (or (two-way-stream-p x) (string-output-stream-p x)
      (standard-output-stream-p x)
      (string-input-stream-p x)
      (file-input-stream-p x)
      (standard-input-stream-p x)))

(defun %base-file-position (stream)
  (cond ((string-input-stream-p stream)
         (string-input-stream-position stream))
        ((file-input-stream-p stream)
         (string-input-stream-position (file-input-stream-string-stream stream)))
        ((standard-input-stream-p stream)
         (standard-input-stream-position stream))
        ((string-output-stream-p stream)
         nil)
        ((standard-output-stream-p stream)
         nil)
        (t
         (type-error stream 'stream))))


(defun %base-input-stream-p (stream)
  (unless (streamp stream) (type-error stream 'stream))
  (or (two-way-stream-p stream) (string-input-stream-p stream)
      (file-input-stream-p stream) (standard-input-stream-p stream)))

(defun %base-output-stream-p (stream)
  (unless (streamp stream) (type-error stream 'stream))
  (or (two-way-stream-p stream) (string-output-stream-p stream)
      (standard-output-stream-p stream)))

(defun make-two-way-stream (input-stream output-stream)
  (unless (input-stream-p input-stream) (type-error input-stream 'input-stream))
  (unless (output-stream-p output-stream) (type-error output-stream 'output-stream))
  (%make-two-way-stream :input-stream input-stream :output-stream output-stream))

;; Composite streams share the same element operations and lifetime checks.
(defstruct (file-stream (:constructor %make-file-stream)) handle pathname element-type direction)
(defstruct (synonym-stream (:constructor %make-synonym-stream)) symbol)
(defstruct (broadcast-stream (:constructor %make-broadcast-stream)) streams)
(defstruct (concatenated-stream (:constructor %make-concatenated-stream)) streams)
(defstruct (echo-stream (:constructor %make-echo-stream)) input-stream output-stream unread-p)

(defun stream-kind (x)
  (and (*:structure-p x) (*:%structure-name x)))
(defun streamp (x)
  (case (stream-kind x)
    ((two-way-stream string-output-stream standard-output-stream string-input-stream
      file-input-stream standard-input-stream file-stream synonym-stream broadcast-stream
      concatenated-stream echo-stream) t)
    (otherwise nil)))
(defun synonym-stream-target (stream)
  (let ((target (symbol-value (synonym-stream-symbol stream))))
    (unless (streamp target) (type-error target 'stream)) target))
(defun input-stream-p (stream)
  (case (stream-kind stream)
    (synonym-stream (input-stream-p (synonym-stream-target stream)))
    (file-stream (not (null (member (file-stream-direction stream) '(:input :io)))))
    ((two-way-stream string-input-stream file-input-stream standard-input-stream concatenated-stream echo-stream) t)
    (otherwise (unless (streamp stream) (type-error stream 'stream)) nil)))
(defun output-stream-p (stream)
  (case (stream-kind stream)
    (synonym-stream (output-stream-p (synonym-stream-target stream)))
    (file-stream (not (null (member (file-stream-direction stream) '(:output :io)))))
    ((two-way-stream string-output-stream standard-output-stream broadcast-stream echo-stream) t)
    (otherwise (unless (streamp stream) (type-error stream 'stream)) nil)))
(defun open-stream-p (stream)
  (unless (streamp stream) (type-error stream 'stream))
  (and (not (*:stream-closed-p stream))
       (or (not (synonym-stream-p stream)) (open-stream-p (synonym-stream-target stream)))))
(defun check-stream (stream &optional direction)
  (unless (streamp stream) (type-error stream 'stream))
  (when (and (eq direction :input) (not (input-stream-p stream)))
    (type-error stream '(satisfies input-stream-p)))
  (when (and (eq direction :output) (not (output-stream-p stream)))
    (type-error stream '(satisfies output-stream-p)))
  (when (*:stream-closed-p stream) (error 'stream-error :stream stream))
  stream)
(defun input-stream-designator (stream)
  (check-stream (cond ((null stream) *standard-input*) ((eq stream t) *terminal-io*) (t stream)) :input))
(defun output-stream-designator (stream)
  (check-stream (cond ((null stream) *standard-output*) ((eq stream t) *terminal-io*) (t stream)) :output))
(defun make-synonym-stream (symbol)
  (unless (symbolp symbol) (type-error symbol 'symbol))
  (%make-synonym-stream :symbol symbol))
(defun make-broadcast-stream (&rest streams)
  (dolist (s streams) (check-stream s :output))
  (%make-broadcast-stream :streams streams))
(defun make-concatenated-stream (&rest streams)
  (dolist (s streams) (check-stream s :input))
  (%make-concatenated-stream :streams streams))
(defun make-echo-stream (input output)
  (check-stream input :input) (check-stream output :output)
  (%make-echo-stream :input-stream input :output-stream output))
(defun stream-element-type (stream)
  (unless (streamp stream) (type-error stream 'stream))
  (cond ((file-stream-p stream) (file-stream-element-type stream))
        ((string-output-stream-p stream) (string-output-stream-element-type stream))
        ((synonym-stream-p stream) (stream-element-type (synonym-stream-target stream)))
        ((two-way-stream-p stream) (stream-element-type (two-way-stream-input-stream stream)))
        ((echo-stream-p stream) (stream-element-type (echo-stream-input-stream stream)))
        ((broadcast-stream-p stream)
         (let ((streams (broadcast-stream-streams stream)))
           (if streams (stream-element-type (car (last streams))) t)))
        ((concatenated-stream-p stream)
         (let ((streams (concatenated-stream-streams stream)))
           (if streams (stream-element-type (car streams)) nil)))
        (t 'character)))
(defun interactive-stream-p (stream)
  (unless (streamp stream) (type-error stream 'stream))
  (cond ((synonym-stream-p stream) (interactive-stream-p (synonym-stream-target stream)))
        ((two-way-stream-p stream) (interactive-stream-p (two-way-stream-input-stream stream)))
        (t (or (standard-input-stream-p stream) (standard-output-stream-p stream)))))
(defun close (stream &key abort)
  (unless (streamp stream) (type-error stream 'stream))
  (unless (*:stream-closed-p stream)
    (when (file-stream-p stream) (*:file-op :close (file-stream-handle stream) abort))
    (when (standard-output-stream-p stream) (flush stream))
    (*:mark-stream-closed stream))
  t)

(defun stream-read-element (stream character-p &optional peek)
  (check-stream stream :input)
  (cond ((synonym-stream-p stream) (stream-read-element (synonym-stream-target stream) character-p peek))
        ((two-way-stream-p stream) (stream-read-element (two-way-stream-input-stream stream) character-p peek))
        ((echo-stream-p stream)
         (let ((value (stream-read-element (echo-stream-input-stream stream) character-p peek)))
           (unless (or peek (eq value :eof))
             (if (echo-stream-unread-p stream) (setf (echo-stream-unread-p stream) nil)
                 (if character-p (stream-write-char (echo-stream-output-stream stream) value)
                     (write-byte value (echo-stream-output-stream stream)))))
           value))
        ((concatenated-stream-p stream)
         (do () ((null (concatenated-stream-streams stream)) :eof)
           (let ((value (stream-read-element (car (concatenated-stream-streams stream)) character-p peek)))
             (unless (eq value :eof) (return value))
             (pop (concatenated-stream-streams stream)))))
        ((file-stream-p stream)
         (unless (if character-p (subtypep (stream-element-type stream) 'character)
                     (subtypep (stream-element-type stream) 'integer))
           (error 'stream-error :stream stream))
         (or (*:file-op (if peek :peek :read) (file-stream-handle stream)) :eof))
        (character-p (if peek (%base-stream-peek-char stream) (%base-stream-read-char stream)))
        (t (error 'stream-error :stream stream))))
(defun stream-read-char (stream) (stream-read-element stream t))
(defun stream-peek-char (stream) (stream-read-element stream t t))
(defun stream-unread-char (stream &optional character)
  (declare (ignore character))
  (check-stream stream :input)
  (cond ((synonym-stream-p stream) (stream-unread-char (synonym-stream-target stream)))
        ((two-way-stream-p stream) (stream-unread-char (two-way-stream-input-stream stream)))
        ((echo-stream-p stream)
         (stream-unread-char (echo-stream-input-stream stream))
         (setf (echo-stream-unread-p stream) t))
        ((concatenated-stream-p stream) (stream-unread-char (car (concatenated-stream-streams stream))))
        ((file-stream-p stream) (*:file-op :unread (file-stream-handle stream)))
        (t (%base-stream-unread-char stream)))
  nil)
(defun stream-write-char (stream char)
  (setq stream (output-stream-designator stream))
  (unless (characterp char) (type-error char 'character))
  (when (and *pretty-output-hook* (funcall *pretty-output-hook* stream char))
    (return-from stream-write-char char))
  (cond ((synonym-stream-p stream) (stream-write-char (synonym-stream-target stream) char))
        ((two-way-stream-p stream) (stream-write-char (two-way-stream-output-stream stream) char))
        ((echo-stream-p stream) (stream-write-char (echo-stream-output-stream stream) char))
        ((broadcast-stream-p stream) (dolist (s (broadcast-stream-streams stream)) (stream-write-char s char)))
        ((file-stream-p stream)
         (unless (subtypep (stream-element-type stream) 'character) (error 'stream-error :stream stream))
         (*:file-op :write (file-stream-handle stream) char))
        ((string-output-stream-p stream)
         (unless (typep char (string-output-stream-element-type stream))
           (type-error char (string-output-stream-element-type stream)))
         (if (string-output-stream-target stream)
             (vector-push-extend char (string-output-stream-target stream))
             (%base-stream-write-char stream char)))
        (t (%base-stream-write-char stream char)))
  char)
(defun stream-write-string (stream string)
  (setq stream (output-stream-designator stream))
  (unless (stringp string) (type-error string 'string))
  (when (and *pretty-output-hook* (funcall *pretty-output-hook* stream string))
    (return-from stream-write-string string))
  (cond ((synonym-stream-p stream) (stream-write-string (synonym-stream-target stream) string))
        ((two-way-stream-p stream) (stream-write-string (two-way-stream-output-stream stream) string))
        ((echo-stream-p stream) (stream-write-string (echo-stream-output-stream stream) string))
        ((broadcast-stream-p stream) (dolist (s (broadcast-stream-streams stream)) (stream-write-string s string)))
        ((file-stream-p stream)
         (unless (subtypep (stream-element-type stream) 'character) (error 'stream-error :stream stream))
         (*:file-op :write (file-stream-handle stream) (*:array-to-raw-string string)))
        ((and (string-output-stream-p stream)
              (or (string-output-stream-target stream) (null (string-output-stream-element-type stream))))
         (dotimes (i (length string)) (stream-write-char stream (char string i))))
        (t (%base-stream-write-string stream string)))
  string)
(defun flush (stream)
  (setq stream (output-stream-designator stream))
  (cond ((synonym-stream-p stream) (flush (synonym-stream-target stream)))
        ((two-way-stream-p stream) (flush (two-way-stream-output-stream stream)))
        ((echo-stream-p stream) (flush (echo-stream-output-stream stream)))
        ((broadcast-stream-p stream) (dolist (s (broadcast-stream-streams stream)) (flush s)))
        ((file-stream-p stream) (*:file-op :flush (file-stream-handle stream)))
        (t (%base-flush stream)))
  nil)
(defun stream-column (stream)
  (setq stream (output-stream-designator stream))
  (cond ((synonym-stream-p stream) (stream-column (synonym-stream-target stream)))
        ((two-way-stream-p stream) (stream-column (two-way-stream-output-stream stream)))
        ((echo-stream-p stream) (stream-column (echo-stream-output-stream stream)))
        ((broadcast-stream-p stream) (if (broadcast-stream-streams stream) (stream-column (car (broadcast-stream-streams stream))) 0))
        ((file-stream-p stream)
         (compute-text-column (subseq (ffi:js->cl (ffi:ref (file-stream-handle stream) "content"))
                                     0 (file-position stream))))
        (t (%base-stream-column stream))))
(defun read-byte (stream &optional (eof-error-p t) eof-value)
  (let ((value (stream-read-element stream nil)))
    (if (eq value :eof) (if eof-error-p (error 'end-of-file :stream stream) eof-value) value)))
(defun write-byte (integer stream)
  (check-stream stream :output)
  (unless (integerp integer) (type-error integer 'integer))
  (cond ((synonym-stream-p stream) (write-byte integer (synonym-stream-target stream)))
        ((two-way-stream-p stream) (write-byte integer (two-way-stream-output-stream stream)))
        ((echo-stream-p stream) (write-byte integer (echo-stream-output-stream stream)))
        ((broadcast-stream-p stream) (dolist (s (broadcast-stream-streams stream)) (write-byte integer s)))
        ((file-stream-p stream)
         (unless (and (subtypep (stream-element-type stream) 'integer)
                      (typep integer (stream-element-type stream)))
           (type-error integer (stream-element-type stream)))
         (*:file-op :write (file-stream-handle stream) integer))
        (t (error 'stream-error :stream stream)))
  integer)
(defun file-position (stream &optional (position nil supplied-p))
  (check-stream stream)
  (when (and supplied-p (not (or (member position '(:start :end)) (and (integerp position) (>= position 0)))))
    (type-error position '(or (member :start :end) (integer 0 *))))
  (cond ((synonym-stream-p stream) (if supplied-p (file-position (synonym-stream-target stream) position) (file-position (synonym-stream-target stream))))
        ((broadcast-stream-p stream)
         (let ((streams (broadcast-stream-streams stream)))
           (if streams
               (if supplied-p (file-position (car (last streams)) position)
                   (file-position (car (last streams))))
               0)))
        ((file-stream-p stream) (*:file-op :position (file-stream-handle stream) (if supplied-p position nil)))
        ((and supplied-p (string-input-stream-p stream))
         (setf (string-input-stream-position stream) (case position (:start 0) (:end (string-input-stream-end stream)) (otherwise position)))
         t)
        (supplied-p nil)
        ((or (string-input-stream-p stream) (file-input-stream-p stream)) (%base-file-position stream))
        (t nil)))
(defun file-length (stream)
  (check-stream stream)
  (cond ((synonym-stream-p stream) (file-length (synonym-stream-target stream)))
        ((file-stream-p stream) (*:file-op :length (file-stream-handle stream)))
        ((broadcast-stream-p stream) (if (broadcast-stream-streams stream) (file-length (car (last (broadcast-stream-streams stream)))) 0))
        (t (type-error stream 'file-stream))))
(defun file-string-length (stream object)
  (check-stream stream :output)
  (let ((string (if (characterp object) (string object) object)))
    (unless (stringp string) (type-error object '(or string character)))
    (cond ((synonym-stream-p stream) (file-string-length (synonym-stream-target stream) object))
          ((broadcast-stream-p stream)
           (let ((streams (broadcast-stream-streams stream)))
             (if streams (file-string-length (car (last streams)) object) 1)))
          ((file-stream-p stream) (*:file-op :string-length (file-stream-handle stream) (*:array-to-raw-string string)))
          (t (length string)))))
(defun listen (&optional (stream *standard-input*))
  (setq stream (input-stream-designator stream))
  (cond ((standard-input-stream-p stream) (not (empty-buffer-p stream)))
        ((synonym-stream-p stream) (listen (synonym-stream-target stream)))
        ((two-way-stream-p stream) (listen (two-way-stream-input-stream stream)))
        ((echo-stream-p stream) (listen (echo-stream-input-stream stream)))
        (t (not (eq (stream-read-element stream (subtypep (stream-element-type stream) 'character) t) :eof)))))
(defun read-char-no-hang (&optional (stream *standard-input*) (eof-error-p t) eof-value recursive-p)
  (setq stream (input-stream-designator stream))
  (if (and (interactive-stream-p stream) (not (listen stream))) nil
      (read-char stream eof-error-p eof-value recursive-p)))
(defun clear-input (&optional (stream *standard-input*))
  (setq stream (input-stream-designator stream))
  (cond ((synonym-stream-p stream) (clear-input (synonym-stream-target stream)))
        ((two-way-stream-p stream) (clear-input (two-way-stream-input-stream stream)))
        ((echo-stream-p stream) (clear-input (echo-stream-input-stream stream)))
        ((standard-input-stream-p stream) (setf (standard-input-stream-position stream) (length (standard-input-stream-string stream)))))
  nil)
(defun clear-output (&optional (stream *standard-output*))
  (setq stream (output-stream-designator stream))
  (cond ((synonym-stream-p stream) (clear-output (synonym-stream-target stream)))
        ((two-way-stream-p stream) (clear-output (two-way-stream-output-stream stream)))
        ((echo-stream-p stream) (clear-output (echo-stream-output-stream stream)))
        ((broadcast-stream-p stream) (dolist (s (broadcast-stream-streams stream)) (clear-output s)))
        ((standard-output-stream-p stream) (setf (standard-output-stream-buffer stream) "")))
  nil)
(defun sequence-io-bounds (sequence start end)
  (let ((length (length sequence)))
    (unless (and (integerp start) (<= 0 start length)) (type-error start '(integer 0 *)))
    (unless (or (null end) (and (integerp end) (<= start end length))) (type-error end '(or null (integer 0 *))))
    (or end length)))
(defun read-sequence (sequence stream &key (start 0) end)
  (setq end (sequence-io-bounds sequence start end)) (check-stream stream :input)
  (let ((character-p (subtypep (stream-element-type stream) 'character))
        (tail (and (listp sequence) (nthcdr start sequence))))
    (do ((i start (1+ i))) ((= i end) i)
      (let ((value (stream-read-element stream character-p)))
        (when (eq value :eof) (return i))
        (if (listp sequence) (progn (rplaca tail value) (setq tail (cdr tail)))
            (setf (elt sequence i) value))))))
(defun write-sequence (sequence stream &key (start 0) end)
  (setq end (sequence-io-bounds sequence start end)) (check-stream stream :output)
  (let ((character-p (subtypep (stream-element-type stream) 'character)))
    (map-sequence (lambda (value) (if character-p (stream-write-char stream value) (write-byte value stream)))
                  sequence nil start end nil))
  sequence)

(defvar *terminal-io* (make-two-way-stream *standard-input* *standard-output*))
(defvar *debug-io* *terminal-io*)
(defvar *query-io* *terminal-io*)
(defvar *trace-output* *standard-output*)


(defun stream-read-line (stream)
  (check-stream stream :input)
  (let ((out (make-string-output-stream)))
    (do ((char (stream-read-char stream) (stream-read-char stream))) (nil)
      (cond ((eq char :eof) (return (values (get-output-stream-string out) nil)))
            ((char= char #\newline) (return (values (get-output-stream-string out) t)))
            (t (stream-write-char out char))))))

(defun stream-external-format (stream)
  (unless (streamp stream) (type-error stream 'stream))
  (cond ((synonym-stream-p stream) (stream-external-format (synonym-stream-target stream)))
        ((broadcast-stream-p stream)
         (let ((streams (broadcast-stream-streams stream)))
           (if streams (stream-external-format (car (last streams))) :default)))
        (t :utf-8)))
