#+valtan
(in-package :common-lisp)
#-valtan
(in-package :valtan-core)

(defun %logical-component (value)
  (cond ((stringp value) (string-upcase value))
        ((consp value) (mapcar #'%logical-component value))
        (t value)))

(defun %parse-logical-namestring (text host start end junk-allowed)
  (labels ((bad ()
             (if junk-allowed (return-from %parse-logical-namestring (values nil start))
                 (error 'type-error :datum text :expected-type 'logical-pathname)))
           (component (text)
             (cond ((zerop (length text)) nil) ((string= text "*") :wild)
                   (t (string-upcase text)))))
    (loop for i from start below end
          unless (or (alphanumericp (char text i)) (find (char text i) "-;.*")) do (bad))
    (let* ((relative (and (< start end) (char= (char text start) #\;)))
           (from (if relative (1+ start) start)) (directories nil) (parts nil))
      (loop for i from from below end
            when (char= (char text i) #\;)
              do (when (= from i) (bad))
                 (push (if (string= text "**" :start1 from :end1 i)
                           :wild-inferiors (component (subseq text from i))) directories)
                 (setq from (1+ i)))
      (let ((file-start from))
        (loop for i from from below end
              when (char= (char text i) #\.)
                do (push (subseq text from i) parts) (setq from (1+ i)))
        (when (< file-start end) (push (subseq text from end) parts)))
      (setq parts (nreverse parts))
      (when (> (length parts) 3) (bad))
      (let ((version (third parts)))
        (when version
          (setq version (cond ((string-equal version "newest") :newest)
                              ((string= version "*") :wild)
                              ((and (plusp (length version)) (every #'digit-char-p version))
                               (let ((n (parse-integer version))) (if (plusp n) n (bad))))
                              (t (bad)))))
        (values (%make-logical-pathname :host (string-upcase host) :device :unspecific
                                       :directory (cons (if relative :relative :absolute)
                                                        (nreverse directories))
                                       :name (and parts (component (first parts)))
                                       :type (and (cdr parts) (component (second parts)))
                                       :version version)
                end)))))

(defun logical-pathname (pathspec)
  (let ((path (pathname pathspec)))
    (if (logical-pathname-p path) path
        (type-error pathspec 'logical-pathname))))

(defun logical-pathname-translations (host)
  (unless (stringp host) (type-error host 'string))
  (multiple-value-bind (rules present) (gethash (string-upcase host) *logical-pathname-translations*)
    (unless present (error "Undefined logical pathname host ~A" host))
    rules))

(defun (cl:setf logical-pathname-translations) (rules host)
  (unless (stringp host) (type-error host 'string))
  (let* ((name (string-upcase host))
         (old (gethash name *logical-pathname-translations*))
         (present (%logical-host-p name)) (success nil))
    ;; Register the host before parsing its rules, including rules that refer
    ;; back to the host. Restore the previous definition if parsing fails.
    (setf (gethash name *logical-pathname-translations*) old)
    (unwind-protect
         (progn
           (setf (gethash name *logical-pathname-translations*)
                 (mapcar (lambda (rule)
                           (let ((from (parse-namestring (first rule) name))
                                 (to (pathname (second rule))))
                             (unless (and (logical-pathname-p from)
                                          (string-equal (pathname-host from) name))
                               (error "Translation rule belongs to a different logical host"))
                             (list from to))) rules))
           (setq success t)
           rules)
      (unless success
        (if present (setf (gethash name *logical-pathname-translations*) old)
            (remhash name *logical-pathname-translations*))))))

(defun load-logical-pathname-translations (host)
  (unless (stringp host) (type-error host 'string))
  (unless (%logical-host-p host) (error "No translation file is configured for logical host ~A" host))
  nil)

(defun %pathname-string-match (text pattern insensitive)
  ;; Return the captures as a second value so TRANSLATE-PATHNAME uses exactly
  ;; the same wildcard matching rules as PATHNAME-MATCH-P.
  (labels ((match (i j captures)
             (cond ((= j (length pattern))
                    (if (= i (length text)) (values t (nreverse captures)) (values nil nil)))
                   ((char= (char pattern j) #\*)
                    (loop for end from i to (length text)
                          do (multiple-value-bind (ok found)
                                 (match end (1+ j) (cons (subseq text i end) captures))
                               (when ok (return-from match (values t found))))))
                   ((and (< i (length text))
                         (or (char= (char pattern j) #\?)
                             (funcall (if insensitive #'char-equal #'char=)
                                      (char text i) (char pattern j))))
                    (match (1+ i) (1+ j)
                           (if (char= (char pattern j) #\?)
                               (cons (subseq text i (1+ i)) captures) captures)))
                   (t (values nil nil)))))
    (match 0 0 nil)))

(defun %pathname-component-match (source pattern insensitive)
  (cond ((or (null pattern) (eq pattern :wild)) (values t (list source)))
        ((and (stringp source) (stringp pattern)) (%pathname-string-match source pattern insensitive))
        (t (values (equal source pattern) nil))))

(defun %pathname-directory-match (source pattern insensitive)
  (labels ((match (source pattern captures)
             (cond ((null pattern) (values (null source) (nreverse captures)))
                   ((eq (car pattern) :wild-inferiors)
                    (loop for tail on source for n from 0
                          do (multiple-value-bind (ok found)
                                 (match tail (cdr pattern) (cons (subseq source 0 n) captures))
                               (when ok (return-from match (values t found)))))
                    (match nil (cdr pattern) (cons source captures)))
                   ((null source) (values nil nil))
                   (t (multiple-value-bind (ok found)
                          (%pathname-component-match (car source) (car pattern) insensitive)
                        (when ok (match (cdr source) (cdr pattern)
                                        (if (eq (car pattern) :wild)
                                            (cons (list (car source)) captures)
                                            (append (reverse (mapcar #'list found)) captures)))))))))
    (if (or (null pattern) (eq pattern :wild)) (values t (list (cdr source)))
        (match source pattern nil))))

(defun pathname-match-p (pathspec wildcard)
  (let* ((source (pathname pathspec)) (pattern (pathname wildcard))
         (insensitive (logical-pathname-p source)))
    (and (eq (logical-pathname-p source) (logical-pathname-p pattern))
         (%pathname-component-match (pathname-host source) (pathname-host pattern) insensitive)
         (%pathname-component-match (pathname-device source) (pathname-device pattern) insensitive)
         (%pathname-directory-match (pathname-directory source) (pathname-directory pattern) insensitive)
         (%pathname-component-match (pathname-name source) (pathname-name pattern) insensitive)
         (%pathname-component-match (pathname-type source) (pathname-type pattern) insensitive)
         (%pathname-component-match (pathname-version source) (pathname-version pattern) insensitive)
         t)))

(defun translate-pathname (source from-wildcard to-wildcard &key)
  (let* ((source (pathname source)) (from (pathname from-wildcard)) (to (pathname to-wildcard))
         (insensitive (logical-pathname-p source))
         (change-case (not (eq insensitive (logical-pathname-p to)))))
    (unless (pathname-match-p source from) (error 'file-error :pathname source))
    (labels ((convert (value) (if change-case (%pathname-case value :common) value))
             (translate (value pattern target)
               (multiple-value-bind (ok captures) (%pathname-component-match value pattern insensitive)
                 (declare (ignore ok))
                 (cond ((or (null target) (eq target :wild)) (convert value))
                       ((and (stringp target) (or (find #\* target) (find #\? target)))
                        (with-output-to-string (out)
                          (loop for char across target
                                do (if (find char "*?")
                                       (let ((part (pop captures)))
                                         (unless (stringp part) (error 'file-error :pathname source))
                                         (write-string (convert part) out))
                                       (write-char char out)))))
                       (t target)))))
      (multiple-value-bind (ok captures)
          (%pathname-directory-match (pathname-directory source) (pathname-directory from) insensitive)
        (declare (ignore ok))
        (let ((directory (pathname-directory to)))
          (setq directory
                (if (null directory) (convert (pathname-directory source))
                    (mapcan (lambda (part)
                              (if (member part '(:wild :wild-inferiors))
                                  (copy-list (convert (pop captures))) (list part))) directory)))
          (make-pathname :host (pathname-host to) :device (pathname-device to)
                         :directory directory
                         :name (translate (pathname-name source) (pathname-name from) (pathname-name to))
                         :type (translate (pathname-type source) (pathname-type from) (pathname-type to))
                         :version (translate (pathname-version source) (pathname-version from)
                                             (pathname-version to))))))))

(defun translate-logical-pathname (pathspec &key)
  (let ((path (pathname pathspec)) (seen nil))
    (loop while (logical-pathname-p path)
          do (when (member path seen :test #'equal) (error 'file-error :pathname path))
             (push path seen)
             (let ((rule (find-if (lambda (rule) (pathname-match-p path (first rule)))
                                  (logical-pathname-translations (pathname-host path)))))
               (unless rule (error 'file-error :pathname path))
               (setq path (translate-pathname path (first rule) (second rule)))))
    path))
