(in-package :uiop/os)
(defun getenv (name)
  (let ((value (system:environment-op :getenv (ffi:cl->js name))))
    (unless (null value) (ffi:js->cl value))))
(define-setf-expander getenv (name &environment environment)
  (declare (ignore environment))
  (let ((var (gensym)) (value (gensym)))
    (values (list var) (list name) (list value)
            `(progn (system:environment-op :setenv (ffi:cl->js ,var)
                                            (if ,value (ffi:cl->js ,value) nil))
                    ,value)
            `(getenv ,var))))
(defun getcwd () (pathname (ffi:js->cl (system:file-op :cwd))))
(defun chdir (path)
  (system:environment-op :chdir (ffi:cl->js (namestring path)))
  (getcwd))
(defun hostname () (machine-instance))
(defun implementation-type () :valtan)
(setf *implementation-type* :valtan)
