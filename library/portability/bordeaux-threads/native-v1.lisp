(in-package :bordeaux-threads)

(defstruct (lock (:constructor %make-lock (native))) native)
(defstruct (recursive-lock (:constructor %make-recursive-lock (native))) native)
(defstruct (condition-variable (:constructor %make-condition-variable (native))) native)
(defstruct (thread (:constructor %make-thread-wrapper (native))) native)

(defun %timeout-milliseconds (timeout)
  (check-type timeout (or null (real 0)))
  (when timeout ((ffi:ref "Number") ((ffi:ref "lisp" "numberValue") (* timeout 1000)))))

(defun make-lock (&optional name)
  (%make-lock (system::%make-cooperative-lock name nil)))
(defun acquire-lock (lock &optional (wait-p t))
  (check-type lock lock)
  (system::%acquire-cooperative-lock (lock-native lock) wait-p nil))
(defun release-lock (lock)
  (check-type lock lock)
  (system::%release-cooperative-lock (lock-native lock))
  lock)
(defmacro with-lock-held ((place &key timeout) &body body)
  (with-gensyms (lock)
    `(let ((,lock ,place))
       (check-type ,lock lock)
       (when (system::%acquire-cooperative-lock
              (lock-native ,lock) t (%timeout-milliseconds ,timeout))
         (unwind-protect (locally ,@body) (release-lock ,lock))))))

(defun make-recursive-lock (&optional name)
  (%make-recursive-lock (system::%make-cooperative-lock name t)))
(defun acquire-recursive-lock (lock)
  (check-type lock recursive-lock)
  (system::%acquire-cooperative-lock (recursive-lock-native lock) t nil))
(defun release-recursive-lock (lock)
  (check-type lock recursive-lock)
  (system::%release-cooperative-lock (recursive-lock-native lock))
  lock)
(defmacro with-recursive-lock-held ((place &key timeout) &body body)
  (with-gensyms (lock)
    `(let ((,lock ,place))
       (check-type ,lock recursive-lock)
       (when (system::%acquire-cooperative-lock
              (recursive-lock-native ,lock) t (%timeout-milliseconds ,timeout))
         (unwind-protect (locally ,@body) (release-recursive-lock ,lock))))))

(defun make-condition-variable (&key name)
  (%make-condition-variable (system::%make-cooperative-condition name)))
(defun condition-wait (condition-variable lock &key timeout)
  (check-type condition-variable condition-variable)
  (system::%cooperative-condition-wait
   (condition-variable-native condition-variable)
   (etypecase lock
     (lock (lock-native lock))
     (recursive-lock (recursive-lock-native lock)))
   (%timeout-milliseconds timeout)))
(defun condition-notify (condition-variable)
  (check-type condition-variable condition-variable)
  (system::%cooperative-condition-notify (condition-variable-native condition-variable) nil)
  (values))

(defvar *thread-wrappers* (trivial-garbage:make-weak-hash-table :weakness :key :test 'eq))
(defvar *thread-wrappers-lock* (make-lock "thread wrappers"))
(defun %ensure-thread-wrapper (native)
  (with-lock-held (*thread-wrappers-lock*)
    (or (gethash native *thread-wrappers*)
        (setf (gethash native *thread-wrappers*) (%make-thread-wrapper native)))))
(defun %make-thread (function name)
  (check-type function (and (not null) (or symbol function)))
  (check-type name string)
  (%ensure-thread-wrapper
   (system::%cooperative-thread-op :make function (ffi:cl->js name))))
(defun current-thread ()
  (%ensure-thread-wrapper (system::%cooperative-thread-op :current)))
(defun threadp (object) (typep object 'thread))
(defun thread-name (thread)
  (check-type thread thread)
  (ffi:js->cl (system::%cooperative-thread-op :name (thread-native thread))))
(defun thread-alive-p (thread)
  (check-type thread thread)
  (system::%cooperative-thread-op :alive (thread-native thread)))
(defun all-threads ()
  (mapcar #'%ensure-thread-wrapper
          (system:raw-array-to-list (system::%cooperative-thread-op :all))))
(defun join-thread (thread)
  (check-type thread thread)
  (when (eq thread (current-thread))
    (error 'bordeaux-mp-condition :message "Cannot join the current thread"))
  (let ((native (thread-native thread)))
    (system::%cooperative-thread-op :join native)
    (when (system::%cooperative-thread-op :failed native)
      (error 'bordeaux-mp-condition
             :message (format nil "Thread failed: ~A"
                              (ffi:js->cl ((ffi:ref "String")
                                           (system::%cooperative-thread-op :error native))))))
    (values-list (system:raw-array-to-list (system::%cooperative-thread-op :result native)))))
(defun interrupt-thread (thread function &rest arguments)
  (check-type thread thread)
  (check-type function (and (not null) (or symbol function)))
  (unless (system::%cooperative-thread-op :interrupt (thread-native thread)
                                        (lambda () (apply function arguments)))
    (error 'bordeaux-mp-condition :message "Cannot interrupt a terminated thread"))
  thread)
(defun destroy-thread (thread)
  (check-type thread thread)
  (signal-error-if-current-thread thread)
  (system::%cooperative-thread-op :destroy (thread-native thread))
  thread)
(defun thread-yield () (system::%resumable-yield nil) (values))
(mark-supported)
