(in-package :bordeaux-threads-2)

(deftype native-thread () '(satisfies %native-thread-p))
(defun %native-thread-p (object) (system::%cooperative-thread-op :p object))
(defun %make-thread (function name)
  (system::%cooperative-thread-op :make function (ffi:cl->js name)))
(defun %current-thread () (system::%cooperative-thread-op :current))
(defun %thread-name (thread)
  (ffi:js->cl (system::%cooperative-thread-op :name thread)))
(defun %all-threads () (system:raw-array-to-list (system::%cooperative-thread-op :all)))
(defun %thread-alive-p (thread) (system::%cooperative-thread-op :alive thread))
(defun %thread-yield () (system::%resumable-yield nil))
(defun %destroy-thread (thread) (system::%cooperative-thread-op :destroy thread))
(defun %interrupt-thread (thread function)
  (unless (system::%cooperative-thread-op :interrupt thread function)
    (bt-error "Cannot interrupt a terminated thread")))
(defun %join-thread (native)
  (system::%cooperative-thread-op :join native)
  (when (system::%cooperative-thread-op :failed native)
    (let ((thread (%get-thread-wrapper native)))
      (with-slots (%lock %exit-condition) thread
        ;; API-LOCKS is loaded after this backend, so use functions here rather
        ;; than its not-yet-defined WITH-LOCK-HELD macro.
        (let ((lock (lock-native-lock %lock)))
          (when (%acquire-lock lock t nil)
            (unwind-protect
                 (unless %exit-condition
                   (setf %exit-condition
                         (make-condition 'simple-error :format-control "~A"
                                         :format-arguments
                                         (list (ffi:js->cl
                                                ((ffi:ref "String")
                                                 (system::%cooperative-thread-op :error native)))))))
              (%release-lock lock))))))))

(deftype native-lock () '(satisfies %native-lock-p))
(deftype native-recursive-lock () '(satisfies %native-recursive-lock-p))
(defun %native-lock-p (object)
  (and (ffi:instanceof object (ffi:ref "lisp" "CooperativeLock"))
       (eq (ffi:ref object "recursive") (ffi:ref "false"))))
(defun %native-recursive-lock-p (object)
  (and (ffi:instanceof object (ffi:ref "lisp" "CooperativeLock"))
       (eq (ffi:ref object "recursive") (ffi:ref "true"))))
(defun %make-lock (name) (system::%make-cooperative-lock name nil))
(defun %make-recursive-lock (name) (system::%make-cooperative-lock name t))
(defun %timeout-milliseconds (timeout)
  (check-type timeout (or null (real 0)))
  (when timeout ((ffi:ref "Number") ((ffi:ref "lisp" "numberValue") (* timeout 1000)))))
(defun %acquire-lock (lock wait timeout)
  (check-type lock native-lock)
  (system::%acquire-cooperative-lock lock wait (%timeout-milliseconds timeout)))
(defun %release-lock (lock)
  (check-type lock native-lock)
  (system::%release-cooperative-lock lock))
(defun %acquire-recursive-lock (lock wait timeout)
  (check-type lock native-recursive-lock)
  (system::%acquire-cooperative-lock lock wait (%timeout-milliseconds timeout)))
(defun %release-recursive-lock (lock)
  (check-type lock native-recursive-lock)
  (system::%release-cooperative-lock lock))

(deftype condition-variable () '(satisfies %condition-variable-p))
(defun %condition-variable-p (object)
  (ffi:instanceof object (ffi:ref "lisp" "CooperativeConditionVariable")))
(defun %make-condition-variable (name) (system::%make-cooperative-condition name))
(defun %condition-wait (condition lock timeout)
  (check-type condition condition-variable)
  (check-type lock native-lock)
  (system::%cooperative-condition-wait condition lock (%timeout-milliseconds timeout)))
(defun %condition-notify (condition)
  (check-type condition condition-variable)
  (system::%cooperative-condition-notify condition nil))
(defun %condition-broadcast (condition)
  (check-type condition condition-variable)
  (system::%cooperative-condition-notify condition t))
