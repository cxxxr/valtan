(in-package #:mcclim-browser)

(defclass browser-medium (basic-medium) ())
(defclass browser-pixmap ()
  ((surface :initarg :surface :reader pixmap-surface)
   (width :initarg :width :reader pixmap-width)
   (height :initarg :height :reader pixmap-height)))
(defmethod pixmap-depth ((pixmap browser-pixmap)) 32)
(defmethod allocate-pixmap ((medium browser-medium) width height)
  (let ((width (max 1 (ceiling width))) (height (max 1 (ceiling height))))
    (make-instance 'browser-pixmap :width width :height height
                   :surface (host-call "createSurface" width height))))
(defmethod deallocate-pixmap ((pixmap browser-pixmap))
  (when (pixmap-surface pixmap)
    (host-call "releaseSurface" (pixmap-surface pixmap))
    (setf (slot-value pixmap 'surface) nil)))
(defun canvas-surface (drawable)
  (typecase drawable
    (browser-medium (canvas-surface (medium-drawable drawable)))
    (browser-pixmap (pixmap-surface drawable))
    (t drawable)))
(defun canvas-call (drawable operation &rest arguments)
  (host-call "canvasCall" (canvas-surface drawable) (ffi:cl->js operation)
             (apply #'ffi:array (mapcar #'ffi:cl->js arguments))))
(defun canvas-set (drawable property value)
  (host-call "canvasSet" (canvas-surface drawable) (ffi:cl->js property) (ffi:cl->js value)))

(defun css-font (style medium)
  (multiple-value-bind (family face size)
      (text-style-components (merge-text-styles style (medium-merged-text-style medium)))
    (let ((faces (if (listp face) face (list face))))
      (format nil "~A~A~Dpx ~A"
              (if (member :italic faces) "italic " "")
              (if (member :bold faces) "bold " "")
              (if (numberp size) size
                  (case size (:tiny 8) (:very-small 10) (:small 12) (:large 18)
                    (:very-large 24) (:huge 32) (otherwise 14)))
              (case family (:fix "monospace") (:serif "serif") (otherwise "sans-serif"))))))
(defun measure-text (medium style text)
  (host-call "measureText" (ffi:cl->js (css-font style medium)) (ffi:cl->js text)))
(defmethod text-style-ascent (style (medium browser-medium))
  (property (measure-text medium style "M") "ascent"))
(defmethod text-style-descent (style (medium browser-medium))
  (property (measure-text medium style "M") "descent"))
(defmethod text-style-height (style (medium browser-medium))
  (+ (text-style-ascent style medium) (text-style-descent style medium)))
(defmethod text-style-character-width (style (medium browser-medium) character)
  (property (measure-text medium style (string character)) "width"))
(defmethod text-style-width (style (medium browser-medium))
  (text-style-character-width style medium #\m))
(defmethod text-size ((medium browser-medium) string &key text-style (start 0) end)
  (let* ((metrics (measure-text medium text-style (subseq (string string) start end)))
         (width (property metrics "width")) (ascent (property metrics "ascent"))
         (descent (property metrics "descent")))
    (values width (+ ascent descent) width 0 ascent)))
(defmethod text-bounding-rectangle* ((medium browser-medium) string &key text-style (start 0) end)
  (let ((metrics (measure-text medium text-style (subseq (string string) start end))))
    (values (- (property metrics "left")) (- (property metrics "actualAscent"))
            (property metrics "right") (property metrics "actualDescent")
            (property metrics "width") 0)))

(defun canvas-pattern (medium ink &optional (outer-transformation +identity-transformation+))
  (let* ((source (climi::transformed-design-design ink))
         (transformation (compose-transformations outer-transformation
                          (climi::transformed-design-transformation ink)))
         (width (ceiling (pattern-width source)))
         (height (ceiling (pattern-height source)))
         (array (climi::pattern-array (climi::%collapse-pattern source 0 0 width height)))
         (pixels (make-array (* width height) :element-type '(unsigned-byte 32))))
    ;; Respect displaced image arrays as well as the ordinary packed case.
    (dotimes (i (length pixels)) (setf (aref pixels i) (row-major-aref array i)))
    (multiple-value-bind (xx xy yx yy tx ty) (climi::get-transformation transformation)
      (host-call "pattern" (canvas-surface medium) (ffi:cl->js pixels) width height
                 (if (typep source 'clime:rectangular-tile) (ffi:ref "true") (ffi:ref "false"))
                 (ffi:array xx yx xy yy tx ty)))))

(defun canvas-color (medium ink)
  (cond ((eq ink +foreground-ink+) (canvas-color medium (medium-foreground medium)))
        ((eq ink +background-ink+) (canvas-color medium (medium-background medium)))
        ((climi::indirect-ink-p ink) (canvas-color medium (climi::indirect-ink-ink ink)))
        ((typep ink 'clime:pattern) (canvas-pattern medium ink))
        (t (multiple-value-bind (r g b alpha) (climi::color-rgba ink)
             (format nil "rgba(~D,~D,~D,~F)" (round (* r 255)) (round (* g 255))
                     (round (* b 255)) alpha)))))
(defun canvas-transform (medium transformation)
  (multiple-value-bind (xx xy yx yy tx ty) (climi::get-transformation transformation)
    (canvas-call medium "setTransform" xx yx xy yy tx ty)))
(defun canvas-clip-path (medium region)
  ;; Rectangle sets produced during text redisplay may include zero-area bands.
  ;; Their normalized components are +NOWHERE+, which contributes no contour.
  (when (eq region +nowhere+) (return-from canvas-clip-path nil))
  (typecase region
    (rectangle
     (multiple-value-bind (left top right bottom) (bounding-rectangle* region)
       (canvas-call medium "rect" left top (- right left) (- bottom top))))
    (polygon
     (let ((first t) (points nil) (area 0))
       (map-over-polygon-coordinates
        (lambda (x y) (push (cons x y) points)) region)
       (setq points (nreverse points))
       (loop for rest on points for a = (car rest) for b = (or (cadr rest) (car points))
             do (incf area (- (* (car a) (cdr b)) (* (car b) (cdr a)))))
       ;; Union paths must have the same winding, regardless of the input
       ;; polygon's vertex order, or overlapping regions could cancel out.
       (when (< area 0) (setq points (reverse points)))
       (dolist (point points)
         (canvas-call medium (if first "moveTo" "lineTo") (car point) (cdr point))
         (setf first nil))
       (canvas-call medium "closePath")))
    (ellipse
     (multiple-value-bind (cx cy) (ellipse-center-point* region)
       (multiple-value-bind (rx1 ry1 rx2 ry2) (ellipse-radii region)
         (let* ((start (or (ellipse-start-angle region) 0))
                (end (or (ellipse-end-angle region) (* 2 pi)))
                (reverse (< (- (* rx1 ry2) (* rx2 ry1)) 0)))
           (canvas-call medium "save")
           (canvas-call medium "transform" rx1 ry1 rx2 ry2 cx cy)
           (canvas-call medium "moveTo" (cos (if reverse end start)) (sin (if reverse end start)))
           (canvas-call medium "arc" 0 0 1 (if reverse end start) (if reverse start end)
                        (if reverse (ffi:ref "true") (ffi:ref "false")))
           (when (< (abs (- end start)) (* 2 pi)) (canvas-call medium "lineTo" 0 0))
           (canvas-call medium "closePath")
           (canvas-call medium "restore")))))
    ((or climi::standard-region-union climi::standard-rectangle-set)
     (map-over-region-set-regions (lambda (part) (canvas-clip-path medium part)) region :normalize :y-banding))
    ((or point line polyline elliptical-arc) nil)
    (t (error "Canvas clipping region is not yet supported: ~S" (type-of region)))))
(defun canvas-clip (medium region)
  (cond ((eq region +everywhere+) nil)
        ((typep region 'climi::standard-region-intersection)
         ;; Sequential Canvas clips intersect. Concatenating their paths would
         ;; instead take a union and let drawing escape the requested region.
         (map-over-region-set-regions (lambda (part) (canvas-clip medium part)) region))
        ((typep region 'climi::standard-region-complement)
         (let ((inside (climi::region-complement region)))
           (if (typep inside 'climi::standard-region-union)
               (map-over-region-set-regions
                (lambda (part) (canvas-clip medium (climi::region-complement part))) inside)
               (progn
                 (canvas-call medium "beginPath")
                 (let ((surface (canvas-surface medium)))
                   (canvas-call medium "rect" 0 0
                                (property (property surface "canvas") "width")
                                (property (property surface "canvas") "height")))
                 (canvas-clip-path medium inside)
                 (canvas-call medium "clip" "evenodd")))))
        (t
         (canvas-call medium "beginPath")
         (unless (eq region +nowhere+) (canvas-clip-path medium region))
         (canvas-call medium "clip"))))
(defun canvas-path-region-p (region)
  (or (eq region +nowhere+)
      (typecase region
        ((or rectangle polygon ellipse point line polyline elliptical-arc) t)
        ((or climi::standard-region-union climi::standard-rectangle-set)
         (every #'canvas-path-region-p (region-set-regions region)))
        (t nil))))

(defun canvas-direct-clip-p (region)
  (or (eq region +everywhere+) (eq region +nowhere+)
      (canvas-path-region-p region)
      (and (typep region 'climi::standard-region-intersection)
           (every #'canvas-direct-clip-p (region-set-regions region)))))

(defgeneric canvas-region-mask (region width height))

(defmethod canvas-region-mask (region width height)
  ;; Canvas paths can express a union of primitive contours, but cannot express
  ;; arbitrary unions of intersections and complements. Compose coverage masks
  ;; for those trees, in device coordinates, before compositing the drawing once.
  (let ((mask (host-call "createSurface" width height)))
    (canvas-set mask "fillStyle" "white")
    (cond ((canvas-direct-clip-p region)
           (canvas-clip mask region)
           (canvas-call mask "fillRect" 0 0 width height))
          ((typep region 'climi::standard-region-complement)
           (canvas-call mask "fillRect" 0 0 width height)
           (canvas-set mask "globalCompositeOperation" "destination-out")
           (canvas-call mask "drawImage"
                        (property (canvas-region-mask (climi::region-complement region) width height) "canvas")
                        0 0))
          ((typep region 'climi::standard-region-intersection)
           (canvas-call mask "fillRect" 0 0 width height)
           (canvas-set mask "globalCompositeOperation" "destination-in")
           (map-over-region-set-regions
            (lambda (part)
              (canvas-call mask "drawImage" (property (canvas-region-mask part width height) "canvas") 0 0))
            region))
          ((typep region 'climi::standard-region-union)
           (map-over-region-set-regions
            (lambda (part)
              (canvas-call mask "drawImage" (property (canvas-region-mask part width height) "canvas") 0 0))
            region))
          (t (error "Canvas region mask is not supported: ~S" (type-of region))))
    mask))

(defun canvas-composite-ink-p (ink)
  (cond ((climi::indirect-ink-p ink)
         (canvas-composite-ink-p (climi::indirect-ink-ink ink)))
        ((typep ink '(or color opacity climi::uniform-compositum)) nil)
        (t (typep ink '(or climi::masked-compositum climi::over-compositum
                          climi::transformed-design clime:pattern region)))))

(defun canvas-flipping-design (medium ink)
  (cond ((eq ink +foreground-ink+) (canvas-flipping-design medium (medium-foreground medium)))
        ((eq ink +background-ink+) (canvas-flipping-design medium (medium-background medium)))
        ((climi::indirect-ink-p ink) (canvas-flipping-design medium (climi::indirect-ink-ink ink)))
        ((typep ink 'climi::standard-flipping-ink) ink)))

(defun canvas-design-flipping-p (medium design &optional stencil-p)
  (flet ((contains-flipping (ink) (canvas-design-flipping-p medium ink stencil-p)))
    (cond ((eq design +foreground-ink+)
           (and (not stencil-p) (contains-flipping (medium-foreground medium))))
          ((eq design +background-ink+)
           (and (not stencil-p) (contains-flipping (medium-background medium))))
          ((climi::indirect-ink-p design) (contains-flipping (climi::indirect-ink-ink design)))
          ((typep design 'climi::standard-flipping-ink) t)
          ((typep design '(or color opacity climi::uniform-compositum)) nil)
          ((typep design 'climi::indexed-pattern)
           (some #'contains-flipping (climi::pattern-designs design)))
          ((typep design 'clime:rectangular-tile)
           (contains-flipping (climi::rectangular-tile-design design)))
          ((typep design 'climi::transformed-design)
           (contains-flipping (climi::transformed-design-design design)))
          ((typep design 'climi::masked-compositum)
           (or (contains-flipping (climi::compositum-ink design))
               (canvas-design-flipping-p medium (climi::compositum-mask design) t)))
          ((typep design 'climi::over-compositum)
           (or (contains-flipping (climi::compositum-foreground design))
               (contains-flipping (climi::compositum-background design))))
          ((typep design 'region)
           (and (not stencil-p) (contains-flipping (medium-foreground medium)))))))

(defun canvas-design-inverse-matrix (transformation)
  (multiple-value-bind (xx xy yx yy tx ty) (climi::get-transformation (invert-transformation transformation))
    (ffi:array xx yx xy yy tx ty)))

(defun canvas-stencil-surface (medium design width height transformation)
  (if (canvas-design-flipping-p medium design t)
      (host-call "designStencil" (canvas-design-operation medium design width height transformation t)
                 width height)
      (canvas-design-surface medium design width height transformation t)))

(defun canvas-design-operation (medium design width height transformation &optional stencil-p)
  (let ((climi::*foreground-ink* (if stencil-p +black+ (medium-foreground medium)))
        (climi::*background-ink* (if stencil-p +black+ (medium-background medium))))
    (labels ((operation (ink &optional (w width) (h height) (tr transformation))
               (canvas-design-operation medium ink w h tr stencil-p))
             (surface (ink)
               (canvas-design-surface medium ink width height transformation stencil-p)))
      (cond ((eq design +foreground-ink+) (operation climi::*foreground-ink*))
            ((eq design +background-ink+) (operation climi::*background-ink*))
            ((climi::indirect-ink-p design) (operation (climi::indirect-ink-ink design)))
            ((not (canvas-design-flipping-p medium design stencil-p))
             (ffi:object :operation (ffi:cl->js "paint") :surface (surface design)))
            ((typep design 'climi::standard-flipping-ink)
             (ffi:object :operation (ffi:cl->js "flip")
                         :first (surface (climi::flipping-ink-design1 design))
                         :second (surface (climi::flipping-ink-design2 design))))
            ((typep design 'climi::transformed-design)
             (operation (climi::transformed-design-design design) width height
                        (compose-transformations transformation (climi::transformed-design-transformation design))))
            ((typep design 'climi::indexed-pattern)
             (let* ((array (climi::pattern-array design))
                    (w (pattern-width design)) (h (pattern-height design))
                    (indices (make-array (* w h))))
               (dotimes (i (length indices)) (setf (aref indices i) (row-major-aref array i)))
               (ffi:object :operation (ffi:cl->js "indexed") :width w :height h
                           :matrix (canvas-design-inverse-matrix transformation)
                           :indices (ffi:cl->js indices)
                           :palette (apply #'ffi:array
                                           (map 'list (lambda (ink) (operation ink w h +identity-transformation+))
                                                (climi::pattern-designs design))))))
            ((typep design 'clime:rectangular-tile)
             (let ((w (ceiling (pattern-width design))) (h (ceiling (pattern-height design))))
               (ffi:object :operation (ffi:cl->js "tile") :width w :height h
                           :matrix (canvas-design-inverse-matrix transformation)
                           :ink (operation (climi::rectangular-tile-design design) w h +identity-transformation+))))
            ((typep design 'climi::masked-compositum)
             (ffi:object :operation (ffi:cl->js "mask")
                         :ink (operation (climi::compositum-ink design))
                         :mask (canvas-stencil-surface medium (climi::compositum-mask design) width height transformation)
                         :outside (if (typep design 'climi::out-compositum) (ffi:ref "true") (ffi:ref "false"))))
            ((typep design 'climi::over-compositum)
             (ffi:object :operation (ffi:cl->js "over")
                         :foreground (operation (climi::compositum-foreground design))
                         :background (operation (climi::compositum-background design))))
            ((typep design 'region)
             (ffi:object :operation (ffi:cl->js "mask")
                         :ink (operation climi::*foreground-ink*)
                         :mask (canvas-region-mask (transform-region transformation design) width height)
                         :outside (ffi:ref "false")))
            (t (error "Canvas design operation is not supported: ~S" (type-of design)))))))

(defun canvas-design-surface (medium design width height transformation &optional stencil-p)
  ;; Composite the design independently of the shape being drawn. In particular,
  ;; OUT removes pixels from this temporary design, never from existing drawing.
  ;; All layers use device coordinates so nested transforms and text positioning
  ;; do not move the design relative to its mask.
  ;; Stencil opacity is defined with opaque black foreground and background,
  ;; regardless of the medium's designs. Propagate that environment through
  ;; nested composites, regions, transformations and pattern palette entries.
  (let ((climi::*foreground-ink* (if stencil-p +black+ (medium-foreground medium)))
        (climi::*background-ink* (if stencil-p +black+ (medium-background medium))))
   (labels ((render (ink &optional (tr transformation))
             (canvas-design-surface medium ink width height tr stencil-p))
           (combine (destination source operation)
             (canvas-set destination "globalCompositeOperation" operation)
             (canvas-call destination "drawImage" (property source "canvas") 0 0)
             (canvas-set destination "globalCompositeOperation" "source-over")
             destination)
           (fill (style)
             (let ((surface (host-call "createSurface" width height)))
               (canvas-set surface "fillStyle" style)
               (canvas-call surface "fillRect" 0 0 width height)
               surface)))
    (cond ((eq design +foreground-ink+) (render climi::*foreground-ink*))
          ((eq design +background-ink+) (render climi::*background-ink*))
          ((climi::indirect-ink-p design) (render (climi::indirect-ink-ink design)))
          ((typep design '(or color opacity climi::uniform-compositum))
           (fill (canvas-color medium design)))
          ((typep design 'clime:pattern)
           (fill (canvas-pattern medium design transformation)))
          ((typep design 'climi::transformed-design)
           (render (climi::transformed-design-design design)
                   (compose-transformations transformation
                    (climi::transformed-design-transformation design))))
          ((typep design 'climi::masked-compositum)
           (combine (render (climi::compositum-ink design))
                    (canvas-stencil-surface medium (climi::compositum-mask design)
                                            width height transformation)
                    (if (typep design 'climi::in-compositum)
                        "destination-in" "destination-out")))
          ((typep design 'climi::over-compositum)
           (combine (render (climi::compositum-background design))
                    (render (climi::compositum-foreground design)) "source-over"))
          ((typep design 'region)
           (combine (render climi::*foreground-ink*)
                    (canvas-region-mask (transform-region transformation design) width height)
                    "destination-in"))
          (t (error "Canvas design is not yet supported: ~S" (type-of design)))))))

(defun call-with-canvas-state (medium function clip &optional (ink (medium-ink medium)))
  (when (medium-drawable medium)
    (canvas-call medium "save")
    (unwind-protect
         (progn
           (canvas-transform medium +identity-transformation+)
           (canvas-clip medium clip)
           (canvas-transform medium (medium-device-transformation medium))
           (let ((style (medium-line-style medium)))
             (let ((color (canvas-color medium ink)))
               (canvas-set medium "fillStyle" color) (canvas-set medium "strokeStyle" color))
             (canvas-set medium "lineWidth" (climi::line-style-effective-thickness style medium))
             (canvas-set medium "lineCap" (case (line-style-cap-shape style) (:round "round") (:square "square") (otherwise "butt")))
             (canvas-set medium "lineJoin" (case (line-style-joint-shape style) (:round "round") (:bevel "bevel") (otherwise "miter")))
             (canvas-call medium "setLineDash" (apply #'ffi:array (coerce (climi::line-style-effective-dashes style medium) 'list))))
           (funcall function))
      (canvas-call medium "restore"))))

(defun call-with-canvas (medium function)
  (when (medium-drawable medium)
    (let ((clip (medium-device-region medium))
          (flipping (canvas-flipping-design medium (medium-ink medium)))
          (flipping-composite (canvas-design-flipping-p medium (medium-ink medium)))
          (composite (canvas-composite-ink-p (medium-ink medium))))
      (if (and (not flipping-composite) (not composite) (canvas-direct-clip-p clip))
          (call-with-canvas-state medium function clip)
          (let* ((drawable (medium-drawable medium))
                 (destination (canvas-surface medium))
                 (canvas (property destination "canvas"))
                 (width (property canvas "width")) (height (property canvas "height"))
                 (mask (canvas-region-mask clip width height))
                 (layer (host-call "createSurface" width height)))
            (unwind-protect
                 (progn (setf (medium-drawable medium) layer)
                        (call-with-canvas-state medium function +everywhere+
                                                (if (or flipping-composite composite) +white+ (medium-ink medium))))
              (setf (medium-drawable medium) drawable))
            (when (and composite (not flipping-composite))
              ;; CLIM inks are anchored to the drawing plane, independently of
              ;; the drawing-option and sheet transformations. Only an explicit
              ;; TRANSFORM-REGION of the design moves its colors and masks.
              (let ((design (canvas-design-surface medium (medium-ink medium) width height
                                                 +identity-transformation+)))
                (canvas-set design "globalCompositeOperation" "destination-in")
                (canvas-call design "drawImage" (property layer "canvas") 0 0)
                (setf layer design)))
            (canvas-set layer "globalCompositeOperation" "destination-in")
            (canvas-call layer "drawImage" (property mask "canvas") 0 0)
            (cond (flipping
                (host-call "flipArea" destination layer
                           (canvas-design-surface medium (climi::flipping-ink-design1 flipping)
                                                  width height +identity-transformation+)
                           (canvas-design-surface medium (climi::flipping-ink-design2 flipping)
                                                  width height +identity-transformation+)))
                (flipping-composite
                 (host-call "paintDesign" destination layer
                            (canvas-design-operation medium (medium-ink medium) width height +identity-transformation+)))
                (t
                  (canvas-call destination "save")
                  (unwind-protect
                       (progn
                         (canvas-call destination "resetTransform")
                         (canvas-set destination "globalCompositeOperation" "source-over")
                         (canvas-call destination "drawImage" (property layer "canvas") 0 0))
                    (canvas-call destination "restore")))))))))
(defmacro with-canvas ((medium) &body body)
  `(call-with-canvas ,medium (lambda () ,@body)))
(defmethod medium-draw-point* ((medium browser-medium) x y)
  (with-canvas (medium)
    (let ((radius (/ (climi::line-style-effective-thickness (medium-line-style medium) medium) 2)))
      (canvas-call medium "beginPath")
      (canvas-call medium "arc" x y radius 0 (* 2 pi))
      (canvas-call medium "fill"))))
(defmethod medium-draw-line* ((medium browser-medium) x1 y1 x2 y2)
  (with-canvas (medium)
    (canvas-call medium "beginPath") (canvas-call medium "moveTo" x1 y1)
    (canvas-call medium "lineTo" x2 y2) (canvas-call medium "stroke")))
(defmethod medium-draw-polygon* ((medium browser-medium) coords closed filled)
  (with-canvas (medium)
    (canvas-call medium "beginPath")
    (loop for i from 0 below (length coords) by 2
          do (canvas-call medium (if (zerop i) "moveTo" "lineTo") (elt coords i) (elt coords (1+ i))))
    (when closed (canvas-call medium "closePath"))
    (canvas-call medium (if filled "fill" "stroke"))))
(defmethod medium-draw-rectangle* ((medium browser-medium) left top right bottom filled)
  (with-canvas (medium)
    (canvas-call medium (if filled "fillRect" "strokeRect") left top (- right left) (- bottom top))))
(defmethod medium-draw-ellipse* ((medium browser-medium) cx cy rx1 ry1 rx2 ry2 start end filled)
  (with-canvas (medium)
    ;; Canvas's unit circle transformed by the CLIM ellipse's two radius vectors.
    (canvas-call medium "beginPath")
    (canvas-call medium "save")
    (canvas-call medium "transform" rx1 ry1 rx2 ry2 cx cy)
    (canvas-call medium "arc" 0 0 1 (or start 0) (or end (* 2 pi)))
    (when (and filled start end (< (abs (- end start)) (* 2 pi)))
      (canvas-call medium "lineTo" 0 0) (canvas-call medium "closePath"))
    (canvas-call medium "restore")
    (canvas-call medium (if filled "fill" "stroke"))))
(defmethod medium-draw-text* ((medium browser-medium) string x y start end align-x align-y toward-x toward-y transform-glyphs)
  (with-canvas (medium)
    (let* ((text (subseq (string string) start end))
           (metrics (measure-text medium nil text))
           (width (property metrics "width"))
           (ascent (property metrics "ascent")) (descent (property metrics "descent")))
      (unless transform-glyphs
        (multiple-value-setq (x y) (transform-position (medium-device-transformation medium) x y))
        (multiple-value-setq (toward-x toward-y) (transform-position (medium-device-transformation medium) toward-x toward-y))
        (canvas-transform medium +identity-transformation+))
      (canvas-call medium "translate" x y)
      (canvas-call medium "rotate" (atan (- toward-y y) (- toward-x x)))
      (canvas-set medium "font" (css-font nil medium))
      (canvas-set medium "textBaseline" "alphabetic")
      (canvas-call medium "fillText" text
                   (case align-x (:right (- width)) (:center (/ width -2)) (otherwise 0))
                   (case align-y (:top ascent) (:bottom (- descent))
                     (:center (/ (- ascent descent) 2)) (otherwise 0))))))
(defmethod medium-force-output ((medium browser-medium)) (port-force-output (port medium)))
(defmethod medium-finish-output ((medium browser-medium)) (port-force-output (port medium)))

(defmethod medium-copy-area :around ((source browser-medium) sx sy width height
                                    (destination browser-medium) dx dy)
  ;; Compute both positions before rebinding either transformation. Otherwise
  ;; the upstream nested bindings miss the destination transform when copying
  ;; within one medium. Extents describe pixels and are not scaled.
  (let ((source-transformation (medium-transformation source))
        (destination-transformation (medium-transformation destination)))
    (multiple-value-bind (sx sy) (transform-position source-transformation sx sy)
      (multiple-value-bind (dx dy) (transform-position destination-transformation dx dy)
        (unwind-protect
             (progn
               (setf (medium-transformation source) +identity-transformation+
                     (medium-transformation destination) +identity-transformation+)
               (call-next-method source sx sy width height destination dx dy))
          (setf (medium-transformation source) source-transformation
                (medium-transformation destination) destination-transformation))))))

(defun canvas-copy-area (source sx sy width height destination dx dy)
  (let ((input (canvas-surface source)) (output (canvas-surface destination)))
    (when (and input output)
      (when (typep source 'browser-medium)
        (multiple-value-setq (sx sy) (transform-position (medium-native-transformation source) sx sy)))
      (when (typep destination 'browser-medium)
        (multiple-value-setq (dx dy) (transform-position (medium-native-transformation destination) dx dy)))
      (let* ((clip (if (typep destination 'browser-medium) (medium-device-region destination) +everywhere+))
             (canvas (property output "canvas"))
             (mask (unless (eq clip +everywhere+)
                     (canvas-region-mask clip (property canvas "width") (property canvas "height")))))
        (host-call "copyArea" input (round sx) (round sy) (round width) (round height)
                   output (round dx) (round dy) (or mask (ffi:ref "null")))))))

(macrolet ((copy-method (from to)
             `(defmethod medium-copy-area ((source ,from) sx sy width height (destination ,to) dx dy)
                (canvas-copy-area source sx sy width height destination dx dy))))
  (copy-method browser-medium browser-medium)
  (copy-method browser-medium browser-pixmap)
  (copy-method browser-pixmap browser-medium)
  (copy-method browser-pixmap browser-pixmap))
