(in-package #:mcclim-browser)

(defclass browser-port (basic-port)
  ((mirrors :initform (make-hash-table) :reader port-mirrors)
   (modifiers :initform 0 :accessor port-modifier-state))
  (:default-initargs :pointer (make-instance 'browser-pointer)))
(defclass browser-pointer (standard-pointer)
  ((x :initform 0) (y :initform 0) (buttons :initform 0)))
;; The desktop has fixed device coordinates and its background belongs to the
;; DOM. Region changes still invalidate descendant geometry through BASIC-SHEET,
;; but must not request a Lisp repaint of the desktop itself.
(defclass browser-graft (sheet-identity-transformation-mixin
                        sheet-mute-repainting-mixin graft) ())
(defclass browser-frame-manager (standard-frame-manager) ())

(defmethod find-port-type ((type (eql :browser)))
  (values 'browser-port #'identity))
(defmethod initialize-instance :after ((port browser-port) &key)
  (push (make-instance 'browser-frame-manager :port port)
        (slot-value port 'climi::frame-managers))
  #+clim-mp (climi::restart-port port))

(defmethod adopt-frame :before ((manager browser-frame-manager) (frame climi::menu-frame))
  ;; MENU-CHOOSE leaves the position to its backend. Resolve each unspecified
  ;; coordinate before the standard manager sizes and moves the top-level sheet.
  (multiple-value-bind (x y) (pointer-position (port-pointer (port manager)))
    (unless (slot-value frame 'climi::left)
      (setf (slot-value frame 'climi::left) (+ x 10)))
    (unless (slot-value frame 'climi::top)
      (setf (slot-value frame 'climi::top) y))))

(defun graft-dimension (dimension units)
  (let ((pixels (property (ffi:ref "globalThis.valtanMcclim") dimension)))
    (ecase units (:device pixels) (:inches (/ pixels 96))
      (:millimeters (* pixels (/ 25.4 96))) (:screen-sized 1))))
(defmethod graft-width ((graft browser-graft) &key (units :device))
  (graft-dimension "width" units))
(defmethod graft-height ((graft browser-graft) &key (units :device))
  (graft-dimension "height" units))
(defmethod make-graft ((port browser-port) &key (orientation :default) (units :device))
  (make-instance 'browser-graft :port port :mirror t :orientation orientation :units units
                 :region (make-rectangle* 0 0 (graft-dimension "width" :device)
                                              (graft-dimension "height" :device))))
(defmethod make-medium ((port browser-port) sheet)
  (make-instance 'browser-medium :port port :sheet sheet))
(defmethod realize-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (let* ((parent (sheet-parent sheet))
         (parent-mirror (when parent (sheet-mirror parent)))
         (mirror (host-call "createWindow"
                          (ffi:cl->js (if (typep sheet 'top-level-sheet-mixin)
                                          (clime:sheet-pretty-name sheet) "McCLIM"))
                          (max 1 (bounding-rectangle-width sheet))
                          (max 1 (bounding-rectangle-height sheet))
                          (if (or (null parent-mirror) (eq parent-mirror t))
                              (ffi:ref "null") parent-mirror)
                          (if (and (typep sheet 'top-level-sheet-mixin)
                                   (not (typep sheet 'climi::unmanaged-sheet-mixin)))
                              (ffi:ref "true") (ffi:ref "false")))))
    (setf (gethash (property mirror "id") (port-mirrors port)) sheet)
    (unless (sheet-enabled-p sheet)
      (host-call "visible" mirror (ffi:ref "false")))
    mirror))
(defmethod destroy-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (let ((mirror (sheet-direct-mirror sheet)))
    (when mirror
      (remhash (property mirror "id") (port-mirrors port))
      (host-call "destroyWindow" mirror))))
(defmethod set-mirror-geometry ((port browser-port) sheet region)
  (multiple-value-bind (x y right bottom) (bounding-rectangle* region)
    (let ((width (max 1 (ceiling (- right x)))) (height (max 1 (ceiling (- bottom y)))))
      (host-call "resizeWindow" (sheet-direct-mirror sheet) width height)
      (host-call "moveWindow" (sheet-direct-mirror sheet) (round x) (round y))
      (values (round x) (round y) (+ (round x) width) (+ (round y) height)))))
(defmethod set-mirror-name ((port browser-port) (sheet mirrored-sheet-mixin) name)
  (when (sheet-direct-mirror sheet)
    (host-call "title" (sheet-direct-mirror sheet) (ffi:cl->js name))))
(defmethod raise-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (when (sheet-direct-mirror sheet) (host-call "raiseWindow" (sheet-direct-mirror sheet))))
(defmethod bury-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (when (sheet-direct-mirror sheet) (host-call "buryWindow" (sheet-direct-mirror sheet))))
(defmethod shrink-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (when (sheet-direct-mirror sheet)
    ;; Native window managers report iconification asynchronously. Our host
    ;; hides the mirror immediately; keep the sheet state in sync so that
    ;; ENABLE-FRAME can re-enable it when the restore button is pressed.
    (setf (sheet-enabled-p sheet) nil)
    (host-call "minimizeWindow" (sheet-direct-mirror sheet))))
(defmethod unshrink-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (enable-mirror port sheet)
  (raise-mirror port sheet))
(defmethod enable-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (host-call "visible" (sheet-direct-mirror sheet) (ffi:ref "true")))
(defmethod disable-mirror ((port browser-port) (sheet mirrored-sheet-mixin))
  (host-call "visible" (sheet-direct-mirror sheet) (ffi:ref "false")))
(defmethod port-force-output ((port browser-port)) (host-call "flush"))
(defmethod port-grab-pointer ((port browser-port) pointer sheet &key multiple-window)
  (declare (ignore pointer))
  (let ((mirror (sheet-mirror sheet)))
    (when (and mirror (not (eq mirror t)))
      (host-call "grabPointer" mirror
                 (if multiple-window (ffi:ref "true") (ffi:ref "false"))))))
(defmethod port-ungrab-pointer ((port browser-port) pointer sheet)
  (declare (ignore pointer sheet))
  (host-call "ungrabPointer"))
(defmethod set-sheet-pointer-cursor ((port browser-port) sheet cursor)
  (host-call "cursor" (sheet-mirror sheet)
             (ffi:cl->js (case cursor (:busy "wait") (:i-beam "text")
                          (:move "move") (:crosshair "crosshair")
                          (:hand "pointer") (otherwise "default")))))
(defmethod pointer-position ((pointer browser-pointer))
  (values (slot-value pointer 'x) (slot-value pointer 'y)))
(defmethod pointer-button-state ((pointer browser-pointer)) (slot-value pointer 'buttons))

(defun browser-modifiers (mask)
  (logior (if (logtest 1 mask) +shift-key+ 0)
          (if (logtest 2 mask) +control-key+ 0)
          (if (logtest 4 mask) +meta-key+ 0)
          (if (logtest 8 mask) +super-key+ 0)))
(defun browser-key (name)
  (if (= (length name) 1)
      (char name 0)
      (cdr (assoc name '(("Enter" . :return) ("Tab" . :tab) ("Backspace" . :backspace)
                        ("Delete" . :delete) ("Escape" . :escape) ("ArrowLeft" . :left)
                        ("ArrowRight" . :right) ("ArrowUp" . :up) ("ArrowDown" . :down)
                        ("Home" . :home) ("End" . :end) ("Insert" . :insert)
                        ("PageUp" . :page-up) ("PageDown" . :page-down)) :test #'string=))))
(defun browser-key-character (key)
  ;; CLIM character gestures (including Control/Meta bindings) compare the
  ;; character and modifiers separately. Named editing keys need characters
  ;; too: upstream only infers a character for RETURN, not BACKSPACE or DELETE.
  (if (characterp key) key
      (case key
        (:return #\Newline) (:tab #\Tab) (:backspace #\Backspace)
        (:delete #\Rubout))))
(defun browser-event (port raw)
  (let* ((kind (property raw "type"))
         (sheet (gethash (property raw "window") (port-mirrors port)))
         (pointer (port-pointer port)))
    (when (string= kind "viewport-resize")
      (let ((width (property raw "width")) (height (property raw "height")))
        (host-call "resizeViewport" width height)
        (setf (sheet-region (find-graft :port port)) (make-rectangle* 0 0 width height)))
      (return-from browser-event nil))
    (unless sheet (return-from browser-event nil))
    (when (string= kind "window-configuration")
      (let ((x (property raw "x")) (y (property raw "y"))
            (width (property raw "width")) (height (property raw "height")))
        (host-call "moveWindow" (sheet-direct-mirror sheet) x y)
        (host-call "resizeWindow" (sheet-direct-mirror sheet) width height)
        (return-from browser-event
          (make-instance 'window-configuration-event :sheet sheet
            :region (make-rectangle* x y (+ x width) (+ y height))))))
    (when (string= kind "window-restore")
      (return-from browser-event
        (make-instance 'climi::window-manager-deiconify-event :sheet sheet)))
    (let* ((modifiers (browser-modifiers (or (property raw "modifiers") 0)))
           (common (list :sheet sheet :modifier-state modifiers)))
      (setf (port-modifier-state port) modifiers)
      (cond ((member kind '("keydown" "keyup" "text-input") :test #'string=)
             (let ((key (browser-key (property raw (if (string= kind "text-input") "text" "key")))))
               (when key
                 (apply #'make-instance (if (string= kind "keyup") 'key-release-event 'key-press-event)
                        :key-name (if (characterp key) (climi::decompose-keyboard-event-character key) key)
                        :key-character (browser-key-character key)
                        common))))
            (t
             (let ((x (property raw "x")) (y (property raw "y")))
               (multiple-value-bind (sx sy)
                   (climi::screen-position-from-sheet-position sheet x y)
                 (setf (slot-value pointer 'x) sx (slot-value pointer 'y) sy))
               (let ((class (cdr (assoc kind '(("pointerdown" . pointer-button-press-event)
                                              ("pointerup" . pointer-button-release-event)
                                              ("pointermove" . pointer-motion-event)
                                              ("pointerenter" . pointer-enter-event)
                                              ("pointerleave" . pointer-exit-event)
                                              ("wheel" . pointer-scroll-event)) :test #'string=))))
                 (when class
                   (when (member kind '("pointerdown" "pointerup") :test #'string=)
                     (let ((buttons (property raw "buttons")))
                       (setf (slot-value pointer 'buttons)
                             (logior (if (logtest buttons 1) +pointer-left-button+ 0)
                                     (if (logtest buttons 2) +pointer-right-button+ 0)
                                     (if (logtest buttons 4) +pointer-middle-button+ 0)))))
                   (apply #'make-instance class :pointer pointer :x x :y y
                          (append
                           (cond ((string= kind "wheel")
                                  (list :button climi::+pointer-no-button+
                                        :delta-x (property raw "dx") :delta-y (property raw "dy")))
                                 ((member kind '("pointerdown" "pointerup") :test #'string=)
                                  (list :button (case (property raw "button")
                                                 (0 +pointer-left-button+) (1 +pointer-middle-button+)
                                                 (2 +pointer-right-button+) (otherwise climi::+pointer-no-button+)))))
                           common))))))))))
(defmethod process-next-event ((port browser-port) &key wait-function timeout)
  (let ((deadline (when timeout (+ (get-internal-real-time) (* timeout internal-time-units-per-second))))
        (scheduled-p (eq ((ffi:ref "lisp" "hasExecutionContext")) (ffi:ref "true"))))
    (loop
      (when (and wait-function (funcall wait-function)) (return (values nil :wait-function)))
      (port-force-output port)
      (let* ((remaining (when deadline (max 0 (* 1000 (/ (- deadline (get-internal-real-time)) internal-time-units-per-second)))))
             ;; Atomics.wait would stop every task in this JavaScript worker.
             ;; Scheduled calls poll without consuming future input, then park
             ;; on CL:SLEEP. Cancellation cannot leave a detached input reader.
             (raw (host-call "nextEvent"
                             (cond (scheduled-p 0)
                                   (wait-function (min 50 (or remaining 50)))
                                   (t (or remaining (ffi:ref "Infinity")))))))
        (unless (eq raw (ffi:ref "null"))
          (when (string= (property raw "type") "shutdown") (return (values nil :shutdown)))
          (let ((event (browser-event port raw)))
            (when event (distribute-event port event) (return (values t nil)))))
        (when (and deadline (>= (get-internal-real-time) deadline)) (return (values nil :timeout)))
        (when (and scheduled-p (eq raw (ffi:ref "null")))
          (sleep (if deadline
                     (min .01 (max 0 (/ (- deadline (get-internal-real-time))
                                        internal-time-units-per-second)))
                     .01)))))))
